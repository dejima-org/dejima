#!/bin/bash
# Read Gitea Actions runs and job logs from a shell - the CI-side counterpart
# to gitea-pr and gitea-issue, and deliberately their twin rather than their
# sibling: all three are copied into the sandbox image as single
# self-contained files, and gitea-pr also lives in a dotfiles checkout, so a
# shared library would be a third thing to keep in step across three places.
# The duplicated config/token/curl preamble is pinned in all three by
# test/static.bats instead.
#
# Its reason to exist is a sandboxed agent's: CI is where the tests that
# cannot run in the sandbox actually run, and without this the only way to
# see why one failed is for the operator to paste the log in by hand.
set -euo pipefail

GITEA_TOKEN_FILE="${GITEA_TOKEN_FILE:-$HOME/.config/gitea/token}"

function usage() {
    echo "Usage: gitea-actions runs [--limit N]"
    echo "       gitea-actions jobs [RUN]"
    echo "       gitea-actions logs [RUN] [--job NAME|INDEX] [--all] [--timestamps]"
    echo ""
    echo "RUN is the number in a run's web URL (.../actions/runs/52). Left out,"
    echo "it means the newest run for HEAD's commit - after a push, that is"
    echo "almost always the one being asked about."
    echo ""
    echo "'logs' prints the failed jobs of a run; --all prints every job, and"
    echo "--job picks one by name (a substring is enough) or by index."
    echo "Timestamps are stripped unless --timestamps is given."
    echo ""
    echo "Requires GITEA_SSH_HOST and GITEA_API set in the environment (e.g. in" \
         "your shell profile), and a token at $GITEA_TOKEN_FILE (or GITEA_TOKEN" \
         "set for this invocation only)."
}

function require_config() {
    if [ -z "${GITEA_SSH_HOST:-}" ]; then
        echo "GITEA_SSH_HOST is not set. Add 'export GITEA_SSH_HOST=<gitea ssh hostname>'" \
             "(e.g. gitea.example.com) to ~/.profile.local" >&2
        exit 1
    fi
    if [ -z "${GITEA_API:-}" ]; then
        echo "GITEA_API is not set. Add 'export GITEA_API=https://<gitea host>/api/v1'" \
             "(e.g. https://gitea.example.com/api/v1) to ~/.profile.local" >&2
        exit 1
    fi
}

function require_token() {
    if [ -z "${GITEA_TOKEN:-}" ] && [ -f "$GITEA_TOKEN_FILE" ]; then
        GITEA_TOKEN=$(<"$GITEA_TOKEN_FILE")
    fi
    if [ -z "${GITEA_TOKEN:-}" ]; then
        echo "No Gitea token found. Generate one in the Gitea web UI" \
             "(Settings > Applications, scopes write:repository + write:issue)" \
             "and save it to $GITEA_TOKEN_FILE (chmod 600), or set GITEA_TOKEN" \
             "in the environment for this invocation only." >&2
        exit 1
    fi
}

# Feeds the auth header to curl as a config on stdin rather than as an
# argument. Command lines are world-readable through /proc, so `-H
# "Authorization: token $GITEA_TOKEN"` exposes the token to every other
# process on the host for as long as the request runs - and to anything that
# scrapes `ps` output, including the agents this repo exists to sandbox.
# printf is a bash builtin, so the token never lands in another argv.
function gitea_api() {
    printf 'header = "Authorization: token %s"\n' "$GITEA_TOKEN" |
        curl -sS -w '\n%{http_code}' -K - "$@"
}

# Splits gitea_api's combined output into the globals `json` and `http_code`
# and fails with the body on any non-2xx.
function api_or_die() {
    local what="$1"; shift
    local response
    response=$(gitea_api "$@")
    http_code=$(echo "$response" | tail -1)
    json=$(echo "$response" | sed '$d')
    if [ "$http_code" -lt 200 ] || [ "$http_code" -ge 300 ]; then
        echo "Failed to $what (HTTP $http_code):" >&2
        echo "$json" >&2
        exit 1
    fi
}

function gitea_owner_repo() {
    local remote_url host owner_repo
    remote_url=$(git remote get-url origin 2>/dev/null) || {
        echo "No 'origin' remote found in this repository" >&2
        exit 1
    }
    host=$(echo "$remote_url" | sed -E 's#^[^@]+@([^:]+):.*#\1#')
    if [ "$host" != "$GITEA_SSH_HOST" ]; then
        echo "origin remote ($remote_url) is not on $GITEA_SSH_HOST; gitea-actions only supports this host" >&2
        exit 1
    fi
    owner_repo=$(echo "$remote_url" | sed -E 's#^[^@]+@[^:]+:##; s#\.git$##')
    echo "$owner_repo"
}

# The API addresses runs by an internal id; every URL a human has shows the
# per-repo run number instead, and the two are unrelated. Everything below
# takes the number and resolves it here, against one page of the run list.
#
# With no number, HEAD's commit: a run list is not what someone who just
# pushed is asking for. Matched on head_sha rather than on branch because a
# pull_request run reports no branch at all - its ref is refs/pull/N/head.
function resolve_run() {
    local want="${1:-}" sha
    api_or_die "list runs" "${GITEA_API}/repos/${owner}/${repo}/actions/runs?page=1&limit=$RUN_SCAN"
    if [ -n "$want" ]; then
        run_id=$(echo "$json" | jq -r --argjson n "$want" \
            'first(.workflow_runs[] | select(.run_number == $n) | .id) // empty')
        if [ -z "$run_id" ]; then
            echo "No run numbered $want in the last $RUN_SCAN runs (raise --limit, or see 'gitea-actions runs')" >&2
            exit 1
        fi
    else
        sha=$(git rev-parse HEAD 2>/dev/null) || {
            echo "Not in a git repository, so there is no HEAD to look up - pass a run number" >&2
            exit 1
        }
        run_id=$(echo "$json" | jq -r --arg sha "$sha" \
            'first(.workflow_runs[] | select(.head_sha == $sha) | .id) // empty')
        if [ -z "$run_id" ]; then
            echo "No run for HEAD (${sha:0:8}) in the last $RUN_SCAN runs - unpushed, or still queued?" >&2
            exit 1
        fi
    fi
    run_number=$(echo "$json" | jq -r --argjson id "$run_id" \
        'first(.workflow_runs[] | select(.id == $id) | .run_number)')
}

# Sets `jobs_json` for the resolved run. The job index a URL shows is the
# tail of the job's html_url, not a field of its own, and the list does not
# arrive in that order.
function fetch_jobs() {
    api_or_die "list jobs for run $run_number" \
        "${GITEA_API}/repos/${owner}/${repo}/actions/runs/${run_id}/jobs"
    jobs_json=$(echo "$json" | jq '[.jobs[] | {
        index: (.html_url | split("/") | last | tonumber),
        id, name,
        result: (if .status == "completed" then .conclusion else .status end)
    }] | sort_by(.index)')
}

function print_job_log() {
    local id="$1" name="$2" result="$3"
    echo "=== $name ($result) ==="
    api_or_die "fetch logs for job $name" \
        "${GITEA_API}/repos/${owner}/${repo}/actions/jobs/${id}/logs"
    if [ "$KEEP_TIMESTAMPS" = 1 ]; then
        echo "$json"
    else
        # Every line carries an RFC3339 stamp from the runner. Useful for
        # timing a hang, pure noise for reading a failure, and this output
        # is usually going into an agent's context.
        echo "$json" | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z //'
    fi
    echo
}

RUN_SCAN=50
KEEP_TIMESTAMPS=0

if [ "$#" -lt 1 ]; then
    usage
    exit 1
fi

subcommand="$1"
shift

case "$subcommand" in
    runs|jobs|logs)
        require_config
        require_token
        owner_repo=$(gitea_owner_repo)
        owner="${owner_repo%%/*}"
        repo="${owner_repo##*/}"
        ;;
    *)
        usage
        exit 1
        ;;
esac

case "$subcommand" in
    runs)
        limit=20
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --limit) limit="$2"; shift 2 ;;
                *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
            esac
        done
        api_or_die "list runs" "${GITEA_API}/repos/${owner}/${repo}/actions/runs?page=1&limit=$limit"
        echo "$json" | jq -r '.workflow_runs[] | [
            (.run_number | tostring),
            (if .status == "completed" then .conclusion else .status end),
            .event,
            (.head_sha[0:8]),
            .display_title
        ] | @tsv' | column -t -s $'\t'
        ;;
    jobs)
        run_arg=""
        if [[ "${1:-}" =~ ^[0-9]+$ ]]; then run_arg="$1"; shift; fi
        if [ "$#" -gt 0 ]; then echo "Unknown option: $1" >&2; usage; exit 1; fi
        resolve_run "$run_arg"
        fetch_jobs
        echo "run $run_number:"
        echo "$jobs_json" | jq -r '.[] | [(.index | tostring), .result, .name] | @tsv' |
            column -t -s $'\t'
        ;;
    logs)
        run_arg=""
        job_want=""
        want_all=0
        if [[ "${1:-}" =~ ^[0-9]+$ ]]; then run_arg="$1"; shift; fi
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --job) job_want="$2"; shift 2 ;;
                --all) want_all=1; shift ;;
                --timestamps) KEEP_TIMESTAMPS=1; shift ;;
                *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
            esac
        done
        resolve_run "$run_arg"
        fetch_jobs

        if [ -n "$job_want" ]; then
            # An index is exact; anything else matches the name loosely, so
            # `--job host-docker` finds "host-docker" and `--job static`
            # finds "sandbox (static)".
            if [[ "$job_want" =~ ^[0-9]+$ ]]; then
                selected=$(echo "$jobs_json" | jq --argjson i "$job_want" '[.[] | select(.index == $i)]')
            else
                selected=$(echo "$jobs_json" | jq --arg n "$job_want" '[.[] | select(.name | contains($n))]')
            fi
            if [ "$(echo "$selected" | jq 'length')" -eq 0 ]; then
                echo "No job matching '$job_want' in run $run_number:" >&2
                echo "$jobs_json" | jq -r '.[] | "  \(.index)  \(.name)"' >&2
                exit 1
            fi
        elif [ "$want_all" = 1 ]; then
            selected="$jobs_json"
        else
            selected=$(echo "$jobs_json" | jq '[.[] | select(.result != "success")]')
            if [ "$(echo "$selected" | jq 'length')" -eq 0 ]; then
                echo "run $run_number: all $(echo "$jobs_json" | jq 'length') jobs succeeded (--all for their logs anyway)" >&2
                exit 0
            fi
        fi

        while IFS=$'\t' read -r id name result; do
            print_job_log "$id" "$name" "$result"
        done < <(echo "$selected" | jq -r '.[] | [(.id | tostring), .name, .result] | @tsv')
        ;;
esac
