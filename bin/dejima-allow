#!/bin/bash
# Add a domain to the egress firewall allowlist of a running dejima
# container, from outside it. The sandbox itself has no privilege to do this
# (node has no sudo/setuid path back to root - see this repo's README's
# Security notes section); if a sandboxed agent hits a blocked domain it
# actually needs, it should tell you the exact command to run here rather
# than try to work around the firewall.
#
# Usage: dejima-allow [--global] [--project [path]] [--container <id>] <domain>
#   dejima-allow crates.io                      # this running session only
#   dejima-allow --global crates.io             # persist for every project
#   dejima-allow --project crates.io            # persist for the project in $PWD
#   dejima-allow --project ~/myproj crates.io   # persist for one named project
#
# --project and --global are approvals for future sessions and deliberately do
# not touch a running container: a scope flag means "record this", not "patch
# the thing running right now". Pass --container as well to do both.
set -euo pipefail

# --help before anything else runs: no libraries sourced, no config read. The
# moment someone reaches for it is often the moment the config is wrong.
# stdout and exit 0, where usage() stays on stderr and exits nonzero.
case "${1:-}" in
    -h|--help)
        cat <<'DEJIMA_ALLOW_HELP'
dejima-allow - let a sandbox reach a domain the egress firewall blocks

Usage: dejima-allow [--global] [--project [path]] [--container <id>] <domain>

Scope, which decides who the grant is for and how long it lasts:
  (none)             the running container, right now, until it exits. Finds it
                     if exactly one is running; refuses if none or several.
  --container <id>   the same, for a named container. Use this when a session
                     told you its own id rather than letting anything guess.
                     With several running, they are listed by project and by
                     the number the dejima-attach picker gives each one.
  --project [path]   every future session in one project. Also writes the domain
                     to that project's .dejima/allowed-domains, so it is shared
                     with everyone working on it. Path defaults to $PWD.
  --global           every future session in every project on this host.

They combine. --project and --global deliberately do NOT touch a session that
is already running: they are approvals for future ones. Pass --container as
well to do both at once.

Prefer --project to --global. A domain one project needs is that project's, and
a global grant widens every other project's firewall too.

With --container, the domain is verified reachable afterwards and a warning is
printed if it is not, so a typo or a blocked port does not look like success.

See docs/configuration.md; docs/security.md explains what the allowlist bounds.
DEJIMA_ALLOW_HELP
        exit 0 ;;
esac

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=dejima-project-lib.sh
source "$SCRIPT_DIR/dejima-project-lib.sh"
# For ipset_for_domain: the live add below writes into a running container's
# ipsets, and which set a name belongs in is the container's rule, not this
# script's. Sourced rather than restated so the two cannot drift - the same
# reason init-firewall.sh and dns-proxy.sh share this file.
# shellcheck source=../docker/fixed-domains.sh
source "$SCRIPT_DIR/../docker/fixed-domains.sh"

usage() {
    echo "Usage: dejima-allow [--global] [--project [path]] [--container <id>] <domain>" >&2
    exit 1
}

# 1: the domain is the required trailing positional, which is what tells
# parse_scope_args whether a token after --project is a path or the domain.
parse_scope_args 1 "$@" || usage
[ "${#dj_positional[@]}" -eq 1 ] || usage
domain="${dj_positional[0]}"
global="$dj_global"
project=""
if [ "$dj_project_set" -eq 1 ]; then
    project="$(cd "${dj_project:-$PWD}" && pwd)"
    disclose_project_symlink "$project"
fi
container="$dj_container"

# Validated up front, not just passed as a positional arg below: this also
# has to be a well-formed hostname to be a valid dnsmasq server=/domain/...
# line (e.g. no embedded "/"), on top of ruling out shell metacharacters. A
# sandboxed agent can suggest this exact command to the user to copy-paste
# (see sandbox-context.sh), so a prompt-injected agent handing back a
# malicious "domain" is a real path here, not just a theoretical one.
if [[ ! "$domain" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,62}\.)*[a-zA-Z0-9-]{1,63}$ ]]; then
    echo "Not a valid domain: $domain" >&2
    exit 1
fi

# Recorded first, and unconditionally: --project/--global are the user's
# approval decision for future sessions, not a claim about this one. Gating
# either on a live container would break the documented workflow outright -
# approving dependencies requires leaving the sandbox, so the usual moment to
# run this is precisely when nothing is running. Gating on the reachability
# probe below would refuse any declared domain that legitimately doesn't serve
# HTTPS on 443. The two scopes are independent, not exclusive: both may be
# given together, and each persists to its own store.
if [ -n "$project" ]; then
    store="$(ensure_project_store "$project")"
    approve_entry "$store" allowed-domains "$domain"
    echo "Added $domain to the approved domains for $project (applies to every future session in it)."
    # Printed only after the approval above, and guarded rather than left to
    # set -e: the approval is what grants, and it is already written by this
    # point. Letting a declare_entry failure abort here would exit before this
    # echo ever ran, leaving the operator thinking nothing happened when a
    # domain had, in fact, just been approved for every future session.
    if declare_entry "$project" allowed-domains "$domain"; then
        echo "Declared it in $project/.dejima/allowed-domains - commit that to share it."
    else
        echo "The approval above IS recorded and applies to every future session in it;" >&2
        echo "only the project's own .dejima declaration could not be written." >&2
    fi
fi
if [ "$global" -eq 1 ]; then
    store="$(ensure_global_store)"
    approve_entry "$store" allowed-domains "$domain"
    echo "Added $domain to the global approved domains (applies to every future session)."
fi

# A scope flag means "record this approval", not "patch what is running now" -
# so a --project/--global invocation never goes near Docker, and stops
# reporting on containers the caller did not ask about. --container is the
# explicit opt-in to doing both.
#
# This is the only thing that decides. Deliberately not an environment
# variable as well: a firewall CLI with an environment-triggered no-op path
# is one an env var can silently disarm.
# A container list an operator can act on without asking the agent anything.
#
# The name alone is a run id, which is exactly what someone with three
# sessions open does not know. What they do know is which project each one is
# working on, and - where remote access is on - the number the dejima-attach
# picker gives it, because that is the list they are already reading.
#
# The project comes from the container's own working directory rather than
# from the session registry, so it is there for every session and not only a
# remote-enabled one. The picker number comes from `dejima-attach --list`,
# whose rows the picker numbers 1..N in the order they are printed; absent
# where remote access is off, which is a column missing rather than a failure.
#
# Reads only. Nothing here decides which container is acted on - that is the
# caller's --container, or the single running one.
describe_containers() {
    local listing="$1" name id project row n=0 idx
    local -A attach_index=()
    while IFS=$'\t' read -r _ _ _ _ _ row; do
        [ -n "$row" ] || continue
        n=$((n + 1))
        attach_index["$row"]="$n"
    done < <(dejima-attach --list 2>/dev/null || true)
    while IFS=$'\t' read -r name id; do
        [ -n "$name" ] || continue
        project="$(docker inspect -f '{{.Config.WorkingDir}}' "$id" 2>/dev/null)" || project=""
        [ -n "$project" ] && project="$(basename "$project")"
        idx="${attach_index[${id:0:12}]:-}"
        printf '  %-28s %-24s %s\n' "$name" "${project:-?}" \
            "${idx:+(dejima-attach $idx)}"
    done <<< "$listing"
}

session_wanted=1
if [ -n "$project" ] || [ "$global" -eq 1 ]; then
    [ -n "$container" ] || session_wanted=0
fi
if [ "$session_wanted" -eq 1 ]; then
    if [ -z "$container" ]; then
        containers=$(docker ps --filter "label=com.docker.compose.project=dejima" \
            --filter "status=running" --format '{{.Names}}	{{.ID}}')
        count=$(echo "$containers" | grep -c . || true)
        if [ "$count" -eq 0 ]; then
            echo "No running dejima container found." >&2
            exit 1
        elif [ "$count" -gt 1 ]; then
            echo "Multiple running dejima containers found; specify one with --container:" >&2
            echo "" >&2
            describe_containers "$containers" >&2
            echo "" >&2
            echo "(a sandboxed agent's own container ID is printed in its startup context," >&2
            echo "or by 'cat /etc/hostname' inside that sandbox - don't let it guess one)" >&2
            exit 1
        fi
        container="${containers%%$'\t'*}"
    fi

    # The DNS proxy (dns-proxy.sh) NXDOMAINs anything not in its allowlist, so
    # this has to happen *before* resolving the domain below - otherwise the dig
    # right after this would itself get blocked. Append a server= line to
    # dnsmasq's servers-file (idempotent - skip if already present from an
    # earlier call) and SIGHUP it to reload just that file, no restart needed.
    # $domain is passed as a positional arg to the inner script (`$1`, inside a
    # single-quoted heredoc) rather than interpolated into the script text - it's
    # validated above, but this keeps it that way even if the validation regex
    # above is ever loosened later.
    docker exec -u root "$container" bash -c '
        domain="$1"
        entry="server=/${domain}/127.0.0.11"
        grep -qxF "$entry" /etc/dnsmasq-sandbox-servers.conf 2>/dev/null || echo "$entry" >> /etc/dnsmasq-sandbox-servers.conf
        kill -HUP "$(cat /var/run/dnsmasq-sandbox.pid)"
    ' -- "$domain"

    echo "Resolving $domain inside $container..."
    ips=$(docker exec "$container" dig +short A "$domain" | grep -E '^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$' || true)
    if [ -z "$ips" ]; then
        # An internally-routed name can't be added to a *running* session at
        # all: dnsmasq's stop-dns-rebind drops a private answer for any domain
        # not exempted when the container started, and dns-proxy.sh writes
        # those rebind-domain-ok= lines only at startup - the servers-file this
        # script SIGHUPs carries server= lines and nothing else. Asking the
        # upstream resolver directly separates that dead end from a name that
        # simply doesn't resolve, so the message can name the fix that works.
        upstream=$(docker exec "$container" dig +short A "$domain" @127.0.0.11 2>/dev/null |
            grep -E '^(10\.|127\.|169\.254\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)' || true)
        if [ -n "$upstream" ]; then
            echo "$domain resolves to a private address (${upstream//$'\n'/ }), which the" >&2
            echo "container's DNS rebind protection drops for any domain not allowlisted" >&2
            echo "when it started." >&2
            echo "" >&2
            if [ -n "$project" ] || [ "$global" -eq 1 ]; then
                echo "  (the approval recorded above already does this)" >&2
            else
                echo "  dejima-allow --global $domain" >&2
            fi
            echo "" >&2
            echo "Relaunch the session to pick it up - a running one cannot be patched." >&2
            exit 1
        fi
        echo "Failed to resolve $domain inside the container." >&2
        exit 1
    fi

    # allowed-domains carries no port restriction, so a GitHub address added
    # there is reachable on 22 as well - which is the read-only guarantee gone,
    # from a command whose whole output says it granted one domain.
    target_set=$(ipset_for_domain "$domain")
    for ip in $ips; do
        echo "Allowing $ip ($domain -> $target_set)"
        docker exec -u root "$container" ipset add "$target_set" "$ip" -exist
    done

    echo "$domain allowed for the running session ($container)."

    # TCP-level truth check from inside the very container that was just
    # updated - this script's job is the firewall, so "TCP connect succeeded"
    # is the claim to verify. curl exit 6 (resolve failed), 7 (connect
    # refused/blocked) and 28 (connect or overall timeout) mean still
    # unreachable; anything else (0, or a TLS/HTTP-layer code like 35/52) means
    # the connection itself went through the firewall fine. --max-time bounds
    # the whole request, not just the connect phase - without it, a server that
    # accepts the TCP connection and then stalls (never sends TLS/HTTP bytes)
    # would hang this script indefinitely; curl maps that case to the same
    # exit 28 the case below already handles, so no new branch is needed. This
    # is a report on this run, not a gate on either scope's approval: both
    # --project and --global are already recorded above, deliberately - a
    # declared host may legitimately not answer on 443 (an internal service,
    # an SSH-only host, an apex that only serves a subdomain), and the natural
    # moment to add a global approval is precisely when nothing is running to
    # probe in the first place. The exit 2 below still means what it says:
    # the live patch to this session did not verify.
    echo "Verifying $domain is reachable from $container..."
    rc=0
    docker exec "$container" curl -sI --connect-timeout 5 --max-time 10 "https://$domain/" >/dev/null 2>&1 || rc=$?
    case "$rc" in
        6|7|28)
            echo "WARNING: $domain is still NOT reachable from $container (curl exit $rc)." >&2
            echo "If the service doesn't listen on 443 this check can fail spuriously;" >&2
            echo "otherwise the allow did not take effect - re-check the container ID." >&2
            exit 2
            ;;
        *)
            echo "Verified: $domain is reachable from $container."
            ;;
    esac
fi
