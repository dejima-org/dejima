#!/bin/bash
# Add a domain to the egress firewall allowlist of a running dejima
# container, from outside it. The sandbox itself has no privilege to do this
# (node has no sudo/setuid path back to root - see this repo's README's
# Security notes section); if a sandboxed agent hits a blocked domain it
# actually needs, it should tell you the exact command to run here rather
# than try to work around the firewall.
#
# Usage: dejima-allow <domain> [--global] [--project <path>] [--container <name>]
#   dejima-allow crates.io                     # this running session only
#   dejima-allow crates.io --global            # + persist for every project
#   dejima-allow crates.io --project ~/myproj  # + persist for one project
set -euo pipefail

domain=""
global=0
project=""
container=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --global) global=1; shift ;;
        --project) project="$2"; shift 2 ;;
        --container) container="$2"; shift 2 ;;
        -*) echo "Unknown option: $1" >&2; exit 1 ;;
        *)
            if [ -n "$domain" ]; then
                echo "Usage: dejima-allow <domain> [--global] [--project <path>] [--container <name>]" >&2
                exit 1
            fi
            domain="$1"
            shift
            ;;
    esac
done

if [ -z "$domain" ]; then
    echo "Usage: dejima-allow <domain> [--global] [--project <path>] [--container <name>]" >&2
    exit 1
fi

# Validated up front, not just passed as a positional arg below: this also
# has to be a well-formed hostname to be a valid dnsmasq server=/domain/...
# line (e.g. no embedded "/"), on top of ruling out shell metacharacters. A
# sandboxed agent can suggest this exact command to the user to copy-paste
# (see sandbox-context.sh), so a prompt-injected agent handing back a
# malicious "domain" is a real path here, not just a theoretical one.
if [[ ! "$domain" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,62}\.)*[a-zA-Z0-9-]{1,63}$ ]]; then
    echo "Not a valid domain: $domain" >&2
    exit 1
fi

# Recorded first, and unconditionally: --project/--global are the user's
# approval decision for future sessions, not a claim about this one. Gating
# either on a live container would break the documented workflow outright -
# approving dependencies requires leaving the sandbox, so the usual moment to
# run this is precisely when nothing is running. Gating on the reachability
# probe below would refuse any declared domain that legitimately doesn't serve
# HTTPS on 443. The two scopes are independent, not exclusive: both may be
# given together, and each persists to its own store.
if [ -n "$project" ] || [ "$global" -eq 1 ]; then
    SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
    # shellcheck source=dejima-project-lib.sh
    source "$SCRIPT_DIR/dejima-project-lib.sh"
fi
if [ -n "$project" ]; then
    project="$(cd "$project" && pwd)"
    store="$(ensure_project_store "$project")"
    approve_entry "$store" allowed-domains "$domain"
    echo "Added $domain to the approved domains for $project (applies to every future session in it)."
fi
if [ "$global" -eq 1 ]; then
    store="$(ensure_global_store)"
    approve_entry "$store" allowed-domains "$domain"
    echo "Added $domain to the global approved domains (applies to every future session)."
fi

# The live-session update below needs a running container to exec into.
# Skipped only by the test suite (test/project.bats), which exercises
# --project persistence on its own, without a container.
if [ "${DEJIMA_ALLOW_SKIP_SESSION:-0}" != "1" ]; then
    if [ -z "$container" ]; then
        containers=$(docker ps --filter "label=com.docker.compose.project=dejima" --filter "status=running" --format '{{.Names}}')
        count=$(echo "$containers" | grep -c . || true)
        if [ "$count" -eq 0 ]; then
            echo "No running dejima container found." >&2
            # With --project or --global (or both) there is nothing left to
            # do and nothing went wrong: the approval is already recorded and
            # applies from the next launch.
            if [ -n "$project" ] || [ "$global" -eq 1 ]; then
                echo "Nothing to patch for this session; $domain applies from the next launch." >&2
                exit 0
            fi
            exit 1
        elif [ "$count" -gt 1 ]; then
            echo "Multiple running dejima containers found; specify one with --container:" >&2
            echo "$containers" >&2
            echo "(a sandboxed agent's own container ID is printed in its startup context," >&2
            echo "or by 'cat /etc/hostname' inside that sandbox - don't let it guess one)" >&2
            exit 1
        fi
        container="$containers"
    fi

    # The DNS proxy (dns-proxy.sh) NXDOMAINs anything not in its allowlist, so
    # this has to happen *before* resolving the domain below - otherwise the dig
    # right after this would itself get blocked. Append a server= line to
    # dnsmasq's servers-file (idempotent - skip if already present from an
    # earlier call) and SIGHUP it to reload just that file, no restart needed.
    # $domain is passed as a positional arg to the inner script (`$1`, inside a
    # single-quoted heredoc) rather than interpolated into the script text - it's
    # validated above, but this keeps it that way even if the validation regex
    # above is ever loosened later.
    docker exec -u root "$container" bash -c '
        domain="$1"
        entry="server=/${domain}/127.0.0.11"
        grep -qxF "$entry" /etc/dnsmasq-sandbox-servers.conf 2>/dev/null || echo "$entry" >> /etc/dnsmasq-sandbox-servers.conf
        kill -HUP "$(cat /var/run/dnsmasq-sandbox.pid)"
    ' -- "$domain"

    echo "Resolving $domain inside $container..."
    ips=$(docker exec "$container" dig +short A "$domain" | grep -E '^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$' || true)
    if [ -z "$ips" ]; then
        echo "Failed to resolve $domain inside the container." >&2
        exit 1
    fi

    for ip in $ips; do
        echo "Allowing $ip ($domain)"
        docker exec -u root "$container" ipset add allowed-domains "$ip" -exist
    done

    echo "$domain allowed for the running session ($container)."

    # TCP-level truth check from inside the very container that was just
    # updated - this script's job is the firewall, so "TCP connect succeeded"
    # is the claim to verify. curl exit 6 (resolve failed), 7 (connect
    # refused/blocked) and 28 (connect or overall timeout) mean still
    # unreachable; anything else (0, or a TLS/HTTP-layer code like 35/52) means
    # the connection itself went through the firewall fine. --max-time bounds
    # the whole request, not just the connect phase - without it, a server that
    # accepts the TCP connection and then stalls (never sends TLS/HTTP bytes)
    # would hang this script indefinitely; curl maps that case to the same
    # exit 28 the case below already handles, so no new branch is needed. This
    # is a report on this run, not a gate on either scope's approval: both
    # --project and --global are already recorded above, deliberately - a
    # declared host may legitimately not answer on 443 (an internal service,
    # an SSH-only host, an apex that only serves a subdomain), and the natural
    # moment to add a global approval is precisely when nothing is running to
    # probe in the first place. The exit 2 below still means what it says:
    # the live patch to this session did not verify.
    echo "Verifying $domain is reachable from $container..."
    rc=0
    docker exec "$container" curl -sI --connect-timeout 5 --max-time 10 "https://$domain/" >/dev/null 2>&1 || rc=$?
    case "$rc" in
        6|7|28)
            echo "WARNING: $domain is still NOT reachable from $container (curl exit $rc)." >&2
            echo "If the service doesn't listen on 443 this check can fail spuriously;" >&2
            echo "otherwise the allow did not take effect - re-check the container ID." >&2
            exit 2
            ;;
        *)
            echo "Verified: $domain is reachable from $container."
            ;;
    esac
fi
