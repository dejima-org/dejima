#!/bin/bash
# Launch the dejima container, with a project directory bind-mounted
# at its real host path. Defaults to running bare `claude` inside (with
# --dangerously-skip-permissions); set [core] command in the config file,
# or pass --cmd, to run something else instead (see README).
#
# Usage: dejima [path-to-project] [-- extra args...]
#   dejima                      # sandbox the current directory
#   dejima ~/repos/myproject
set -euo pipefail

# --help, before anything else runs.
#
# Deliberately ahead of the library sourcing and the config parse below: the
# moment someone reaches for --help is often the moment the config is missing
# or wrong, and a help page that needs a working config to print is no help.
# Nothing here but `cat`.
#
# stdout and exit 0, unlike usage(), which stays on stderr with a nonzero exit
# so a mistyped invocation still fails a script. That split is the whole of
# what #64 asked for: bare invocation keeps its terse line, --help explains.
case "${1:-}" in
    -h|--help)
        cat <<'DEJIMA_HELP'
dejima - run an agent harness in a container that cannot reach your machine

Usage: dejima [options] [workspace] [-- args...]

  workspace    project directory to mount read-write (default: current directory)
  -- args...   everything after is passed to the harness command untouched

Options (each overrides the config file for one launch only):
  --forge <name>          which forge integration to use for this launch
  --workflow <name>       what the agent is told to do with its work
  --cmd <command>         run this instead of the harness's own command
  --ro,  --extra-readonly <path>    also mount this host path read-only
  --rw,  --extra-read-write <path>  also mount this host path read-write
  --allow-github-push     open GitHub's push path (port 22) for this launch
  --no-firewall           disable the egress firewall entirely (debugging only)
  --print-config          print the resolved configuration and exit
  --print-briefing        print the session briefing the agent will get, and exit
  -h, --help              this message

--ro and --rw may be given more than once. Both refuse a path that overlaps
dejima's own approval, audit or epitaph stores.

Configuration lives in ~/.config/dejima/config and [core] harness must be set
before a launch will start. --print-config shows what is actually in effect,
including which flag overrode which key.

See docs/configuration.md for every key, docs/security.md for what the
container can and cannot reach.
DEJIMA_HELP
        exit 0 ;;
esac

# readlink -f resolves through the ~/.local/bin/dejima symlink
# install.sh sets up - without it, BASH_SOURCE[0] is the symlink's own path
# when invoked by name via PATH, so dirname finds ~/.local/bin instead of
# this repo's real bin/, and everything below (REPO_ROOT, COMPOSE_FILE)
# resolves against the wrong directory entirely.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_ROOT="$SCRIPT_DIR/.."
COMPOSE_FILE="$REPO_ROOT/docker/docker-compose.yml"
# shellcheck source=dejima-project-lib.sh
source "$SCRIPT_DIR/dejima-project-lib.sh"
# shellcheck source=dejima-provider-lib.sh
source "$SCRIPT_DIR/dejima-provider-lib.sh"
# shellcheck source=dejima-color-lib.sh
source "$SCRIPT_DIR/dejima-color-lib.sh"
# shellcheck source=dejima-slug-lib.sh
source "$SCRIPT_DIR/dejima-slug-lib.sh"
# shellcheck source=dejima-harness-lib.sh
source "$SCRIPT_DIR/dejima-harness-lib.sh"
# fd 2: everything this script says for itself goes to stderr, so the
# session's own stdout stays exactly what the container wrote.
color_init 2

# Parse the config file here, in THIS shell, before anything reads a key.
#
# The parse is already cached (_CFG_PARSED_PATH), but almost every reader
# reaches it through `$(config_get ...)`, and a cache filled inside a command
# substitution is discarded with the subshell that filled it. Nothing on the
# launch path populated it in the parent, so each of those subshells re-read
# and re-parsed the whole file - dozens of times per launch. Doing it once
# here means every subshell inherits it already parsed.
#
# Failure is deliberately not fatal here: this is a warm-up, not the
# validation, and the callers that already refuse a bad config still do.
#
# But a failed warm must not CONSUME the diagnosis. _config_parse prints the
# first problem it finds as it parses, and the status is cached - so leaving a
# failure cached let the real caller return that status with the message
# already swallowed by the redirect above, and an invalid config was refused
# with no reason given. Dropping the cache entry makes that caller parse again
# and report, which costs one extra parse of a config that is about to be
# refused anyway.
if ! config_validate >/dev/null 2>&1; then
    _CFG_PARSED_PATH=""
fi

# Flags come first, then the optional workspace path, then "--" and
# everything after that reaches the container command untouched - including a
# token that looks like one of our own flags. The "--" must come AFTER the
# workspace path: a bare "--" here, before any positional argument, is still
# consumed by this loop, so `dejima -- --resume` treats --resume as the
# workspace ("Not a directory: --resume") rather than passing it through.
# Each flag's value is validated against the same schema type its config key
# uses, so `--cmd 'rm -rf /'` fails here for the same reason it would fail in
# the file.
FLAG_OVERRIDES=()
_set_override() {
    local key="$1" value="$2" type entry
    local -a kept=()
    type="$(config_type "$key")" || { echo "unknown config key: $key" >&2; exit 1; }
    if ! _config_valid_value "$type" "$value"; then
        echo "invalid value for --${key##*.}: $value" >&2
        exit 1
    fi
    # A repeated flag takes the last value, same as a repeated key in the
    # config file - drop any earlier override for this key before appending.
    for entry in ${FLAG_OVERRIDES[@]+"${FLAG_OVERRIDES[@]}"}; do
        [ "${entry%%=*}" = "$key" ] || kept+=("$entry")
    done
    FLAG_OVERRIDES=(${kept[@]+"${kept[@]}"} "$key=$value")
}
_need_value() {
    [ -n "${2:-}" ] && [ "${2:0:2}" != "--" ] || {
        echo "$1 requires a value" >&2
        exit 1
    }
}

# Per-launch additions to [mounts] readonly and [mounts] read_write, for the
# one-off cases: reading another checkout while migrating code out of it,
# writing to a scratch directory for one session. Repeatable, one path each.
#
# These append to the config's own lists rather than carrying their own mount
# code, which is the whole design. Everything that already applies to a
# configured mount then applies to a flag automatically and with nothing
# duplicated: the existence check, the refusal when a path names the approval
# store or the audit stores, the refusal when the same path appears in both
# lists, and the read-write paths the session briefing and the audit report
# header name. A flag is a way to say where, not a way around any of that.
EXTRA_RO_FLAGS=()
EXTRA_RW_FLAGS=()
FLAG_MOUNTS=""
_add_mount_flag() {
    local flag="$1" value="$2"
    # Both lists are colon-separated, so a path containing one cannot be
    # represented in them at all - it would silently split into two mounts
    # that each fail the existence check. Say so instead.
    case "$value" in
        *:*) echo "$flag path must not contain a colon: $value" >&2; exit 1 ;;
    esac
    # Same leading-~ expansion the config's list:path type does, for the
    # quoted case the shell leaves alone.
    value="${value/#\~/$HOME}"
    # Relative paths are worth accepting here and meaningless in a config
    # file, which has no working directory to be relative to. Made absolute
    # by prefixing rather than by readlink -f: resolving would mount the
    # symlink's target under a path the operator never typed.
    case "$value" in /*) ;; *) value="$PWD/$value" ;; esac
    case "$flag" in
        --extra-readonly)   EXTRA_RO_FLAGS+=("$value") ;;
        --extra-read-write) EXTRA_RW_FLAGS+=("$value") ;;
    esac
    # Recorded here, at parse time, and not where the lists are assembled:
    # that happens inside a command substitution, whose subshell would throw
    # the assignment away and leave every flag reported as a config entry.
    FLAG_MOUNTS="${FLAG_MOUNTS:+$FLAG_MOUNTS:}$value"
}
_append_mounts() {
    local list="$1"; shift
    local p
    for p in "$@"; do
        list="${list:+$list:}$p"
    done
    printf '%s' "$list"
}
# Which of the two the operator actually wrote, for the refusals below.
# Without this a mistyped --ro is reported as a "[mounts] readonly entry",
# sending someone to a config file that does not mention the path at all.

_mount_label() {
    local path="$1" from_config="$2" from_flag="$3"
    case ":$FLAG_MOUNTS:" in
        *":$path:"*) printf '%s' "$from_flag" ;;
        *)           printf '%s' "$from_config" ;;
    esac
}

PRINT_CONFIG=0
PRINT_BRIEFING=0
ALLOW_GITHUB_PUSH_FLAG=0
while [ $# -gt 0 ]; do
    case "$1" in
        --) shift; break ;;
        --print-config)      PRINT_CONFIG=1; shift ;;
        --print-briefing)    PRINT_BRIEFING=1; shift ;;
        --no-firewall)       _set_override core.firewall off; shift ;;
        --allow-github-push) ALLOW_GITHUB_PUSH_FLAG=1; shift ;;
        --cmd)      _need_value --cmd "${2:-}";      _set_override core.command "$2";  shift 2 ;;
        --harness)  _need_value --harness "${2:-}";  _set_override core.harness "$2";  shift 2 ;;
        --forge)    _need_value --forge "${2:-}";    _set_override core.forge "$2";    shift 2 ;;
        --workflow) _need_value --workflow "${2:-}"; _set_override core.workflow "$2"; shift 2 ;;
        --extra-readonly|--ro)
            _need_value --extra-readonly "${2:-}"
            _add_mount_flag --extra-readonly "$2"; shift 2 ;;
        --extra-read-write|--rw)
            _need_value --extra-read-write "${2:-}"
            _add_mount_flag --extra-read-write "$2"; shift 2 ;;
        --*) echo "unknown option: $1" >&2; exit 1 ;;
        *) break ;;
    esac
done

# Wraps config_get so a flag wins over the file for the rest of this run.
# Defined here rather than in the library because an override is a property
# of one invocation of this launcher, not of the config file.
config_get() {
    local key="$1.$2" entry
    for entry in ${FLAG_OVERRIDES[@]+"${FLAG_OVERRIDES[@]}"}; do
        [ "${entry%%=*}" = "$key" ] || continue
        printf '%s' "${entry#*=}"
        return 0
    done
    _config_get_from_file "$1" "$2"
}

# Retired environment variables. Named, never honoured: silently ignoring an
# exported LOKI_URL means logs stop shipping with nothing saying why, and
# silently ignoring SANDBOX_ANTHROPIC_TRANSPORT means a session quietly gets
# a different egress path than the operator configured. Both are the class of
# surprise this repo spends its warnings on.
_warn_legacy_env() {
    local pair name dest shown=0
    for pair in \
        "GITEA_SSH_HOST=[forge.gitea] ssh_host" \
        "GITEA_API=[forge.gitea] api" \
        "GITEA_TOKEN_FILE=[forge.gitea] token_file" \
        "GITEA_TOKEN=[forge.gitea] token_file (set the path, not the token)" \
        "GH_TOKEN_FILE=[github] token_file" \
        "GH_TOKEN=[github] token_file (set the path, not the token)" \
        "SANDBOX_CMD=[core] command" \
        "SANDBOX_SSH_KEY=[core] ssh_key" \
        "SANDBOX_SHARE_DIR=[core] share_dir" \
        "SANDBOX_EXTRA_MOUNTS=[mounts] readonly" \
        "SANDBOX_NVIM_CONFIG=[mounts] nvim_config" \
        "SANDBOX_CREDENTIAL_PROXY=[credentials] proxy" \
        "SANDBOX_ANTHROPIC_TRANSPORT=[credentials] transport" \
        "SANDBOX_LOG_CONVERSATION=[logging] conversation" \
        "LOKI_URL=[logging] loki_url" \
        "ENABLE_FIREWALL=[core] firewall" \
        "SSH_KNOWN_HOSTS=[core] known_hosts" \
        "ALLOW_GITHUB_PUSH=the --allow-github-push flag" \
        "DEJIMA_AUDIT_DIR=[audit] dir" \
        "DEJIMA_AUDIT_BASELINE_DIR=[audit] baselines_dir" \
        "DEJIMA_AUDIT_KEEP=[audit] keep" \
        "DEJIMA_AUDIT_STRICT=[audit] strict" \
        "DEJIMA_AUDIT_DIFFS=[audit] diffs" \
        "DEJIMA_AUDIT_STATUSLINE=[harness.claude-code] statusline_path" \
        "DEJIMA_AUDIT_PROJECTS_DIR=[harness.claude-code] projects_dir" \
        "DEJIMA_DEBOUNCE_SECONDS=[remote-access] debounce" \
    ; do
        name="${pair%%=*}"
        dest="${pair#*=}"
        [ -n "${!name:-}" ] || continue
        if [ "$shown" = 0 ]; then
            echo "" >&2
            echo "These environment variables are no longer read by dejima:" >&2
            shown=1
        fi
        printf '  %s -> %s\n' "$name" "$dest" >&2
    done
    if [ "$shown" = 1 ]; then
        echo "Set them in $(config_path) instead, then unset them in your shell profile." >&2
        echo "" >&2
    fi

    # GITEA_TOKEN/GITEA_SSH_HOST/GITEA_API are retired (named above) -
    # forge_env_exports computes their replacements fresh from the manifest
    # further down and passes them as -e flags, but a value already exported
    # by the operator's shell is otherwise inherited by the docker subprocess
    # unchanged since nothing else reassigns these three names. Cleared, not
    # just unread, for the same reason the old hardcoded GITEA_TOKEN
    # computation started from "" rather than the inherited value. These
    # three names, specifically, are the only environment variables dejima
    # ever read directly for forge configuration before the manifest schema
    # replaced them - they name no CURRENT forge selection, only that one
    # retired path, so unlike the rest of this file they stay fixed regardless
    # of which forge is configured or added later.
    unset GITEA_TOKEN GITEA_SSH_HOST GITEA_API
}
_warn_legacy_env

if ! config_exists; then
    echo "No dejima config at $(config_path)." >&2
    echo "Run ./install.sh to generate a starter one, then edit it." >&2
    exit 1
fi

# A forge's env_export can name a variable core also fills - today GH_TOKEN,
# which core sets from [github] token_file for every session regardless of
# forge. One variable carries one token, so the forge's wins. Warned rather
# than left silent: an operator who configured both is entitled to know which
# is in effect. Not a refusal, since the forge winning is what selecting it
# asked for.
#
# Driven off env_export rather than the forge's name - the collision belongs
# to the variable, not to any particular forge. Checked here, ahead of
# --print-config's exit, so that reports it too. Both values must actually be
# set: a forge key resolving to nothing leaves core's in effect, and claiming
# the forge won would be false.
_warn_forge_env_collisions() {
    local forge="$1" pair name ref core core_name core_section core_leaf
    local core_file forge_file
    for pair in $(manifest_get forge "$forge" env_export); do
        name="${pair%%=*}"
        ref="${pair#*=}"
        # Only the "@" form (the CONTENTS of the file a config key names) can
        # carry one of core's own credentials.
        [ "${ref:0:1}" = "@" ] || continue
        # NAME=<core section> <core key>, for every variable core fills from
        # the config file itself.
        # A one-row table, not a loop that happens to run once: another
        # core-filled variable is a line here rather than a new branch.
        # shellcheck disable=SC2043
        for core in "GH_TOKEN=github token_file"; do
            core_name="${core%%=*}"
            [ "$name" = "$core_name" ] || continue
            core_section="${core#*=}"
            core_leaf="${core_section##* }"
            core_section="${core_section%% *}"
            core_file="$(config_get "$core_section" "$core_leaf")"
            forge_file="$(config_get "forge.$forge" "${ref:1}")"
            [ -f "$core_file" ] && [ -s "$core_file" ] || continue
            [ -f "$forge_file" ] && [ -s "$forge_file" ] || continue
            echo "Note: [$core_section] $core_leaf is not used while [core] forge = $forge." >&2
            echo "$name comes from [forge.$forge] ${ref:1} for this launch." >&2
        done
    done
}
# Guarded on config_get succeeding: an invalid [core] forge already made
# config_get print the real error (via config_validate) and return empty,
# so feeding that empty value on to _warn_forge_env_collisions would only
# add a second, spurious "invalid forge name:" line on top of it.
if _core_forge="$(config_get core forge)"; then
    _warn_forge_env_collisions "$_core_forge"
fi

# --print-config resolves the whole precedence chain and exits, before any
# workspace argument is required and before anything is built or mounted.
# It exists for two reasons: it answers "one config file now - what is
# actually in effect?", and it is what makes the flag-beats-config chain
# testable without booting Docker.
if [ "$PRINT_CONFIG" = 1 ]; then
    config_validate || exit 1
    while IFS= read -r _key; do
        _section="${_key%.*}"
        _leaf="${_key##*.}"
        printf '%s=%s\n' "$_key" "$(config_get "$_section" "$_leaf")"
    done < <(_config_keys)
    exit 0
fi

# The selected forge/workflow/harness combination, resolved and validated
# before anything is built or mounted - see provider_validate_selection's own
# definition for the full set of rules it enforces, all as refusals.
DEJIMA_FORGE_NAME="$(config_get core forge)"
DEJIMA_WORKFLOW_NAME="$(config_get core workflow)"
DEJIMA_HARNESS_NAME="$(config_get core harness)"
# No default: claude-code was one, and a release changing it would move an
# operator who never chose to a different harness on upgrade.
if [ -z "$DEJIMA_HARNESS_NAME" ]; then
    echo "[core] harness is not set in $(config_path)." >&2
    echo "There is no default, so a later release cannot change your choice." >&2
    echo "" >&2
    echo "  [core]" >&2
    echo "  harness = claude-code" >&2
    echo "" >&2
    echo "Available: $(provider_list harness | tr '\n' ' ')" >&2
    exit 1
fi
provider_validate_selection "$DEJIMA_FORGE_NAME" "$DEJIMA_WORKFLOW_NAME" "$DEJIMA_HARNESS_NAME" || exit 1


# The selected harness's plugin: what dejima does for this harness that no
# manifest value could state. Loaded once the selection is validated, and
# before anything that calls a hook. A manifest without a plugin is refused
# rather than treated as a lighter kind of support - see "Adding a new
# harness" in docs/development.md.
harness_plugin_load "$DEJIMA_HARNESS_NAME"

# Whether GitHub is a push destination this session, which the briefing tells
# the agent about. Two ways in: the per-launch flag, or a forge whose hosts
# core allowlists (github) under a workflow that pushes. Derived from the
# manifests directly rather than from DEJIMA_WORKFLOW_PUSH, which is resolved
# further down - this has to be settled before --print-briefing exits, or that
# would render a briefing a real launch does not.
DEJIMA_GITHUB_PUSH=off
if [ "$ALLOW_GITHUB_PUSH_FLAG" = 1 ]; then
    DEJIMA_GITHUB_PUSH=on
elif [ "$(manifest_get forge "$DEJIMA_FORGE_NAME" hosts_allowlisted_by_core)" = "on" ] \
     && [ "$(manifest_get workflow "$DEJIMA_WORKFLOW_NAME" push)" = "on" ]; then
    DEJIMA_GITHUB_PUSH=on
fi
export DEJIMA_GITHUB_PUSH

# Resolved here, ahead of --print-briefing below, because briefing_compose
# needs DEJIMA_RW_MOUNTS (the {{writable_mounts}} placeholder) to render the
# same sentence a real launch renders - the read_write mounts block further
# down only turns this already-validated list into -v flags rather than
# re-deriving it. WORKSPACE_DIR,
# AUDIT_DIR, BASELINE_DIR and SANDBOX_EXTRA_MOUNTS are pure config reads (or,
# for WORKSPACE_DIR, a default-to-pwd with an existence check) - no side
# effects a print-and-exit needs to avoid.
WORKSPACE_DIR="${1:-$(pwd)}"
if [ ! -d "$WORKSPACE_DIR" ]; then
    echo "Not a directory: $WORKSPACE_DIR" >&2
    exit 1
fi
shift || true

if [ "${1:-}" = "--" ]; then
    shift
fi

WORKSPACE_DIR="$(cd "$WORKSPACE_DIR" && pwd)"

# Resolved here, with the workspace, rather than beside the other approval
# reads further down: --print-briefing composes and exits well before those,
# so a briefing printed for inspection would have silently lacked whatever
# they decide. That is not hypothetical - the same ordering already caught
# DEJIMA_RW_MOUNTS, whose sentence went missing from --print-briefing while
# real sessions were told correctly.
PROJECT_STORE="$(resolve_project_store "$WORKSPACE_DIR")"

# Whether this project has been approved to keep its history as evidence, and
# so gets the commit-granularity paragraph in its briefing.
#
# Read from the APPROVAL STORE, never from the declaration in the workspace.
# The workspace is session-writable, so a session that could turn this on
# would be writing the next session's system prompt - the channel #104 is
# about, and the reason nothing on the launch path reads a project's
# declarations directly. The project declares, the operator approves, and this
# reads what was approved. A static test holds that this file never names that
# directory at all, which is why it is not spelled out here. Global entries
# count too, for an operator who wants this everywhere.
DEJIMA_CORPUS=off
_corpus_approved="$(approved_entries "$(config_root)" corpus | tr '\n' ' ')"
if [ -n "$PROJECT_STORE" ]; then
    _corpus_approved="$_corpus_approved $(approved_entries "$PROJECT_STORE" corpus | tr '\n' ' ')"
fi
case " $_corpus_approved " in
    *" commit-per-step "*) DEJIMA_CORPUS=on ;;
esac
unset _corpus_approved


AUDIT_DIR="$(config_get audit dir)"
BASELINE_DIR="$(config_get audit baselines_dir)"
SANDBOX_EXTRA_MOUNTS="$(config_get mounts readonly)"
SANDBOX_EXTRA_MOUNTS="$(_append_mounts "$SANDBOX_EXTRA_MOUNTS" \
    ${EXTRA_RO_FLAGS[@]+"${EXTRA_RO_FLAGS[@]}"})"

# Read-write host mounts. Distinct from [core] share_dir, which is mounted at
# ~/shared - a well-known handoff point the agent is told about by name -
# while these are mounted at their own absolute path, so a path that works on
# the host works unchanged inside.
#
# A writable mount is a host-persistence surface, so it may not overlap the
# surfaces the rest of this repo exists to protect. Refused, not warned:
# warn_if_inside_workspace below only warns because it reports an
# ENVIRONMENTAL condition an operator may have reached indirectly (an
# XDG_DATA_HOME pointing somewhere surprising). This is a deliberate line in a
# hand-edited config with an obvious alternative, so refusing costs nothing
# and removes the "saw the warning, continued anyway" path.

# The stores that decide what a session may do next, and the record of what
# it did. Read-only is not enough to make mounting them harmless: the
# approval store discloses every project's approved domains and
# dependencies, and the audit baselines say which findings have already been
# waved through. Refusing beats mounting and hoping the mode holds (#15).
#
# The epitaph store is here for the same reason and a sharper one: it holds
# each earlier session's own account of what it worked out, and a session
# that can read those can read what every previous session in this project
# concluded. Never mounting it is the entire design, and a static test
# checks that nothing here mounts it - but that test cannot see a path an
# operator names in [mounts] readonly, which is computed at run time. Listed
# whatever [epitaph] enabled says: turning the feature off stops new
# epitaphs being written, it does not empty the store.
GUARDED_STORES=()
_guarded_stores() {
    [ ${#GUARDED_STORES[@]} -eq 0 ] || return 0
    GUARDED_STORES=("$(config_root)" "$AUDIT_DIR" "$BASELINE_DIR" \
                    "$(config_get epitaph dir)")
}

# Refuse $2 if it overlaps any of the paths in $3.., in either direction: an
# ancestor of a store exposes it just as surely as the store itself.
_refuse_guarded_mount() {
    local kind="$1" path="$2"; shift 2
    local real guarded guarded_real
    # readlink -m rather than -f, same reason as the read_write guard below:
    # -f gives nothing for a path that does not exist yet, and an empty
    # result compares equal to nothing and would sail through.
    real="$(readlink -m "$path")"
    for guarded in "$@"; do
        [ -n "$guarded" ] || continue
        guarded_real="$(readlink -m "$guarded")"
        _paths_overlap "$real" "$guarded_real" || continue
        echo "Refusing $kind: $path" >&2
        echo "It overlaps $guarded_real, which dejima needs out of a session's reach." >&2
        echo "Even read-only, that hands the session every project's approvals or the" >&2
        echo "record of what earlier sessions were caught doing." >&2
        exit 1
    done
}
SANDBOX_RW_MOUNTS="$(config_get mounts read_write)"
SANDBOX_RW_MOUNTS="$(_append_mounts "$SANDBOX_RW_MOUNTS" \
    ${EXTRA_RW_FLAGS[@]+"${EXTRA_RW_FLAGS[@]}"})"
RW_MOUNT_PATHS=()
DEJIMA_RW_MOUNTS=""
if [ -n "$SANDBOX_RW_MOUNTS" ]; then
    IFS=':' read -ra rw_paths <<< "$SANDBOX_RW_MOUNTS"
    for path in "${rw_paths[@]}"; do
        [ -n "$path" ] || continue
        if [ ! -d "$path" ]; then
            echo "$(_mount_label "$path" "[mounts] read_write entry" "--extra-read-write path") is not an existing directory: $path" >&2
            exit 1
        fi
        # readlink -m, not -f: -f yields nothing unless at most the final
        # component is missing, and a guarded path that does not exist YET is
        # exactly the one worth refusing. An empty result would otherwise be
        # skipped, so an operator whose [audit] dir sits two levels below a
        # directory nothing has created could mount a writable ancestor of the
        # store dejima-audit is about to write findings into. -m also folds
        # away trailing slashes and "."/".." components, so the comparisons
        # below are between canonical paths rather than whatever spelling the
        # config happened to use.
        rw_real="$(readlink -m "$path")"
        # The shared list plus this path's own extras, rather than a second
        # copy of the stores: the two lists having drifted is what let the
        # epitaph store be mountable from here after it was added to one of
        # them. A store added to _guarded_stores is now guarded on both
        # paths without anyone remembering to do it twice.
        _guarded_stores
        for guarded in ${GUARDED_STORES[@]+"${GUARDED_STORES[@]}"} \
            "$HOME/.claude" "$HOME/.local/bin" "$REPO_ROOT" "$WORKSPACE_DIR"; do
            guarded_real="$(readlink -m "$guarded")"
            _paths_overlap "$rw_real" "$guarded_real" || continue
            echo "Refusing $(_mount_label "$path" "[mounts] read_write entry" "--extra-read-write path"): $path" >&2
            echo "It overlaps $guarded_real, which dejima needs out of a session's reach." >&2
            echo "A writable mount there would let a session approve its own domains and" >&2
            echo "dependencies, delete the audit findings it is named in, or plant code" >&2
            echo "that runs unsandboxed on the host the next time you start an agent." >&2
            exit 1
        done
        # A path in both lists would be resolved by whichever mount Docker
        # applies last, which is not something to decide by ordering. Compared
        # canonically rather than as config text: "$d" and "$d/" are the same
        # directory, and a raw string match would pass them both through and
        # emit two -v flags for it, leaving the read-only one to win or lose
        # by accident.
        if [ -n "$SANDBOX_EXTRA_MOUNTS" ]; then
            IFS=':' read -ra ro_paths <<< "$SANDBOX_EXTRA_MOUNTS"
            for ro_path in "${ro_paths[@]}"; do
                [ -n "$ro_path" ] || continue
                [ "$(readlink -m "$ro_path")" = "$rw_real" ] || continue
                echo "[mounts] read_write and [mounts] readonly both name the same" >&2
                echo "directory: $path and $ro_path both resolve to $rw_real." >&2
                exit 1
            done
        fi
        RW_MOUNT_PATHS+=("$path")
        DEJIMA_RW_MOUNTS="${DEJIMA_RW_MOUNTS:+$DEJIMA_RW_MOUNTS }$path"
    done
fi

# --print-briefing composes and exits, the same way --print-config does -
# before anything is built or mounted, and before a workspace argument is
# required. It exists so the composed briefing can be inspected (and, per
# test/providers.bats's parity check, diffed against the pre-composition
# text) without booting a container. Composing after DEJIMA_RW_MOUNTS above,
# rather than before it, is what makes that inspection trustworthy:
# briefing_compose reads DEJIMA_RW_MOUNTS to resolve {{writable_mounts}}, so
# composing any earlier would silently print a briefing missing that
# sentence whenever an operator has a read_write mount configured - exactly
# the gap this ordering exists to close.
if [ "$PRINT_BRIEFING" = 1 ]; then
    briefing_compose "$DEJIMA_FORGE_NAME" "$DEJIMA_WORKFLOW_NAME" "$DEJIMA_HARNESS_NAME" || exit 1
    exit 0
fi

if ! _forge_all_hosts="$(forge_hosts "$DEJIMA_FORGE_NAME")"; then
    exit 1
fi
DEJIMA_WORKFLOW_PUSH="$(manifest_get workflow "$DEJIMA_WORKFLOW_NAME" push)"
# A forge declaring hosts_allowlisted_by_core says its hosts are ones core
# already allowlists in its own right - the GitHub ranges every session can
# read from over 443. Those must NOT reach DEJIMA_FORGE_HOSTS, which
# entrypoint.sh folds into EXTRA_ALLOWED_DOMAINS: that path resolves a name
# into the port-UNRESTRICTED allowed-domains ipset and exempts it from
# dnsmasq's stop-dns-rebind, both of which are deliberate for an internal,
# self-hosted forge host and both of which are a widening for a public one.
# It would also make init-firewall.sh's startup self-check ("port 22 was
# reachable without the push grant") fail, killing the container outright.
#
# They still reach DEJIMA_PUSH_HOSTS: git-push-guard.sh's allowlist is a
# separate question from which names the firewall resolves, and a push to a
# host the guard doesn't know is refused inside the container regardless of
# how the packets would have been routed.
ALLOW_CORE_PUSH_GRANT="$ALLOW_GITHUB_PUSH_FLAG"
if [ "$(manifest_get forge "$DEJIMA_FORGE_NAME" hosts_allowlisted_by_core)" = "on" ]; then
    DEJIMA_FORGE_HOSTS=""
    # And pushing to them therefore goes through core's own push grant
    # (ALLOW_GITHUB_PUSH below), which opens port 22 to the same ranges the
    # read-only path already allows on 443 - logged, self-checked, and the
    # documented way that port opens. Only when the workflow actually pushes:
    # a non-pushing workflow has no reason to open it.
    if [ "$DEJIMA_WORKFLOW_PUSH" = "on" ]; then
        ALLOW_CORE_PUSH_GRANT=1
    fi
else
    DEJIMA_FORGE_HOSTS="$_forge_all_hosts"
fi
if [ "$DEJIMA_WORKFLOW_PUSH" = "on" ]; then
    DEJIMA_PUSH_HOSTS="$_forge_all_hosts"
else
    DEJIMA_PUSH_HOSTS=""
fi
# --allow-github-push's actual effect: git-push-guard.sh only ever checks
# DEJIMA_PUSH_HOSTS, so granting it a github.com push means adding these
# hosts to that list, not just exporting ALLOW_GITHUB_PUSH - that variable
# reaches only init-firewall.sh's port-22 grant and its startup self-check,
# never the guard. Keyed to the
# flag alone, not to ALLOW_CORE_PUSH_GRANT: a forge whose own hosts these
# are has already contributed them above, and adding them twice would leave
# the guard's list carrying each name two or three times over.
if [ "$ALLOW_GITHUB_PUSH_FLAG" = 1 ]; then
    DEJIMA_PUSH_HOSTS="${DEJIMA_PUSH_HOSTS:+$DEJIMA_PUSH_HOSTS }github.com ssh.github.com"
fi
DEJIMA_BLOCKED_BRANCHES="$(manifest_get workflow "$DEJIMA_WORKFLOW_NAME" blocked_branches)"
if [ "$(manifest_get workflow "$DEJIMA_WORKFLOW_NAME" block_merge)" = "on" ]; then
    DEJIMA_MERGE_BLOCK="$(manifest_get forge "$DEJIMA_FORGE_NAME" merge_block)"
else
    DEJIMA_MERGE_BLOCK=""
fi

# Which of this forge's commands write a body the session authored, as one
# record per line for the shadow to read: "<kind> <command prefix>".
#
# Not conditional on the workflow, unlike the merge block above. A merge block
# is a policy about what a workflow permits; this is a statement about who
# wrote the text, which is true of every session whatever it is allowed to do.
# The comma-separated manifest form is turned into lines here rather than in
# the shadow, so the parsing sits next to the schema that validates it.
DEJIMA_DISCLOSE=""
_disclose_spec="$(manifest_get forge "$DEJIMA_FORGE_NAME" disclose)"
if [ -n "$_disclose_spec" ]; then
    _old_ifs="$IFS"
    IFS=,
    for _entry in $_disclose_spec; do
        _entry="${_entry#"${_entry%%[![:space:]]*}"}"
        _entry="${_entry%"${_entry##*[![:space:]]}"}"
        [ -n "$_entry" ] || continue
        DEJIMA_DISCLOSE="${DEJIMA_DISCLOSE}${DEJIMA_DISCLOSE:+$'\n'}${_entry%%:*} ${_entry#*:}"
    done
    IFS="$_old_ifs"
fi

# WORKSPACE_DIR is resolved above, ahead of --print-briefing, since
# briefing_compose needs DEJIMA_RW_MOUNTS (which needs WORKSPACE_DIR for its
# own overlap guard) before that point.
#
# Allowed domains come only from the host-side approval store (see
# bin/dejima-project-lib.sh), global then per-project. The first
# assignment below is plain, not ${ALLOWED_DOMAINS:-}-preserving: the store
# is the single host-side source of truth, and an exported ALLOWED_DOMAINS
# in the user's shell profile must not be able to silently widen every
# sandbox's firewall with nothing recording that it did.
#
# Per-project domains are read from the approval store only - deliberately
# NOT from the project's own in-repo declaration directory: that lives on
# the read-write workspace mount, so treating it as a grant would let a
# session widen its own firewall for the next run. The declaration is only
# ever reported (see hooks/sandbox-context.sh) and approved by hand.
ALLOWED_DOMAINS="$(approved_entries "$(config_root)" allowed-domains | tr '\n' ' ')"
if [ -n "$PROJECT_STORE" ]; then
    project_domains="$(approved_entries "$PROJECT_STORE" allowed-domains | tr '\n' ' ')"
    ALLOWED_DOMAINS="${ALLOWED_DOMAINS}${project_domains:+ $project_domains}"
fi


# The approval store, and the exit-audit's own report/baseline stores, are
# only out of the container's reach while none of them are inside the
# mounted workspace - same class of warning as the self-mounted repo TCB
# warning below. AUDIT_DIR/BASELINE_DIR are resolved above, ahead of
# --print-briefing, since the read_write mounts guard needs them too.
# The three stores fail in three different ways once they are reachable, and
# an operator who sees this needs to know which one they are looking at - so
# each states its own consequence rather than sharing one text. Consequence
# lines are hand-wrapped by the caller and printed one per argument.
warn_if_inside_workspace() {
    local what="$1" store="$2"; shift 2
    case "$store/" in
        "$WORKSPACE_DIR"/*) ;;
        *) return 0 ;;
    esac
    echo "Warning: the $what ($store) is inside the mounted" >&2
    echo "workspace this session, writable from inside the sandbox:" >&2
    printf '  %s\n' "$@" >&2
    echo "Review it after this session." >&2
}
warn_if_inside_workspace "approval store" "$(config_root)" \
    "the global approvals and every project's under it can be edited," \
    "so a session can approve its own domains and dependencies - and the" \
    "config file lives here too, so it can flip core.firewall off, add" \
    "mounts.readonly entries of its own choosing, rewrite any token_file," \
    "or turn remote-access.enabled on."
warn_if_inside_workspace "audit report store" "$AUDIT_DIR" \
    "a session can delete the exit-time reports of earlier runs," \
    "including unacknowledged CRITICAL ones it is named in."
warn_if_inside_workspace "audit baseline store" "$BASELINE_DIR" \
    "a session can write its own acknowledgements, suppressing the" \
    "findings it would otherwise produce here from every later report."

SANDBOX_SSH_KEY="$(config_get core ssh_key)"
if [ -n "$SANDBOX_SSH_KEY" ] && [ ! -f "$SANDBOX_SSH_KEY" ]; then
    echo "[core] ssh_key is set but not a file: $SANDBOX_SSH_KEY" >&2
    exit 1
fi
if [ -n "$SANDBOX_SSH_KEY" ]; then
    key_perms=$(stat -c '%a' "$SANDBOX_SSH_KEY")
    if [ "${key_perms: -2}" != "00" ]; then
        echo "Warning: $SANDBOX_SSH_KEY is readable by group/other (mode $key_perms)." >&2
        echo "Recommended: chmod 600 $SANDBOX_SSH_KEY" >&2
    fi
    # SANDBOX_SSH_KEY is meant to be a dedicated, low-privilege deploy key
    # (see docs/configuration.md "Headless git push"), not your real identity - it stays
    # loaded in an in-container agent for the whole session, unattended.
    # Nothing enforces that convention, so at least catch the common case
    # of pointing it at a default personal keyfile by mistake.
    case "$(basename -- "$SANDBOX_SSH_KEY")" in
        id_rsa|id_ecdsa|id_ed25519|id_dsa|id_ecdsa_sk|id_ed25519_sk)
            echo "Warning: $SANDBOX_SSH_KEY looks like a default personal SSH key," \
                 "not a dedicated one." >&2
            echo "It will be loaded into the sandbox for the whole unattended session -" \
                 "see docs/configuration.md." >&2
            ;;
    esac
fi

have_forwarded_agent=1
if [ -z "${SSH_AUTH_SOCK:-}" ] || [ ! -S "${SSH_AUTH_SOCK}" ]; then
    have_forwarded_agent=0
fi

# Rule 4: a workflow that never pushes has no use for either - skip the
# requirement entirely rather than force an operator doing local-only work
# to set up an agent or a deploy key for nothing.
if [ "$DEJIMA_WORKFLOW_PUSH" = "on" ] && [ "$have_forwarded_agent" = 0 ] && [ -z "$SANDBOX_SSH_KEY" ]; then
    echo "SSH_AUTH_SOCK is not set or not a valid socket, and [core] ssh_key is not set." >&2
    echo "Either start ssh-agent and run ssh-add, or set [core] ssh_key in $(config_path) to a" >&2
    echo "dedicated key for headless use - see docs/configuration.md." >&2
    exit 1
fi

# A valid forwarded socket with zero identities loaded forwards fine (the
# container sees a live, working agent) but is useless for git-over-ssh -
# warn now rather than have that surface confusingly deep into a session as
# a failed push. Non-fatal: a task might not need git-over-ssh at all.
#
# Silent when [core] ssh_key is set, because then the premise is false: the
# key is loaded into the container's own agent and pushes work without the
# forwarded one carrying anything. It is also the better arrangement of the
# two - a dedicated identity that works unattended, rather than the
# operator's own - so warning about the fallback being empty, while the
# recommended path is configured and working, tells someone who took the
# advice that they got it wrong.
if [ "$have_forwarded_agent" = 1 ] && [ -z "$SANDBOX_SSH_KEY" ] \
   && ! ssh-add -l >/dev/null 2>&1; then
    echo "Warning: ssh-agent has no identities loaded (ssh-add -l shows none)." >&2
    echo "git-over-ssh (e.g. pushing to the configured forge) will fail until you ssh-add a key," >&2
    echo "or set [core] ssh_key in $(config_path) to a dedicated key - see docs/configuration.md." >&2
fi

# Deliberately not `gh auth token` / gh's own hosts.yml: a normal `gh
# auth login` session is write-capable, which would defeat the point.
# This should be a dedicated read-only fine-grained PAT (Contents +
# Metadata: read-only), generated separately for this sandbox.
# Plain assignment: stays empty (never inherited from the shell) when
# GH_TOKEN_FILE doesn't exist, the same "start from empty, not from
# whatever's already exported" reasoning forge_env_exports applies to a
# forge's own token further down.
GH_TOKEN=""
GH_TOKEN_FILE="$(config_get github token_file)"
if [ -f "$GH_TOKEN_FILE" ]; then
    GH_TOKEN="$(<"$GH_TOKEN_FILE")"
fi

# Read-write scratch space, separate from WORKSPACE_DIR, for passing files
# (screenshots, temp scripts) back and forth with a sandboxed session without
# touching the actual project checkout. Persists across sessions (it's a
# real host directory, not a container volume) since the point is sharing
# things with the host, not just scratch space for one run.
SANDBOX_SHARE_DIR="$(config_get core share_dir)"
mkdir -p "$SANDBOX_SHARE_DIR"

# ~/.claude is not mounted as a whole (see the mount inventory in
# docker-compose.yml) - every path that crosses into the container is named
# individually, and Docker answers a missing bind source by creating a
# root-owned *directory* at it. That would leave junk on the host and, for
# the read-only config dirs, a writable gap instead of an overlay. Pre-create
# them all: empty is fine, existence is what matters.
# Which directories those are is the harness's (harness_config_dirs); that
# they must exist before the mount is set up is dejima's.
harness_config_dirs_load
for _rec in ${DEJIMA_CONFIG_DIRS[@]+"${DEJIMA_CONFIG_DIRS[@]}"}; do
    IFS=$'\t' read -r _cdir _cmode _cscan <<< "$_rec"
    mkdir -p "$_cdir"
done

# The override layer the sandbox imposes on the harness's own settings, and
# any config file the harness needs to exist before it is staged.
#
# What that layer says, which files must exist, and what makes one unusable
# are the harness's - a settings schema is exactly the harness-shaped thing a
# manifest cannot carry, since it is a parser's grammar rather than a value.
# What is dejima's: that the layer is a throwaway file the session cannot
# reach, that it is mounted at a container-local path and NEVER over the
# harness's own settings file - a mount at the real path detaches when the
# host renames over the file, silently restoring the operator's settings with
# sandboxing back on (#47) - and that a plugin refusing here stops the launch
# rather than starting a session the harness would misread.
SANDBOX_SETTINGS_FILE="$(mktemp "${TMPDIR:-/tmp}/dejima-settings.XXXXXX.json")"
harness_hook harness_prepare_config "$SANDBOX_SETTINGS_FILE" || exit 1

# ~/.claude.json mixes live app state with config (mcpServers) that cannot be
# split at the mount level, and read-only is not an option: Claude Code does
# an atomic write-and-rename against it during startup, and a read-only file
# makes that HANG rather than fail cleanly (anthropics/claude-code#29162).
# So it gets a throwaway copy, seeded from the real file and discarded rather
# than merged back - nothing a session writes here reaches the host, and
# concurrent sessions never contend. See docs/configuration.md, "Config
# parity with your host Claude Code setup".
SANDBOX_CLAUDE_JSON_FILE="$(mktemp "${TMPDIR:-/tmp}/dejima-claude-json.XXXXXX.json")"
if [ -f "$HOME/.claude.json" ]; then
    cp "$HOME/.claude.json" "$SANDBOX_CLAUDE_JSON_FILE"
else
    echo '{}' > "$SANDBOX_CLAUDE_JSON_FILE"
fi

SANDBOX_AUDIT_STATE="$(mktemp "${TMPDIR:-/tmp}/dejima-audit.XXXXXX")"

# Initialized here, before the trap below is installed, so cleanup() never
# observes a nonempty value it didn't itself set - e.g. an operator's
# environment happening to export a variable of one of these exact names.
# With remote access off (or on an early exit before the remote-access block
# below ever runs), `rm -rf "$DEJIMA_NOTIFY_DIR"` against an inherited value
# would be a data loss bug, not just a no-op - and several `exit 1` paths
# between here and that block would otherwise fire the trap while these
# still held whatever came in from the environment (same class of concern as
# the credential-proxy variables further down, pre-initialized the same way,
# just earlier here since the trap is installed sooner). Every name cleanup()
# removes but does not itself create belongs here, not just the remote-access
# ones: the three below are assigned only inside conditional blocks (an nvim
# config being present, dependencies being approved), so an ordinary run with
# neither would otherwise carry an inherited value all the way to the trap -
# and SANDBOX_DERIVED_CONTEXT is one of the `rm -rf` arguments.
DEJIMA_NOTIFY_DIR=""
DEJIMA_SESSION_FILE=""
SANDBOX_NVIM_LOCKFILE=""
SANDBOX_DERIVED_DOCKERFILE=""
SANDBOX_DERIVED_CONTEXT=""
SANDBOX_CONVERSATION_SHIP_PID=""
SANDBOX_TTY_SUSPEND_PID=""
SANDBOX_TTY_MODES=""
SANDBOX_CLIENT_PID=""

# Names each host-side task in cleanup() as it starts. Between the container
# exiting and the operator's shell prompt returning, dejima audits every
# surface the session could have written to and reads back the transcripts it
# left; on a real project that is seconds of nothing on screen, and a
# terminal that prints nothing reads as one that has hung. The remedy an
# operator reaches for then is Ctrl-C, which is precisely when the audit
# must not be interrupted.
#
# Only once a snapshot exists, which is the same condition `dejima-audit
# compare` uses to decide it has anything to do: an exit before the session
# ever started is instant, and its last line is the error that caused it -
# announcing work that is not happening would push that off the screen.
#
# stderr, like everything else this trap prints, and host-side only: none of
# it is ever routed back into a session's context.
exit_step() {
    # `return 0` rather than letting the test be the last command: a nonzero
    # status from anything in an EXIT trap replaces the script's own.
    [ -s "${SANDBOX_AUDIT_STATE:-}" ] && printf 'dejima: %s...\n' "$1" >&2
    return 0
}

cleanup() {
    # Every rm below is guarded with `|| true`: under set -e, a failing
    # command in an EXIT trap replaces the shell's own exit status, so none
    # of these may be allowed to abort the trap partway through. Most of
    # these paths are host-mktemp'd and not session-writable, so a genuine
    # failure there would be surprising - but SANDBOX_GITCONFIG_DIR is not:
    # it's bind-mounted read-write into the container (see
    # docker-compose.yml), so a session can leave an undeletable entry
    # inside it (e.g. an unwritable subdirectory) and make its `rm -rf`
    # fail, same hazard and same guard as the marker-directory removal
    # further down.
    #
    # SANDBOX_GITCONFIG_DIR additionally carries a `:-` default because it is
    # the one name here first assigned BELOW `trap cleanup EXIT` rather than
    # above it. Nothing in that window can exit today (it holds only
    # comments, and a failed `VAR="$(mktemp -d)"` still binds VAR to the
    # empty string before set -e fires), so this is the invariant every other
    # name here already keeps, not a live fix - see the static test.
    # SIGTERM, which the shipper traps: it scans once more and flushes before
    # exiting, so the tail of the session - the part worth having - is shipped
    # rather than dying with the batch. Reaped for the same reason the proxy
    # is: an unreaped child reparents to PID 1 and stays a zombie wherever
    # PID 1 does not reap.
    # The terminal first, and its settings before their watcher: the
    # container run restores what it saved when it attached, but a run that
    # was killed rather than exited restores nothing, and what that leaves
    # behind is a terminal with no interrupt character.
    if [ -n "${SANDBOX_TTY_MODES:-}" ]; then
        stty "$SANDBOX_TTY_MODES" < /dev/tty 2>/dev/null || true
    fi
    if [ -n "${SANDBOX_TTY_SUSPEND_PID:-}" ]; then
        kill "$SANDBOX_TTY_SUSPEND_PID" 2>/dev/null || true
        wait "$SANDBOX_TTY_SUSPEND_PID" 2>/dev/null || true
    fi
    if [ -n "${SANDBOX_CONVERSATION_SHIP_PID:-}" ]; then
        kill "$SANDBOX_CONVERSATION_SHIP_PID" 2>/dev/null || true
        wait "$SANDBOX_CONVERSATION_SHIP_PID" 2>/dev/null || true
    fi
    if [ -n "${SANDBOX_ANTHROPIC_PROXY_PID:-}" ]; then
        kill "$SANDBOX_ANTHROPIC_PROXY_PID" 2>/dev/null || true
        # Reaped, not just signalled. Without this the proxy stays a zombie
        # child until dejima itself exits, at which point it reparents to
        # PID 1 - and where PID 1 does not reap (a CI job container whose
        # PID 1 is `sleep`, rather than the `init: true` dejima gives its
        # own containers) it stays a zombie for the life of that container,
        # holding a PID. One per launch is invisible interactively and
        # accumulates in a test suite that launches hundreds of times.
        wait "$SANDBOX_ANTHROPIC_PROXY_PID" 2>/dev/null || true
    fi
    rm -f "$SANDBOX_SETTINGS_FILE" "$SANDBOX_CLAUDE_JSON_FILE" "${SANDBOX_NVIM_LOCKFILE:-}" "${SANDBOX_FAKE_CREDENTIALS_FILE:-}" "${SANDBOX_DERIVED_DOCKERFILE:-}" "${SANDBOX_BRIEFING_FILE:-}" || true
    rm -rf "${SANDBOX_GITCONFIG_DIR:-}" "${SANDBOX_ANTHROPIC_PROXY_DIR:-}" "${SANDBOX_DERIVED_CONTEXT:-}" || true
    rm -f "${DEJIMA_SESSION_FILE:-}" || true
    # dejima-notify-watch keys its debounce stamps by run id. Removed here,
    # with the registry entry, because this is the only exit both of them are
    # guaranteed to reach: dejima-attach's prune also removes them, but that
    # branch needs a registry entry still present for a container that is
    # gone, which a normal exit has just made impossible. Unguarded, unlike
    # the marker directory below: the debounce directory is host-owned and
    # never mounted into a sandbox.
    if [ -n "${DEJIMA_RUN_ID:-}" ] && [ -n "${DEJIMA_STATE_DIR:-}" ]; then
        rm -f "$DEJIMA_STATE_DIR/debounce/$DEJIMA_RUN_ID-waiting" \
              "$DEJIMA_STATE_DIR/debounce/$DEJIMA_RUN_ID-done" || true
    fi
    # Unlike the silent `|| true` guards above, this removal (and, before
    # the audit below was moved in, the last command of an EXIT trap) warns
    # out loud when it fails: the marker directory is bind-mounted
    # read-write, so a session can leave it undeletable (an unwritable
    # subdirectory is enough), and under set -e a failing command in an EXIT
    # trap REPLACES the shell's exit status - so without this a compromised
    # session could report 1 in place of Claude Code's real exit code. Same
    # guard, for the same reason, as dejima-attach's prune and
    # dejima-notify-watch's marker consumption.
    rm -rf "${DEJIMA_NOTIFY_DIR:-}" \
        || echo "warning: could not remove the marker directory ${DEJIMA_NOTIFY_DIR:-}" >&2
    exit_step "session ended - keeping what it compacted away"
    # Keep whatever the session compacted away, into a store nothing mounts.
    # `|| true` for the same reason every other line in this trap has it: a
    # failure here must not replace the container's exit status.
    #
    # Ahead of the audit rather than after it, so the audit keeps the last
    # word (see below): this prints a line of its own whenever it keeps
    # something, and that line was landing under the verdict.
    "$SCRIPT_DIR/dejima-epitaph" save "$WORKSPACE_DIR" || true
    # Last writer, structurally: the operator reads bottom-up from their
    # shell prompt, so anything printed after the verdict pushes it out of
    # view. The marker-directory warning above is the one line a session can
    # deliberately provoke, so the audit runs after it, not before - and gets
    # the same set -e guard for the same reason: a failing audit invocation
    # must not replace Claude Code's real exit status either. SANDBOX_AUDIT_
    # STATE is dropped from the rm -f above and freed only after compare has
    # read it, so this function's own cleanup can't race the audit that
    # needs it - and its removal is guarded too, so it stays truly last.
    exit_step "checking what changed on the host while it ran"
    DEJIMA_RW_MOUNTS="$DEJIMA_RW_MOUNTS" "$SCRIPT_DIR/dejima-audit" compare "$WORKSPACE_DIR" "$SANDBOX_AUDIT_STATE" || true
    rm -f "$SANDBOX_AUDIT_STATE" || true
}
trap cleanup EXIT

# Git commits inside the sandbox need a user.name/user.email - carry over a
# copy of the host's global gitconfig, read-write: entrypoint.sh's
# `gh auth setup-git` (what makes GitHub read-only from in here - see
# README) needs to *write* a credential-helper entry into it.
#
# A whole directory, not a single file bind-mounted at ~/.gitconfig: `git
# config` writes via the usual write-temp-then-rename-over-original pattern,
# which fails with "Device or resource busy" on a single-file bind mount -
# Linux won't let that mount point's backing inode be replaced, only a file
# *within* a mounted directory can be freely renamed over. Point git at the
# copy via GIT_CONFIG_GLOBAL instead of relying on it being at ~/.gitconfig.
# Nothing written in here ever reaches the user's real ~/.gitconfig either
# way, since it's a copy in its own directory, not the real file/parent.
SANDBOX_GITCONFIG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/dejima-gitconfig.XXXXXX")"
if [ -f "$HOME/.gitconfig" ]; then
    cp "$HOME/.gitconfig" "$SANDBOX_GITCONFIG_DIR/.gitconfig"
else
    touch "$SANDBOX_GITCONFIG_DIR/.gitconfig"
fi

export WORKSPACE_DIR
# The image's user is built to match this uid/gid/username exactly (see
# Dockerfile) - this is what makes $HOME-based absolute paths (dotfiles,
# ~/.claude's plugin bookkeeping) resolve identically inside the container.
# Assigned before export, not `export X="$(...)"`: export always succeeds,
# so the combined form returns the export's status and set -e never sees a
# failing substitution. Split, a failure here stops the launch.
SANDBOX_USER="$(id -un)"; export SANDBOX_USER
SANDBOX_UID="$(id -u)"; export SANDBOX_UID
SANDBOX_GID="$(id -g)"; export SANDBOX_GID
export SANDBOX_SHARE_DIR
export SANDBOX_SETTINGS_FILE
export SANDBOX_CLAUDE_JSON_FILE
export SANDBOX_GITCONFIG_DIR
# Rule 4's other half: a workflow that never pushes gets no agent socket
# forwarded either - left empty here, docker-compose.yml's
# ${SSH_AUTH_SOCK:-/dev/null} mounts nothing.
[ "$DEJIMA_WORKFLOW_PUSH" = "on" ] || SSH_AUTH_SOCK=""
export SSH_AUTH_SOCK
export SANDBOX_SSH_KEY_FILE="$SANDBOX_SSH_KEY"
SSH_KNOWN_HOSTS="$(config_get core known_hosts)"; export SSH_KNOWN_HOSTS
export GH_TOKEN="${GH_TOKEN:-}"
export ALLOWED_DOMAINS="${ALLOWED_DOMAINS:-}"
# The --allow-github-push flag and a selected forge whose hosts_allowlisted_by_core
# says these are its own push hosts (see ALLOW_CORE_PUSH_GRANT above) are the
# only two ways to grant this - same principle as ALLOWED_DOMAINS above: this
# opens a push path, so an exported value already sitting in the operator's
# shell profile must not be able to silently grant it, with nothing recording
# that it did. Both ways in are recorded: one in the command that used the
# flag, the other in the config file that selected the forge.
if [ "$ALLOW_CORE_PUSH_GRANT" = 1 ]; then
    export ALLOW_GITHUB_PUSH=1
else
    # Plain assignment, not "${ALLOW_GITHUB_PUSH:-0}" - same reason
    # ALLOWED_DOMAINS above is plain. This opens a push path, so an exported
    # value in a shell profile must not be able to grant it silently.
    export ALLOW_GITHUB_PUSH=0
fi
export TZ="${TZ:-$(readlink -f /etc/localtime 2>/dev/null | sed 's#.*/zoneinfo/##')}"

# core.command permits a leading "-" (it is validated as a generic identifier,
# shared with other keys that have no such concern) but entrypoint.sh expands
# it unquoted into `gosu "$SANDBOX_USER" ${SANDBOX_CMD:-claude} "$@"` - a
# leading dash there would be parsed as an option to gosu, not as the command.
# Refuse here, at the point this value is wired in, rather than relax the
# schema type for every other identifier-typed key.
SANDBOX_CMD="$(config_get core command)"
case "$SANDBOX_CMD" in
    -*)
        echo "invalid value for core.command: must not start with '-': $SANDBOX_CMD" >&2
        exit 1
        ;;
esac
export SANDBOX_CMD

# What the wrapper inside the container needs to shadow the harness's binary
# and pin its flags, resolved here because the manifests are host-side data
# the container never sees. Every value is the selected harness's own; none
# of it is written down in the image.
#
# SANDBOX_HARNESS_COMMAND is the name to shadow, and is the manifest's rather
# than [core] command: overriding the latter to `nvim` changes what dejima
# launches, not which harness is wrapped, and an editor-driven session that
# then runs the harness from a terminal must still get the flags.
SANDBOX_HARNESS_COMMAND="$(manifest_get harness "$DEJIMA_HARNESS_NAME" command)"
SANDBOX_HARNESS_REAL="$(manifest_get harness "$DEJIMA_HARNESS_NAME" command_path)"
SANDBOX_HARNESS_ARGS="$(manifest_get harness "$DEJIMA_HARNESS_NAME" no_confirm_args)"
# Named in full rather than templated: the settings layer's container-side
# path is dejima's own fixed contract (docker-compose.yml mounts it there),
# not a value that varies per run, and {{...}} in a manifest belongs to the
# briefing composer's substitution rather than to a second mechanism that
# merely looks like it.
SANDBOX_HARNESS_SETTINGS="$(manifest_get harness "$DEJIMA_HARNESS_NAME" settings_args)"
# Refused here rather than as the wrapper's exit 127 inside a container that
# has already started.
if [ -z "$SANDBOX_HARNESS_REAL" ]; then
    echo "Harness '$DEJIMA_HARNESS_NAME' declares no command_path." >&2
    echo "Without it the wrapper has no binary to shadow." >&2
    exit 1
fi
# Unattended operation is R1 of the capability bar, and a harness whose
# manifest names no way to ask for it would run asking for confirmation on
# every tool call, against a container built on the premise that it does not.
# That fails silently and looks like the harness hanging, so refuse instead.
if [ -z "$SANDBOX_HARNESS_ARGS" ]; then
    echo "Harness '$DEJIMA_HARNESS_NAME' declares no no_confirm_args." >&2
    echo "dejima runs unattended; a harness that stops to ask cannot be run that" >&2
    echo "way. See \"What a harness must be able to do\" in docs/development.md." >&2
    exit 1
fi
# The names this harness's own machinery must reach. Its API endpoint and
# update host are as much a property of the harness as its command is, and
# they were built into the image's fixed list where a second harness would
# have inherited them and still lacked its own.
#
# They go into that fixed list rather than the extra-domains one, which is
# the distinction docker/fixed-domains.sh explains: the extra list is exempt
# from stop-dns-rebind and a failed lookup there is only a warning, both of
# which are wrong for a public SaaS name the session cannot work without.
#
# Manifest data reaching the firewall is the same arrangement a forge's
# fixed_hosts already has, and since #142 the provider directories are in
# the audit's TCB list, so widening this unseen is a CRITICAL finding.
SANDBOX_HARNESS_DOMAINS="$(manifest_get harness "$DEJIMA_HARNESS_NAME" api_domains)"
SANDBOX_HARNESS_PROXIED_DOMAIN="$(manifest_get harness "$DEJIMA_HARNESS_NAME" proxied_api_domain)"
# The two ways a briefing reaches a harness that is not handed it by a
# session-start hook. A hook cannot carry a large one: Claude Code persists a
# big payload to a file and injects a short preview in its place - measured in
# a dejima container, 9KB arrived whole and 21KB did not - and a composed
# briefing plus a project's .dejima.md is well past that.
#
# briefing_args names the flag that carries the text on the command line;
# briefing_path names a file the harness reads instead, for one that takes no
# such flag. A homepath in the manifest, so it is already relative and
# traversal-free before it gets here. See docs/providers.md.
SANDBOX_HARNESS_BRIEFING_ARGS="$(manifest_get harness "$DEJIMA_HARNESS_NAME" briefing_args)"
SANDBOX_HARNESS_BRIEFING_PATH="$(manifest_get harness "$DEJIMA_HARNESS_NAME" briefing_path)"
export SANDBOX_HARNESS_COMMAND SANDBOX_HARNESS_REAL SANDBOX_HARNESS_ARGS \
    SANDBOX_HARNESS_SETTINGS SANDBOX_HARNESS_DOMAINS \
    SANDBOX_HARNESS_PROXIED_DOMAIN SANDBOX_HARNESS_BRIEFING_ARGS \
    SANDBOX_HARNESS_BRIEFING_PATH

# [core] command defaults to the selected harness's own command rather than
# to a literal in core's schema.
[ -n "$SANDBOX_CMD" ] || SANDBOX_CMD="$SANDBOX_HARNESS_COMMAND"
export SANDBOX_CMD
# docker-compose.yml/entrypoint.sh compare these against "1"/"0", not
# "on"/"off" - config_get_bool is what produces that, config_get would pass
# "on"/"off" straight through and (among other things) silently disable the
# firewall by default.
ENABLE_FIREWALL="$(config_get_bool core firewall)"; export ENABLE_FIREWALL
LOKI_URL="$(config_get logging loki_url)"; export LOKI_URL

# ~/.claude/hooks may contain symlinks whose real targets live outside
# ~/.claude (this repo's own hooks/, and potentially others - e.g. dotfiles'
# config/claude/hooks/ for deny-dangerous-bash.sh, if that's what a given
# host has installed). docker-compose.yml names no repo's path for this -
# discover what's actually needed here instead, so it's
# correct regardless of what's installed or where this repo itself was
# cloned to.
# Only the directories that are actually mounted in: the top-level files
# (settings.json, CLAUDE.md, statusline.sh) are staged as copies instead, and
# Docker resolves any symlink among them when it sets up that staging mount,
# so their targets don't need to be reachable from inside at all. Scanning
# "." here too would mount a whole config checkout read-only into the
# container for nothing.
extra_mounts=()

# The forge's own env vars, generated from its manifest's env_export list
# rather than hardcoded - see forge_env_exports. -e here: passed straight
# through to `docker compose run`, which takes -e alongside -v.
_forge_env_lines=""
if ! _forge_env_lines="$(forge_env_exports "$DEJIMA_FORGE_NAME")"; then
    # forge_env_exports has already explained why on stderr. It can fail
    # partway, having printed some records, so nothing it produced can be
    # trusted - refuse rather than launch with a partial forge environment.
    exit 1
fi
while IFS= read -r _forge_env; do
    [ -n "$_forge_env" ] || continue
    extra_mounts+=(-e "$_forge_env")
done <<< "$_forge_env_lines"

# The resolved combination, for the briefing and the hooks that read it
# (git-push-guard.sh's host allowlist and no-direct-push branches,
# merge-guard.sh's block) - computed here, unconditionally passed through
# the same way, regardless of which forge and workflow are configured.
extra_mounts+=(-e "DEJIMA_FORGE_NAME=$DEJIMA_FORGE_NAME")
extra_mounts+=(-e "DEJIMA_WORKFLOW_NAME=$DEJIMA_WORKFLOW_NAME")
extra_mounts+=(-e "DEJIMA_HARNESS_NAME=$DEJIMA_HARNESS_NAME")
extra_mounts+=(-e "DEJIMA_FORGE_HOSTS=$DEJIMA_FORGE_HOSTS")
extra_mounts+=(-e "DEJIMA_PUSH_HOSTS=$DEJIMA_PUSH_HOSTS")
extra_mounts+=(-e "DEJIMA_BLOCKED_BRANCHES=$DEJIMA_BLOCKED_BRANCHES")
extra_mounts+=(-e "DEJIMA_MERGE_BLOCK=$DEJIMA_MERGE_BLOCK")
extra_mounts+=(-e "DEJIMA_DISCLOSE=$DEJIMA_DISCLOSE")

# The harness's own configuration, mounted at the mode it declared, and -
# for the directories it marked scannable - the symlink targets that have to
# come with it.
mounted_dirs=""
for _rec in ${DEJIMA_CONFIG_DIRS[@]+"${DEJIMA_CONFIG_DIRS[@]}"}; do
    IFS=$'\t' read -r dir mounted_mode mounted_scan <<< "$_rec"
    emit_mount "$dir" "$mounted_mode"
    [ "$mounted_scan" = scan ] || continue
    [ -d "$dir" ] || continue
    for entry in "$dir"/*; do
        [ -L "$entry" ] || continue
        # readlink -f fails (empty stdout) when an intermediate directory of
        # the symlink's target is itself missing, not just the final
        # component - skip rather than let `dirname ""` silently resolve to
        # "." and append a nonsensical (or worse, cwd-mounting) -v .:.:ro.
        target="$(readlink -f "$entry")" || continue
        [ -n "$target" ] || continue
        real_dir="$(dirname "$target")"
        # A target inside the directory being scanned, or beside it, is
        # already mounted by the loop itself.
        case "$real_dir" in
            "$(dirname "$dir")"*) continue ;;
        esac
        case " $mounted_dirs " in
            *" $real_dir "*) continue ;;
        esac
        # The target is discovered, not configured, so nothing has vetted it
        # (#15). A hook symlinked into the approval store would mount it
        # here, read-only and silently. Refusing rather than skipping: a
        # skipped mount leaves the symlink dangling inside the container and
        # the hook failing for a reason nothing states.
        _guarded_stores
        # The tilde is a label an operator reads, not a path to expand.
        # shellcheck disable=SC2088
        _refuse_guarded_mount "~/.claude symlink target" "$real_dir" "${GUARDED_STORES[@]}"
        mounted_dirs="$mounted_dirs $real_dir"
        extra_mounts+=(-v "$real_dir:$real_dir:ro")
    done
done

# Optional: bring in a real nvim config to pair with [core] command = nvim
# (see entrypoint.sh). Not baked into the image - this repo has no opinion on
# anyone's personal editor config.
SANDBOX_NVIM_CONFIG="$(config_get mounts nvim_config)"
if [ -n "$SANDBOX_NVIM_CONFIG" ]; then
    if [ ! -d "$SANDBOX_NVIM_CONFIG" ]; then
        echo "[mounts] nvim_config is set but not a directory: $SANDBOX_NVIM_CONFIG" >&2
        exit 1
    fi
    extra_mounts+=(-v "$SANDBOX_NVIM_CONFIG:$HOME/.config/nvim:ro")
    # lazy.nvim (and most other nvim plugin managers) writes its lockfile
    # back into the config directory on every plugin sync - a throwaway
    # copy, layered read-write on top of the read-only mount above (same
    # "more specific mount wins" trick the ~/.claude overlays use, just
    # inverted), keeps that working without making the rest of a personal
    # config writable from inside the sandbox. Not synced back: losing a
    # sandbox session's plugin-version bumps is low-stakes - the nvim-data
    # volume below already keeps the actual installed plugin files across
    # sessions - next to what a fully writable config directory would risk:
    # arbitrary Lua that runs unsandboxed the next time nvim starts for real.
    SANDBOX_NVIM_LOCKFILE="$(mktemp "${TMPDIR:-/tmp}/dejima-nvim-lock.XXXXXX.json")"
    if [ -f "$SANDBOX_NVIM_CONFIG/lazy-lock.json" ]; then
        cp "$SANDBOX_NVIM_CONFIG/lazy-lock.json" "$SANDBOX_NVIM_LOCKFILE"
    fi
    extra_mounts+=(-v "$SANDBOX_NVIM_LOCKFILE:$HOME/.config/nvim/lazy-lock.json")
fi

# Optional: extra host paths a personal setup references by absolute path
# outside anywhere already mounted above - e.g. a dotfiles bin/ directory
# an editor config shells out to. Colon-separated, like $PATH. Mounted
# read-only at their own path, same as everything else here - this repo
# still has no opinion on what's inside any of them. SANDBOX_EXTRA_MOUNTS
# itself is resolved above, ahead of --print-briefing (the read_write guard
# below needs it too) - only applying it as -v flags happens here.
if [ -n "$SANDBOX_EXTRA_MOUNTS" ]; then
    IFS=':' read -ra extra_paths <<< "$SANDBOX_EXTRA_MOUNTS"
    for path in "${extra_paths[@]}"; do
        [ -n "$path" ] || continue
        if [ ! -e "$path" ]; then
            echo "$(_mount_label "$path" "[mounts] readonly entry" "--extra-readonly path") does not exist: $path" >&2
            exit 1
        fi
        # [mounts] read_write has been guarded since it was added; this one
        # never was, so `readonly = ~/.config/dejima` mounted the approval
        # store into the container and nothing said a word (#15).
        _guarded_stores
        _refuse_guarded_mount "$(_mount_label "$path" "[mounts] readonly entry" "--extra-readonly path")" \
            "$path" "${GUARDED_STORES[@]}"
        extra_mounts+=(-v "$path:$path:ro")
    done
fi

# Read-write host mounts: validated and resolved into RW_MOUNT_PATHS and
# DEJIMA_RW_MOUNTS above, ahead of --print-briefing, so the briefing composed
# there and the briefing composed for a real launch read the same value.
# Nothing left to do here but turn the already-validated list into -v flags -
# re-validating would be a second place this could drift from the first.
# DEJIMA_RW_MOUNTS is deliberately not forwarded into the container as an
# environment variable: hooks/sandbox-context.sh does not read it (the
# writable-mounts sentence reaches the session through the composed briefing
# instead), so passing it would just be a value nothing inside consumes. It
# IS forwarded the other direction, host-side, to the exit-time dejima-audit
# invocation in cleanup() below - that report's header names these paths so
# an operator reading any finding knows what else the session could reach.
for path in ${RW_MOUNT_PATHS[@]+"${RW_MOUNT_PATHS[@]}"}; do
    extra_mounts+=(-v "$path:$path")
done

# The session briefing, composed host-side from the core text and the
# selected workflow/harness fragments (see briefing_compose) and mounted
# read-only, so a session can never rewrite its own next briefing. The two
# runtime placeholders it still carries (@@SESSION_ID@@, @@CONTAINER_ID@@)
# are hooks/sandbox-context.sh's job to fill in at SessionStart.
SANDBOX_BRIEFING_FILE="$(mktemp "${TMPDIR:-/tmp}/dejima-briefing.XXXXXX")"
if ! briefing_compose "$DEJIMA_FORGE_NAME" "$DEJIMA_WORKFLOW_NAME" "$DEJIMA_HARNESS_NAME" > "$SANDBOX_BRIEFING_FILE"; then
    exit 1
fi
extra_mounts+=(-v "$SANDBOX_BRIEFING_FILE:/etc/dejima/briefing:ro")
extra_mounts+=(-e "DEJIMA_BRIEFING_FILE=/etc/dejima/briefing")

# Block the workspace's own git hooks from being rewritten to run on the
# host at the next `git` invocation. Only when .git is a real directory - a
# worktree/submodule .git is a pointer file whose hooks live in the common
# git dir outside the mount (container-local, discarded with the session),
# so there's nothing host-persistent to protect there.
if [ -d "$WORKSPACE_DIR/.git/hooks" ]; then
    extra_mounts+=(-v "$WORKSPACE_DIR/.git/hooks:$WORKSPACE_DIR/.git/hooks:ro")
fi

# The state this harness keeps on the host, and which of it this workspace
# is entitled to see. Harness-specific by nature - which directories exist,
# and what decides that one of their entries belongs to this workspace, is a
# fact about the harness rather than about dejima - so it lives in the
# harness plugin, which declares each mount through emit_mount. The guarded-
# store refusal runs there, at the point of declaration, rather than being
# something each plugin has to remember. See bin/dejima-harness-lib.sh.
harness_hook harness_state_mounts "$WORKSPACE_DIR"

# statusline.sh is executed on the host by Claude Code (settings.json's
# statusLine.command), so it is staged for entrypoint.sh to copy rather than
# mounted at its real path - same as the config in docker-compose.yml.
#
# A :ro mount there protected only the plain-file case, confirmed against a
# live container. When statusline.sh is itself a symlink (the common case),
# bind-mount destination resolution follows it, so the mount lands on the
# target and the link stays replaceable. Staging closes that: Docker resolves
# the symlink setting up the staging mount, and the copy lands where the host
# cannot reach it.
#
# Conditional on existence - mounting a missing source makes Docker create a
# root-owned directory at the target. A dangling symlink is neither
# mountable nor "exists", so it refuses rather than skipping the mount
# (reopening the gap) or failing later with an opaque "mkdir: file exists".
harness_staged_config_load
for _rec in ${DEJIMA_STAGED_CONFIG[@]+"${DEJIMA_STAGED_CONFIG[@]}"}; do
    IFS=$'\t' read -r _ssrc _srel <<< "$_rec"
    # A dangling symlink is neither mountable nor "exists", so it refuses
    # rather than skipping the mount - which would reopen the gap staging
    # closes - or failing later with an opaque "mkdir: file exists".
    if [ -L "$_ssrc" ] && [ ! -e "$_ssrc" ]; then
        echo "$_ssrc is a symlink to a target that doesn't exist." >&2
        echo "Docker can't bind-mount a dangling symlink, and skipping the mount" >&2
        echo "would leave the session without that file entirely." >&2
        echo "Fix or remove the symlink, then retry." >&2
        exit 1
    fi
    [ -e "$_ssrc" ] || continue
    extra_mounts+=(-v "$_ssrc:/etc/dejima-harness/$_srel:ro")
done

# The harness's own writable state, seeded from the host. Mounted read-only
# into a staging tree the same way staged config is - entrypoint.sh installs a
# copy owned by the session user, so the harness can rewrite it and nothing it
# writes reaches the operator's.
#
# The destinations travel as one space-separated list rather than being
# rediscovered by walking the staging tree, because some of them have no
# source: a directory whose contents are mounted individually needs to exist
# and be owned by the session, and there is nothing to copy into it.
harness_seed_load
SANDBOX_HARNESS_SEED=""
for _rec in ${DEJIMA_SEED[@]+"${DEJIMA_SEED[@]}"}; do
    IFS=$'\t' read -r _seedrel _seedsrc <<< "$_rec"
    SANDBOX_HARNESS_SEED="${SANDBOX_HARNESS_SEED:+$SANDBOX_HARNESS_SEED }$_seedrel"
    [ -n "$_seedsrc" ] || continue
    extra_mounts+=(-v "$_seedsrc:/etc/dejima-seed/$_seedrel:ro")
done
export SANDBOX_HARNESS_SEED

# The real Anthropic OAuth credential never enters the container: a host-side
# proxy injects it per request (bin/dejima-anthropic-proxy, docs/security.md).
# ~/.claude is not mounted whole, so the credential has no path into the
# container and nothing needs masking (#50, docs/security.md).
#
# How the container then reaches the proxy depends on the transport. In the
# default tls one, entrypoint.sh points api.anthropic.com at an in-container
# TLS terminator, so no ANTHROPIC_* value is set at all and the session is
# indistinguishable from a stock install - which means Claude Code reads
# ~/.claude/.credentials.json, so a fake one is generated below and mounted
# there. [credentials] transport = loopback is the documented fallback if
# certificate pinning ever makes that impossible: an explicit base URL and
# placeholder token at a plaintext forwarder, as before, with no credential
# file in the container at all.
#
# Skipped when there's no claudeAiOauth block to protect (API-key setups),
# or via the [credentials] proxy = off kill switch. Both then mount the real
# credential in explicitly, which used to come free with the whole-directory
# mount and now has to be stated.
SANDBOX_ANTHROPIC_TRANSPORT="$(config_get credentials transport)"
SANDBOX_ANTHROPIC_BASE_URL=""
SANDBOX_ANTHROPIC_AUTH_TOKEN=""
SANDBOX_ANTHROPIC_PROXY_SOCKET=""
SANDBOX_ANTHROPIC_PROXY_DIR=""
SANDBOX_FAKE_CREDENTIALS_FILE=""
SANDBOX_ANTHROPIC_PROXY_PID=""
if [ "$(config_get_bool credentials proxy)" != "0" ] \
    && jq -e '.claudeAiOauth.accessToken' "$HOME/.claude/.credentials.json" >/dev/null 2>&1; then
    SANDBOX_ANTHROPIC_PROXY_DIR="$(mktemp -d "${TMPDIR:-/tmp}/dejima-anthropic-proxy.XXXXXX")"
    SANDBOX_ANTHROPIC_PROXY_SOCKET="$SANDBOX_ANTHROPIC_PROXY_DIR/proxy.sock"
    "$SCRIPT_DIR/dejima-anthropic-proxy" \
        --socket "$SANDBOX_ANTHROPIC_PROXY_SOCKET" \
        --credentials "$HOME/.claude/.credentials.json" &
    SANDBOX_ANTHROPIC_PROXY_PID=$!
    for _ in $(seq 1 50); do
        [ -S "$SANDBOX_ANTHROPIC_PROXY_SOCKET" ] && break
        kill -0 "$SANDBOX_ANTHROPIC_PROXY_PID" 2>/dev/null || break
        sleep 0.1
    done
    if [ ! -S "$SANDBOX_ANTHROPIC_PROXY_SOCKET" ]; then
        # Falling back to a session with the real credential mounted would
        # be a silent security downgrade - stop loudly instead.
        echo "Credential proxy failed to start - not launching. Fix the error above," >&2
        echo "or set [credentials] proxy = off in $(config_path) to launch without it" >&2
        echo "(the real OAuth credential is then mounted into the container, as before)." >&2
        exit 1
    fi
    extra_mounts+=(-v "$SANDBOX_ANTHROPIC_PROXY_DIR:$SANDBOX_ANTHROPIC_PROXY_DIR:ro")
    if [ "$SANDBOX_ANTHROPIC_TRANSPORT" = "loopback" ]; then
        SANDBOX_ANTHROPIC_BASE_URL="http://127.0.0.1:18300"
        SANDBOX_ANTHROPIC_AUTH_TOKEN="sandbox-credential-proxy-placeholder"
    else
        # With no ANTHROPIC_AUTH_TOKEN set, Claude Code authenticates from
        # .credentials.json directly, so the container needs a well-formed
        # one where it would otherwise have no credential file at all. Only
        # the two secrets are faked; scopes/subscriptionType/rateLimitTier/
        # clientId are copied so the session's own UI reflects the real
        # account.
        #
        # The expiry deliberately does NOT mirror the real credential. A
        # near-term expiresAt would make Claude Code refresh on its own,
        # against platform.claude.com, with a refresh token that is not real -
        # which fails and logs the session out. A year out means it never
        # tries; the host proxy owns refresh, as it already did.
        SANDBOX_FAKE_CREDENTIALS_FILE="$(mktemp "${TMPDIR:-/tmp}/dejima-fake-credentials.XXXXXX")"
        jq --argjson exp "$(( ($(date +%s) + 31536000) * 1000 ))" '
            {claudeAiOauth: (
                {accessToken: "sandbox-credential-proxy-placeholder",
                 refreshToken: "sandbox-credential-proxy-placeholder",
                 expiresAt: $exp,
                 refreshTokenExpiresAt: $exp}
                + (.claudeAiOauth
                   | {scopes, subscriptionType, rateLimitTier, clientId}
                   | with_entries(select(.value != null)))
            )}' "$HOME/.claude/.credentials.json" > "$SANDBOX_FAKE_CREDENTIALS_FILE"
        chmod 600 "$SANDBOX_FAKE_CREDENTIALS_FILE"
        # Read-write: Claude Code rewrites this file on its own schedule, and
        # a failed write is a startup error. It writes to the host temp file,
        # which the EXIT trap removes.
        extra_mounts+=(-v "$SANDBOX_FAKE_CREDENTIALS_FILE:$HOME/.claude/.credentials.json")
    fi
elif [ -f "$HOME/.claude/.credentials.json" ]; then
    # No proxy: the session authenticates with the real credential, so it has
    # to be mounted in. Read-write because Claude Code refreshes it in place.
    # This is the documented downgrade, not an oversight - see the kill-switch
    # message above and docs/security.md.
    extra_mounts+=(-v "$HOME/.claude/.credentials.json:$HOME/.claude/.credentials.json")
fi
export SANDBOX_ANTHROPIC_BASE_URL SANDBOX_ANTHROPIC_AUTH_TOKEN SANDBOX_ANTHROPIC_PROXY_SOCKET
export SANDBOX_ANTHROPIC_TRANSPORT

# Optional remote access (see docs/remote-access.md). Entirely skipped
# unless [remote-access] enabled is on in the config file - with it absent
# nothing below runs, no state is created, and nothing is added to the
# compose invocation.
if remote_enabled; then
    DEJIMA_RUN_ID="$(od -An -tx1 -N8 /dev/urandom | tr -d ' \n')"
    DEJIMA_STATE_DIR="$(remote_state_dir)"

    # The state dir's parent (e.g. /tmp, when XDG_RUNTIME_DIR is unset - the
    # common case for exactly the non-systemd ssh sessions this feature
    # targets) is world-writable, and `mkdir -p -m 700` only applies MODE to
    # the leaf it creates - an already-existing path here (a symlink an
    # attacker pre-created, or a directory some other user owns) is left as
    # is. Since the notify dir created under it is bind-mounted read-write
    # into the container and later `rm -rf`'d by the EXIT trap, following a
    # planted symlink would hand a compromised session (or the trap itself)
    # access to an attacker-chosen path. Create it, then verify it's a real
    # directory we own and not a symlink before trusting it - refuse rather
    # than proceed on anything else. Once this check passes, everything
    # created below it (sessions/, notify/, notify/<run-id>) is safe: mode
    # 700 here means no other user can plant anything inside it afterward.
    # -m applying only to the leaf is the reason for the check below, not
    # an oversight: the mode is verified and reset before anything trusts it.
    # shellcheck disable=SC2174
    mkdir -p -m 700 "$DEJIMA_STATE_DIR" 2>/dev/null || true
    if [ -L "$DEJIMA_STATE_DIR" ] || [ ! -d "$DEJIMA_STATE_DIR" ] \
        || [ "$(stat -c %u "$DEJIMA_STATE_DIR")" != "$(id -u)" ]; then
        echo "Refusing remote access: $DEJIMA_STATE_DIR exists and is not a plain" >&2
        echo "directory owned by the current user (or is a symlink). This could be a" >&2
        echo "symlink attack via a shared /tmp - remove it, or set XDG_RUNTIME_DIR to" >&2
        echo "somewhere else, and retry." >&2
        exit 1
    fi
    chmod 700 "$DEJIMA_STATE_DIR"

    # The parent exists and is 700 by the block above, so -p creates only
    # these leaves and -m is the mode each of them gets.
    # shellcheck disable=SC2174
    mkdir -p -m 700 "$DEJIMA_STATE_DIR/sessions" "$DEJIMA_STATE_DIR/notify"
    DEJIMA_SESSION_FILE="$DEJIMA_STATE_DIR/sessions/$DEJIMA_RUN_ID"
    DEJIMA_NOTIFY_DIR="$DEJIMA_STATE_DIR/notify/$DEJIMA_RUN_ID"
    # shellcheck disable=SC2174
    mkdir -p -m 700 "$DEJIMA_NOTIFY_DIR"

    # Verify what was just created, because everything downstream assumes it.
    # A leaf left behind root-owned by an earlier container restart (see
    # entrypoint.sh) is the shape this catches: mkdir -p succeeds against an
    # existing directory regardless of who owns it, so without this the mount
    # goes ahead and the failure surfaces later as EACCES in a hook.
    #
    # A warning rather than a refusal. Remote access is opt-in, and the rest
    # of the session works without it - blocking a launch over undeliverable
    # notifications would cost more than it saves. The neighbouring state-dir
    # check does refuse, but that one is about a symlink handing a session an
    # attacker-chosen path; this one is only about the feature working.
    if [ ! -O "$DEJIMA_NOTIFY_DIR" ] || [ ! -w "$DEJIMA_NOTIFY_DIR" ]; then
        echo "warning: $DEJIMA_NOTIFY_DIR is not a directory this user owns and can write." >&2
        echo "Remote access is enabled, so notifications and dejima-attach will not work for" >&2
        echo "this session. A leftover root-owned directory here is usually Docker's doing," >&2
        echo "from a container that was restarted rather than relaunched; removing it and" >&2
        echo "starting again clears it." >&2
    fi

    # $TMUX_PANE is set by tmux in the launching shell. Empty when the
    # sandbox wasn't started from tmux: the session is still registered, just
    # listed as not-attachable, rather than silently omitted.
    dejima_tmux_label=""
    if [ -n "${TMUX_PANE:-}" ] && command -v tmux >/dev/null 2>&1; then
        dejima_tmux_label="$(tmux display-message -p -t "$TMUX_PANE" \
            '#{session_name}:#{window_index}' 2>/dev/null || true)"
    fi

    # A newline in either value would inject an extra key=value line into the
    # flat registry entry below - e.g. a fabricated `pane=` line inside a
    # crafted label, which the last-match-wins parser (see dejima-attach)
    # would honor over the real one, redirecting an operator to an
    # attacker-chosen pane. Refuse outright rather than sanitize: a value
    # that can't be represented safely here is the same class of problem as
    # a corrupt approval store elsewhere in this repo.
    case "$WORKSPACE_DIR" in
        *$'\n'*)
            echo "Refusing remote access: workspace path contains a newline: $WORKSPACE_DIR" >&2
            exit 1
            ;;
    esac
    case "$dejima_tmux_label" in
        *$'\n'*)
            echo "Refusing remote access: tmux session/window label contains a newline." >&2
            exit 1
            ;;
    esac
    # $TMUX_PANE comes from the launching shell's environment, so it is the
    # one value here that is taken verbatim rather than derived. It is written
    # second of the four lines below, so an injected line lands ahead of
    # label= and started= and would lose the parser's last-match-wins race to
    # the real ones - but it would WIN against the pane= it is part of, which
    # is the field deciding which pane an operator gets attached to. Refusing
    # the newline outright is what makes that independent of printf ordering.
    case "${TMUX_PANE:-}" in
        *$'\n'*)
            echo "Refusing remote access: \$TMUX_PANE contains a newline." >&2
            exit 1
            ;;
    esac

    # Flat key=value, like the rest of the host-side store: no jq dependency
    # here, and nothing that reads it ever sources it.
    #
    # pid is this process, and it is what dejima-attach asks about instead of
    # guessing how long a launch takes: "is the thing that registered this
    # still running" is observable, and a cold build that outruns any guessed
    # window is the case a guess gets wrong. Written before the container
    # exists, so it covers the whole build, and it stops being true at exactly
    # the moment the EXIT trap below stops being able to run.
    {
        printf 'workspace=%s\n' "$WORKSPACE_DIR"
        printf 'pane=%s\n' "${TMUX_PANE:-}"
        printf 'label=%s\n' "$dejima_tmux_label"
        printf 'started=%s\n' "$(date +%s)"
        printf 'pid=%s\n' "$$"
    } > "$DEJIMA_SESSION_FILE"

    # This run's OWN marker directory is the only thing mounted in - never
    # its parent - so a compromised session can write markers for itself and
    # for nothing else. The registry is never mounted at all: dejima-attach
    # trusts it to decide which pane to attach an operator to, so a session
    # able to rewrite it could redirect them.
    #
    # -e alongside -v here: this array is passed straight to `docker compose
    # run`, where both are valid flags.
    extra_mounts+=(-v "$DEJIMA_NOTIFY_DIR:/run/dejima-notify")
    extra_mounts+=(-e "DEJIMA_NOTIFY_DIR=/run/dejima-notify")
    # Lets the host correlate this run to its container via `docker inspect`,
    # so the container never needs write access to the registry to report its
    # own ID.
    extra_mounts+=(-e "DEJIMA_RUN_ID=$DEJIMA_RUN_ID")

    # Registered per session, into the override layer from above and nowhere
    # else: putting it in the operator's real settings.json would run it for
    # every sandbox and for the host's own agent, which share that file, when
    # it is only meaningful for a session that has a marker directory.
    # $SANDBOX_SETTINGS_FILE is already a throwaway mktemp file, so this
    # rewrite cannot reach the operator's real settings; it is mounted
    # read-only, so the session cannot unregister itself either.
    #
    # How a harness is told to run something on those two events is the
    # harness's own business - Claude Code merges hook entries across
    # settings layers, another harness may take a config key or an
    # environment variable - so the writing is the plugin's. Whether it
    # happens at all is core's, and is gated on the harness having declared
    # the notify guard.
    if harness_has_guard notify; then
        harness_hook harness_register_notify "$SANDBOX_SETTINGS_FILE"
    fi
fi

# Everything from here to the container's own first output is silent: the
# audit snapshot, an image build that prints nothing when every layer is
# cached, and Docker creating the container with a mount per allowed path.
# Long enough to read as hung, so say what is happening first. A first run,
# or one after a Dockerfile change, builds the image and takes minutes rather
# than seconds - the line names that, since it is the case where someone is
# most likely to give up and interrupt.
printf '%sdejima%s is starting, please wait...\n' "$C_KEY" "$C_RESET" >&2
printf '%sA first run builds the container image, which takes several minutes.%s\n' \
    "$C_DIM" "$C_RESET" >&2

# Named here, once, at the moment the operator is choosing to proceed. Silent
# when the harness hosts every guard, so this is not a line anyone learns to
# scroll past - it appears only when a protection they have elsewhere is
# genuinely not in force here.
harness_report_guards "$DEJIMA_HARNESS_NAME"

# Declaring a guard is not the same as it being installed. install.sh
# registers them into the operator's own config, gated on [core] harness -
# so setting that key and not re-running install.sh leaves every launch
# after it with no briefing and no guards, and nothing said so. The project's
# own standard is that a silently narrower run is worse than a noisy one.
if ! _unwired="$(harness_guards_wired)"; then
    printf '  %snot registered for %s, so not in force this session:%s\n' \
        "$C_WARN" "$DEJIMA_HARNESS_NAME" "$C_RESET" >&2
    printf '%s\n' "$_unwired" | while IFS= read -r _u; do
        [ -n "$_u" ] && printf '    %s%s%s\n' "$C_KEY" "$_u" "$C_RESET" >&2
    done
    printf '  Run %s./install.sh%s to register them.\n' "$C_KEY" "$C_RESET" >&2
fi

# Snapshot host-persistence surfaces so the post-run audit can report
# anything that changed while this session ran (advisory - see bin/dejima-audit).
"$SCRIPT_DIR/dejima-audit" snapshot "$WORKSPACE_DIR" "$SANDBOX_AUDIT_STATE" || true

# When the sandbox is pointed at its own repo, its TCB (bin/, hooks/,
# docker/, install.sh, test/) is mounted writable - warn, and the audit
# below will report any change to it.
if [ "$(readlink -f "$WORKSPACE_DIR")" = "$(readlink -f "$REPO_ROOT")" ]; then
    echo "Warning: sandbox's own repo is the mounted workspace - its trusted" >&2
    echo "computing base (bin/, hooks/, docker/, install.sh) is writable this" >&2
    echo "session; the exit audit will report any changes to review." >&2
fi

# Compose builds the shared base image under its own tag, explicitly - with
# image: now honoring $SANDBOX_IMAGE, letting the derived tag leak into this
# build would rebuild the base Dockerfile under the derived name.
SANDBOX_IMAGE="dejima:${SANDBOX_USER}" \
    docker compose -f "$COMPOSE_FILE" build sandbox

SANDBOX_IMAGE="dejima:${SANDBOX_USER}"

# Each layer builds FROM whatever the previous one left in $SANDBOX_IMAGE, so
# global packages are shared by every project instead of being rebuilt into
# each one's image.
build_dep_layer() {
    local tag="$1" store="$2"
    generate_derived_dockerfile "$SANDBOX_IMAGE" "$store" > "$SANDBOX_DERIVED_DOCKERFILE"
    echo "Building $tag (approved dependencies)..."
    if ! docker build -t "$tag" -f "$SANDBOX_DERIVED_DOCKERFILE" "$SANDBOX_DERIVED_CONTEXT"; then
        # No fallback to a less-equipped image: that would hand the session an
        # environment missing the dependencies it was told it has.
        echo "Failed to build $tag." >&2
        echo "Fix the approved dependencies (dejima-dep list) and retry." >&2
        exit 1
    fi
    SANDBOX_IMAGE="$tag"
}

# The selected harness, and only it.
#
# The base image is shared by every project on this host, so a harness baked
# into it would be carried by every sandbox whether or not it is the one
# selected - and a second harness could only ever be added alongside the
# first, never chosen between. Here it is a layer keyed on the harness's own
# name, so switching [core] harness switches images rather than accumulating
# into one.
#
# Built before the dependency layers so a project's own packages sit above the
# harness rather than being invalidated whenever it changes.
#
# The spec is manifest data of type `depspec`, so manifest_get has already
# refused anything valid_dep_spec would - the same function an operator's
# approved dependency goes through, and the reason this string is safe to
# interpolate into a Dockerfile RUN line. Re-checking here would be a second
# copy of a rule with no way to disagree with the first, and no way to test.
SANDBOX_HARNESS_INSTALL="$(manifest_get harness "$DEJIMA_HARNESS_NAME" install)"
# What this harness needs its image to contain besides the package: the
# directories it keeps state in, and anything it wants in the environment.
# Both used to be in the base image, where they were one harness's needs
# imposed on every image dejima builds.
SANDBOX_HARNESS_IMAGE_DIRS="$(manifest_get harness "$DEJIMA_HARNESS_NAME" image_dirs)"
SANDBOX_HARNESS_IMAGE_ENV="$(manifest_get harness "$DEJIMA_HARNESS_NAME" image_env)"
SANDBOX_HARNESS_IMAGE_FILES="$(manifest_get harness "$DEJIMA_HARNESS_NAME" image_files)"

if [ -n "$SANDBOX_HARNESS_INSTALL" ] || [ -n "$SANDBOX_HARNESS_IMAGE_DIRS" ] \
    || [ -n "$SANDBOX_HARNESS_IMAGE_ENV" ] || [ -n "$SANDBOX_HARNESS_IMAGE_FILES" ] \
    || [ -s "$(config_root)/dependencies" ] \
    || { [ -n "$PROJECT_STORE" ] && [ -s "$PROJECT_STORE/dependencies" ]; }; then
    SANDBOX_DERIVED_DOCKERFILE="$(mktemp "${TMPDIR:-/tmp}/dejima-derived.XXXXXX")"
    # An empty context, never $WORKSPACE_DIR: the project directory is
    # session-writable, and a root-context build with it as context would let a
    # compromised session feed files into the image it then runs in.
    SANDBOX_DERIVED_CONTEXT="$(mktemp -d "${TMPDIR:-/tmp}/dejima-derived-ctx.XXXXXX")"
fi

if [ -n "$SANDBOX_HARNESS_INSTALL" ] || [ -n "$SANDBOX_HARNESS_IMAGE_DIRS" ] \
    || [ -n "$SANDBOX_HARNESS_IMAGE_ENV" ] || [ -n "$SANDBOX_HARNESS_IMAGE_FILES" ]; then
    tag="dejima:${SANDBOX_USER}-harness-${DEJIMA_HARNESS_NAME}"
    generate_spec_dockerfile "$SANDBOX_IMAGE" "$SANDBOX_HARNESS_INSTALL" \
        "$SANDBOX_HARNESS_IMAGE_DIRS" "$SANDBOX_HARNESS_IMAGE_ENV" \
        "$SANDBOX_HARNESS_IMAGE_FILES" \
        > "$SANDBOX_DERIVED_DOCKERFILE"
    echo "Building $tag ($DEJIMA_HARNESS_NAME)..."
    if ! docker build -t "$tag" -f "$SANDBOX_DERIVED_DOCKERFILE" "$SANDBOX_DERIVED_CONTEXT"; then
        # No fallback: a session started on an image without its harness gets
        # an exec failure inside a container, which reads as dejima being
        # broken rather than as this build having failed.
        echo "Failed to build $tag." >&2
        echo "The harness installs from: $SANDBOX_HARNESS_INSTALL" >&2
        exit 1
    fi
    SANDBOX_IMAGE="$tag"
fi

if [ -s "$(config_root)/dependencies" ]; then
    build_dep_layer "dejima:${SANDBOX_USER}-global" "$(config_root)"
fi
if [ -n "$PROJECT_STORE" ] && [ -s "$PROJECT_STORE/dependencies" ]; then
    build_dep_layer "dejima:${SANDBOX_USER}-$(project_slug "$WORKSPACE_DIR")" "$PROJECT_STORE"
fi
export SANDBOX_IMAGE

# nvim's data, state and cache are Docker volumes rather than host paths, so
# nothing a session installs reaches the host's own nvim. They did outlive
# the container under one fixed name each, though, shared by every project
# on the machine: a session that drops a file under `lazy/`, or replaces a
# binary under `mason/bin/`, is writing something a later session in an
# unrelated project executes the next time nvim runs in the sandbox. That is
# the persistence this repository closes everywhere else, so it is scoped
# the same way the derived image tag is - per project.
#
# The prefix is not decoration: project_slug maps a leading `/` to `-`, and
# a Docker volume name may not start with one.
_nvim_volume_slug="$(project_slug "$WORKSPACE_DIR")"
export SANDBOX_NVIM_DATA="dejima_nvim-data${_nvim_volume_slug}"
export SANDBOX_NVIM_STATE="dejima_nvim-state${_nvim_volume_slug}"
export SANDBOX_NVIM_CACHE="dejima_nvim-cache${_nvim_volume_slug}"

# Not exec'd (the EXIT trap cleans up the generated temp files) and not a
# bare command under set -e (a nonzero/interrupted container run - e.g.
# Ctrl-C returning 130 - would otherwise abort the script here, skipping the
# credential-proxy check below it). Capture the status explicitly, then
# propagate the real container exit code unchanged - the exit-time audit
# itself now runs unconditionally from cleanup(), not because of this
# capture.
# Unacknowledged CRITICAL findings from earlier runs, re-presented here
# because exit-time output can be ignored exactly once, permanently. This is
# host-side and stays host-side: it must never be routed into the session's
# context, which would make it a cross-session persistence channel.
audit_slug="$(ws_slug "$WORKSPACE_DIR")"
audit_reports="$AUDIT_DIR/$audit_slug"
# `|| true`: a workspace with no history yet (the common case - nothing has
# ever run against it, or every past finding is already acknowledged) has no
# audit_reports directory at all, and find on a missing path exits nonzero -
# which, combined with pipefail, would otherwise abort this script here for
# every ordinary launch.
pending_crit="$(find "$audit_reports" -maxdepth 1 -name '*-CRITICAL.txt' 2>/dev/null | sort)" || true
if [ -n "$pending_crit" ]; then
    # Re-read after an inline `ack`, so approving everything here clears the
    # warning instead of asking again about reports that no longer carry a
    # CRITICAL. Looping rather than asking once: `ack` walks ONE report per
    # run (see select_report), so a workspace with several needs several
    # passes, and sending the operator back to their shell between each is
    # the friction this option exists to remove (#65).
    while [ -n "$pending_crit" ]; do
        n="$(printf '%s\n' "$pending_crit" | wc -l)"
        echo "" >&2
        printf '  dejima: %s%s unacknowledged %sCRITICAL%s finding(s) in this workspace\n' \
            "$C_CRIT" "$n" "$C_CRIT" "$C_RESET" >&2
        printf '%s\n' "$pending_crit" \
            | sed "s#.*/##; s#-CRITICAL\.txt\$##; s#^#          from run ${C_INFO}#; s#\$#${C_RESET}#" >&2
        printf '          Review with: %sdejima-audit ack "%s"%s\n' \
            "$C_KEY" "$WORKSPACE_DIR" "$C_RESET" >&2
        if [ -t 0 ]; then
            printf '          %s[a]%s review now  %s[c]%s continue  %s[q]%s quit: ' \
                "$C_KEY" "$C_RESET" "$C_KEY" "$C_RESET" "$C_KEY" "$C_RESET" >&2
            read -r reply || reply=q
            case "$reply" in
                q|Q) echo "aborted." >&2; exit 1 ;;
                a|A)
                    # Run it here rather than telling the operator to run it
                    # in another terminal: this is the moment they are
                    # looking at the finding, and the container has not
                    # started, so nothing is waiting on the answer.
                    "$SCRIPT_DIR/dejima-audit" ack "$WORKSPACE_DIR" || true
                    pending_crit="$(find "$audit_reports" -maxdepth 1 -name '*-CRITICAL.txt' 2>/dev/null | sort)" || true
                    continue
                    ;;
            esac
        fi
        break
    done
fi
if [ -n "$pending_crit" ] && [ ! -t 0 ]; then
    if [ "$(config_get_bool audit strict)" = "1" ]; then
        echo "          audit.strict is on and stdin is not a tty - refusing to start." >&2
        exit 1
    else
        echo "          (not a tty - continuing; set audit.strict = on to refuse)" >&2
    fi
fi

compose_status=0
# Conversation shipping, host-side: it reads transcripts that are on the host
# already, so it never needed to be in the container - and being there put it
# in a process the session shared a filesystem and a signal namespace with.
# Started here rather than earlier so it does not run during a launch that
# refuses, and stopped in cleanup() before the audit.
#
# `|| true` and a backgrounded start: shipping is a bonus on top of the
# session, so a shipper that cannot start must not stop the session running.
"$SCRIPT_DIR/dejima-conversation-ship" "$WORKSPACE_DIR" &
SANDBOX_CONVERSATION_SHIP_PID=$!

# Ctrl-Z (#179). Two things have to be true at once, and the second is the
# one that took four rounds of measurement to find.
#
# The keystroke has to become a signal at all. Under a container run the
# terminal is raw, ISIG is off, and Ctrl-Z is the byte 0x1a delivered into the
# container - where a harness that implements suspend stops itself, with no
# job-control shell in there to continue it. dejima-tty-suspend takes that one
# character back for the host.
#
# And the container client must never receive SIGTSTP. Measured, holding
# everything else equal: the client survives SIGSTOP and does not survive
# SIGTSTP. A catchable stop signal interrupts the read it is blocked in, its
# input forwarding never recovers, and the session comes back alive but deaf -
# resumed, with nothing typed reaching the harness. That is what shipped once
# and had to be taken out again.
#
# So the client is started with SIGTSTP ignored, which it inherits and keeps
# across exec, and the launcher converts the keystroke into an explicit
# SIGSTOP for it before stopping itself. The job still stops completely, so
# the prompt comes back; the client is stopped by a signal that interrupts
# nothing.
#
# < /dev/tty because a background command is given /dev/null for stdin, and a
# container client with no terminal reads EOF and exits at once.
SANDBOX_TTY_MODES="$(stty -g < /dev/tty 2>/dev/null)" || SANDBOX_TTY_MODES=""
if [ -n "$SANDBOX_TTY_MODES" ]; then
    "$SCRIPT_DIR/dejima-tty-suspend" &
    SANDBOX_TTY_SUSPEND_PID=$!

    trap '' TSTP
    docker compose -f "$COMPOSE_FILE" run --rm ${extra_mounts[@]+"${extra_mounts[@]}"} sandbox "$@" < /dev/tty &
    SANDBOX_CLIENT_PID=$!
    trap - TSTP

    # The pid $! names is the docker CLI; `docker compose run` then runs the
    # compose plugin as a child of it, and the child is what holds the
    # terminal. Stopping only the pid leaves that child in raw mode with the
    # shell also on the terminal - a cursorless prompt that resumes to
    # nothing, which is what the first version of this fix produced.
    #
    # Deepest first, so nothing is left running long enough to fork again;
    # shallowest first on the way back, so a parent is ready before its child
    # resumes.
    _stop_tree() {
        local p="$1" kid
        for kid in $(pgrep -P "$p" 2>/dev/null); do _stop_tree "$kid"; done
        kill -STOP "$p" 2>/dev/null || true
    }
    _cont_tree() {
        local p="$1" kid
        kill -CONT "$p" 2>/dev/null || true
        for kid in $(pgrep -P "$p" 2>/dev/null); do _cont_tree "$kid"; done
    }

    _on_tstp() {
        _stop_tree "$SANDBOX_CLIENT_PID"
        # Default disposition to actually stop, then put the handler back for
        # the next time. Everything after the re-raise runs on resume.
        trap - TSTP
        kill -TSTP $$
        trap _on_tstp TSTP
        _cont_tree "$SANDBOX_CLIENT_PID"
    }
    trap _on_tstp TSTP

    # Looped because `wait` returns early when a trap runs, which is exactly
    # what happens on every suspend.
    while kill -0 "$SANDBOX_CLIENT_PID" 2>/dev/null; do
        if wait "$SANDBOX_CLIENT_PID"; then
            compose_status=0
        else
            compose_status=$?
        fi
        # 128+n means a signal interrupted the wait rather than the client
        # exiting; anything else is the client's own status.
        case "$compose_status" in
            146|148) continue ;;
        esac
        break
    done
    trap - TSTP
else
    # No terminal - a CI job, or output redirected. Nothing to suspend, and
    # /dev/tty would not open.
    docker compose -f "$COMPOSE_FILE" run --rm ${extra_mounts[@]+"${extra_mounts[@]}"} sandbox "$@" || compose_status=$?
fi
if [ -n "${SANDBOX_ANTHROPIC_PROXY_PID:-}" ] && ! kill -0 "$SANDBOX_ANTHROPIC_PROXY_PID" 2>/dev/null; then
    echo "Warning: the credential proxy exited before the session ended - API calls in" >&2
    echo "the session may have been failing. Check for proxy errors in the output above." >&2
fi
exit "$compose_status"
