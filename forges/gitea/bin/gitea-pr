#!/bin/bash
set -euo pipefail

GITEA_TOKEN_FILE="${GITEA_TOKEN_FILE:-$HOME/.config/gitea/token}"

function usage() {
    echo "Usage: gitea-pr create [--title TITLE] [--body BODY | --body-file FILE] [--base BRANCH]"
    echo "       gitea-pr edit PR_NUMBER [--title TITLE] [--body BODY | --body-file FILE]"
    echo "       gitea-pr comments PR_NUMBER"
    echo "       gitea-pr merge PR_NUMBER"
    echo ""
    echo "--body-file reads the body from FILE, or from stdin when FILE is '-'."
    echo "Prefer it over --body for anything with quotes, backticks or newlines."
    echo ""
    echo "'edit' replaces the title and/or body of an existing PR. Whichever of"
    echo "the two is not given is left as it is."
    echo ""
    echo "Requires GITEA_SSH_HOST and GITEA_API set in the environment (e.g. in" \
         "your shell profile), and a token at $GITEA_TOKEN_FILE (or GITEA_TOKEN" \
         "set for this invocation only)."
}

function require_config() {
    if [ -z "${GITEA_SSH_HOST:-}" ]; then
        echo "GITEA_SSH_HOST is not set. Add 'export GITEA_SSH_HOST=<gitea ssh hostname>'" \
             "(e.g. gitea.example.com) to ~/.profile.local" >&2
        exit 1
    fi
    if [ -z "${GITEA_API:-}" ]; then
        echo "GITEA_API is not set. Add 'export GITEA_API=https://<gitea host>/api/v1'" \
             "(e.g. https://gitea.example.com/api/v1) to ~/.profile.local" >&2
        exit 1
    fi
}

function require_token() {
    if [ -z "${GITEA_TOKEN:-}" ] && [ -f "$GITEA_TOKEN_FILE" ]; then
        GITEA_TOKEN=$(<"$GITEA_TOKEN_FILE")
    fi
    if [ -z "${GITEA_TOKEN:-}" ]; then
        echo "No Gitea token found. Generate one in the Gitea web UI" \
             "(Settings > Applications, scopes write:repository + write:issue)" \
             "and save it to $GITEA_TOKEN_FILE (chmod 600), or set GITEA_TOKEN" \
             "in the environment for this invocation only." >&2
        exit 1
    fi
}

# Feeds the auth header to curl as a config on stdin rather than as an
# argument. Command lines are world-readable through /proc, so `-H
# "Authorization: token $GITEA_TOKEN"` exposes the token to every other
# process on the host for as long as the request runs - and to anything that
# scrapes `ps` output, including the agents this repo exists to sandbox.
# printf is a bash builtin, so the token never lands in another argv.
function gitea_api() {
    printf 'header = "Authorization: token %s"\n' "$GITEA_TOKEN" |
        curl -sS -w '\n%{http_code}' -K - "$@"
}

# Splits gitea_api's combined output into the globals `json` and `http_code`
# and fails with the body on any non-2xx. Copied from gitea-issue, which grew
# it first for the same reason: every call site here did this by hand, and a
# fifth hand-rolled copy is where one of them quietly stops checking.
function api_or_die() {
    local what="$1"; shift
    local response
    response=$(gitea_api "$@")
    http_code=$(echo "$response" | tail -1)
    json=$(echo "$response" | sed '$d')
    if [ "$http_code" -lt 200 ] || [ "$http_code" -ge 300 ]; then
        echo "Failed to $what (HTTP $http_code):" >&2
        echo "$json" >&2
        exit 1
    fi
}

# Reads a body from a file, or from stdin for '-'. The point is to keep prose
# out of argv: a body composed on a command line has to survive shell quoting,
# and the things that break it - an apostrophe, a backtick, a $ - are exactly
# what English and code fences are made of. A file (or a heredoc into '-') has
# no such layer.
function read_body_file() {
    local file="$1"
    if [ "$file" = "-" ]; then
        cat
        return
    fi
    if [ ! -f "$file" ]; then
        echo "No such body file: $file" >&2
        exit 1
    fi
    cat "$file"
}

function gitea_owner_repo() {
    local remote_url host owner_repo
    remote_url=$(git remote get-url origin 2>/dev/null) || {
        echo "No 'origin' remote found in this repository" >&2
        exit 1
    }
    host=$(echo "$remote_url" | sed -E 's#^[^@]+@([^:]+):.*#\1#')
    if [ "$host" != "$GITEA_SSH_HOST" ]; then
        echo "origin remote ($remote_url) is not on $GITEA_SSH_HOST; gitea-pr only supports this host" >&2
        exit 1
    fi
    owner_repo=$(echo "$remote_url" | sed -E 's#^[^@]+@[^:]+:##; s#\.git$##')
    echo "$owner_repo"
}

function require_number() {
    if ! [[ "${1:-}" =~ ^[0-9]+$ ]]; then
        echo "Expected a PR number, got '${1:-}'" >&2
        exit 1
    fi
}

# Sets `body` from --body/--body-file, `parsed_title` from --title and
# `parsed_base` from --base, rejecting --body and --body-file together.
# Shared by create and edit so the two cannot drift into disagreeing about
# which one wins - the same reason gitea-issue shares one between its own
# two body-taking subcommands.
function parse_body_args() {
    body=""
    local body_file=""
    parsed_title=""
    parsed_base=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --title) parsed_title="$2"; shift 2 ;;
            --body) body="$2"; shift 2 ;;
            --body-file) body_file="$2"; shift 2 ;;
            --base) parsed_base="$2"; shift 2 ;;
            *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
        esac
    done
    # Rejected rather than ranked: silently preferring one would make a caller
    # that passed both ship a body it didn't mean to.
    if [ -n "$body" ] && [ -n "$body_file" ]; then
        echo "Pass --body or --body-file, not both" >&2
        exit 1
    fi
    if [ -n "$body_file" ]; then
        body="$(read_body_file "$body_file")"
    fi
}

if [ "$#" -lt 1 ]; then
    usage
    exit 1
fi

subcommand="$1"
shift

case "$subcommand" in
    create|edit|comments|merge)
        require_config
        require_token
        owner_repo=$(gitea_owner_repo)
        owner="${owner_repo%%/*}"
        repo="${owner_repo##*/}"
        ;;
    *)
        usage
        exit 1
        ;;
esac

case "$subcommand" in
    create)
        parse_body_args "$@"
        title="$parsed_title"
        base="$parsed_base"
        body="**Summary generated by LLM agent**

${body}"

        current_branch=$(git rev-parse --abbrev-ref HEAD)
        if [ "$current_branch" = "HEAD" ]; then
            echo "Detached HEAD: check out the feature branch before creating a PR" >&2
            exit 1
        fi

        if [ -z "$base" ]; then
            base=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's#refs/remotes/origin/##' || true)
            base="${base:-main}"
        fi

        api_or_die "check for an existing PR" "${GITEA_API}/repos/${owner}/${repo}/pulls?state=open"
        existing_url=$(echo "$json" | jq -r --arg head "$current_branch" --arg base "$base" \
            '.[] | select(.head.ref == $head and .base.ref == $base) | .html_url' | head -1)
        if [ -n "$existing_url" ]; then
            echo "$existing_url"
            exit 0
        fi
        if [ -z "$title" ]; then
            title="$current_branch"
        fi

        api_or_die "create PR" -X POST "${GITEA_API}/repos/${owner}/${repo}/pulls" \
            -H "Content-Type: application/json" \
            -d "$(jq -n --arg head "$current_branch" --arg base "$base" --arg title "$title" --arg body "$body" \
                '{head: $head, base: $base, title: $title, body: $body}')"
        echo "$json" | jq -r '.html_url'
        ;;
    edit)
        require_number "${1:-}"
        pr_number="$1"
        shift
        parse_body_args "$@"
        if [ -n "$parsed_base" ]; then
            echo "gitea-pr edit cannot change the base branch" >&2
            exit 1
        fi
        if [ -z "$parsed_title" ] && [ -z "$body" ]; then
            echo "gitea-pr edit requires --title, --body or --body-file" >&2
            exit 1
        fi

        # Only the fields actually given are sent: an omitted key leaves that
        # field alone, so editing a title cannot blank a body by accident.
        payload='{}'
        if [ -n "$parsed_title" ]; then
            payload=$(echo "$payload" | jq --arg t "$parsed_title" '. + {title: $t}')
        fi
        if [ -n "$body" ]; then
            # The same marker create writes. It describes where the body came
            # from rather than the event that wrote it, so an edited body
            # keeps the disclosure instead of quietly shedding it.
            payload=$(echo "$payload" | jq --arg b "**Summary generated by LLM agent**

$body" '. + {body: $b}')
        fi

        api_or_die "edit PR #${pr_number}" -X PATCH \
            "${GITEA_API}/repos/${owner}/${repo}/pulls/${pr_number}" \
            -H "Content-Type: application/json" -d "$payload"
        echo "$json" | jq -r '.html_url'
        ;;
    comments)
        pr_number="${1:-}"
        if [ -z "$pr_number" ]; then
            echo "Usage: gitea-pr comments PR_NUMBER" >&2
            exit 1
        fi

        echo "=== Issue comments ==="
        api_or_die "fetch issue comments" \
            "${GITEA_API}/repos/${owner}/${repo}/issues/${pr_number}/comments"
        echo "$json" | jq -r '.[] | "[\(.user.login) @ \(.created_at)]\n\(.body)\n"'

        echo "=== Reviews ==="
        api_or_die "fetch reviews" "${GITEA_API}/repos/${owner}/${repo}/pulls/${pr_number}/reviews"
        reviews_json="$json"
        echo "$reviews_json" | jq -r '.[] | select(.body != "") | "[\(.user.login) @ \(.submitted_at) — \(.state)]\n\(.body)\n"'

        echo "=== Inline review comments ==="
        review_ids=$(echo "$reviews_json" | jq -r '.[] | select(.comments_count > 0) | .id')
        for review_id in $review_ids; do
            api_or_die "fetch comments for review ${review_id}" \
                "${GITEA_API}/repos/${owner}/${repo}/pulls/${pr_number}/reviews/${review_id}/comments"
            echo "$json" | jq -r '.[] | "[\(.user.login) @ \(.path):\(.line // "?")]\n\(.body)\n"'
        done
        ;;
    merge)
        pr_number="${1:-}"
        if [ -z "$pr_number" ]; then
            echo "Usage: gitea-pr merge PR_NUMBER" >&2
            exit 1
        fi

        api_or_die "merge PR #${pr_number}" -X POST \
            "${GITEA_API}/repos/${owner}/${repo}/pulls/${pr_number}/merge" \
            -H "Content-Type: application/json" -d '{"Do": "merge"}'
        echo "Merged PR #${pr_number}"
        ;;
esac
