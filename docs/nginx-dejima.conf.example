# Example nginx vhost for the dejima web front door. EVERY address, hostname
# and path below is a placeholder - substitute your own. As written this file
# will not load: that is deliberate, so it can never become a live config by
# being copied into sites-enabled and forgotten.
#
# ---------------------------------------------------------------------------
# Read this part before the config part.
#
# Whoever reaches this vhost gets a HOST SHELL. ttyd runs bin/dejima-attach,
# which attaches a tmux client on the operator's own tmux server - and a tmux
# client is a shell outside the container, one prefix key away from a new
# window that has nothing to do with any sandbox.
#
# So two things carry this feature's entire security, and both live here:
#
#   1. The listen address. docker/init-firewall.sh:187 accepts container
#      OUTPUT to the default-route address - the Docker bridge gateway, which
#      is the host. A vhost bound to every interface, or to that gateway
#      address, is reachable FROM a sandbox, which would let a compromised
#      session walk out through its own escape hatch. Bind one specific LAN
#      address, never the wildcard form (a bare `listen 443 ssl;`), and never
#      the bridge address. `ip -br addr` lists the candidates; `ss -ltnp`
#      afterwards shows what you actually bound.
#
#   2. Authentication. ttyd is started with no credential of its own (see
#      bin/dejima-ttyd), because it is bound to 127.0.0.1 where only this
#      host can reach it - this proxy is the only gate in front of it. A
#      vhost without auth_basic (or something stronger in its place) is an
#      unauthenticated host shell on your LAN. Put every listen behind it:
#      a second server block without auth is the same open door.
#
#      Authentication alone does not stop a page in your browser from
#      opening a WebSocket to this vhost and having the browser attach your
#      credential to it, which is why bin/dejima-ttyd passes --check-origin.
#      That check compares the Origin against the Host header, so the
#      `Host $http_host` line below is load-bearing, not tidiness - and it
#      has to be $http_host, which keeps the port, on any listen other
#      than 443. See the comment on that line.
#
#   3. The catch-all below. nginx chooses a server block by SNI/Host, and
#      when nothing matches it serves the DEFAULT server for that listen
#      address - which, if the vhost below is the only block on it, is the
#      vhost below. `server_name` therefore isolates nothing by itself: with
#      one block, this front door answers to EVERY name that resolves to
#      this address, the box's own hostname included. What is behind it is a
#      host shell, so the reject block comes first and takes that role.
#
# TLS is not optional either: HTTP Basic sends the password on every request,
# and the terminal itself carries whatever the session is working on.
# ---------------------------------------------------------------------------

# Refuses every name that is not the vhost below. Without it, `server_name`
# is decorative and any hostname pointed at this address reaches the shell.
#
# If you ALREADY have a default_server on this address:port, don't add a
# second - nginx refuses to start ("duplicate default server") - just make
# sure the existing one doesn't fall through to the block below.
server {
    listen <LAN-IP>:443 ssl default_server;
    # Refuses at the TLS layer, so it needs no certificate of its own
    # (nginx 1.19.4+). On older nginx, give this block the same certificate
    # as the vhost below and `return 444;` instead.
    ssl_reject_handshake on;
}

server {
    # One specific address. Not the wildcard form, not the Docker bridge.
    listen <LAN-IP>:443 ssl;
    server_name <hostname>;

    ssl_certificate     /path/to/fullchain.pem;
    ssl_certificate_key /path/to/privkey.pem;

    # The only authentication there is. See point 2 above.
    #   htpasswd -c /path/to/dejima.htpasswd <username>
    auth_basic           "dejima";
    auth_basic_user_file /path/to/dejima.htpasswd;

    location / {
        # Loopback: ttyd binds 127.0.0.1 only, so nginx has to be on the same
        # host. The port must match TTYD_PORT in ~/.config/dejima/remote.conf
        # (7681 when it is not set).
        proxy_pass http://127.0.0.1:7681;

        # ttyd serves its page over HTTP and then upgrades to a WebSocket;
        # both need HTTP/1.1 and the upgrade headers passed through.
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        # ttyd's --check-origin compares the client's Origin against Host.
        # Drop this line and it compares against 127.0.0.1:<port> instead.
        #
        # $http_host, not $host: $host has the port stripped, and ttyd keeps
        # the port in what it compares unless it is 80 or 443. On a vhost
        # listening anywhere else - 8443, say - $host would make ttyd compare
        # "name:8443" against "name" and refuse every WebSocket: the page
        # loads, the terminal never connects, and the only sign is
        # "refuse to serve WS client from different origin" in ttyd's log.
        proxy_set_header Host       $http_host;

        # An attached terminal can sit idle for hours; nginx's default read
        # timeout is 60 seconds. ttyd's own WebSocket ping (every 5s by
        # default) normally keeps the connection alive on its own, but that
        # is ttyd's default to change, not something to depend on here.
        proxy_read_timeout 1d;

        # ---- Phone rendering needs nothing here.
        #
        # Earlier versions of this file injected a viewport meta tag with
        # sub_filter, because ttyd's own page ships none - not in 1.7.7, not on
        # main - and a mobile browser that finds none assumes a desktop-width
        # layout and scales the whole thing down. dejima-ttyd now serves its own
        # page (--index web/index.html), which carries the tag along with the
        # touch gestures and toolbar, so the injection is gone and with it the
        # requirement for an nginx built with the sub module.
        #
        # If you deliberately go back to ttyd's stock frontend by dropping
        # --index, the old three lines were:
        #
        #     sub_filter '<head>' '<head><meta name="viewport" content="width=device-width, initial-scale=1">';
        #     sub_filter_once on;
        #     proxy_set_header Accept-Encoding "";   # sub_filter cannot rewrite a compressed body

        # ttyd sends this page with no Cache-Control, no ETag and no
        # Last-Modified - src/http.c sets status, content-type,
        # content-encoding and content-length, and nothing else - and a
        # response carrying neither freshness information nor a validator is
        # cacheable at the browser's discretion, which on a phone means
        # indefinitely. The page is a build artifact that changes when this
        # repo does, so a phone that has been here before would otherwise go on
        # rendering whatever it first saw - and a frontend that is a version
        # behind looks like a broken feature, not like a cache. Nothing is lost
        # by refusing the cache: with no validator upstream, a revalidation
        # could never come back 304 anyway.
        add_header Cache-Control "no-store" always;
    }
}
