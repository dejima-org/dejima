#!/bin/bash
# Host-side exit-time audit for bin/dejima. Snapshots the workspace's
# host-persistence surfaces before the container runs, and after it exits
# reports (advisory only - never blocks) anything that changed during that
# window and would execute or load OUTSIDE the sandbox: git config keys that
# run a command on the next `git`, and content under .claude/ / .mcp.json /
# .envrc / .vscode/ / .git/hooks/. Read the report before running `git` or
# `claude` in that repo again. See docs/security.md.
set -uo pipefail

# shellcheck source=dejima-provider-lib.sh
source "$(dirname "$(readlink -f "$0")")/dejima-provider-lib.sh"
config_validate || exit 1

cmd="${1:-}"; ws_arg="${2:-}"; state="${3:-}"

PROJECTS_DIR="$(config_get harness.claude-code projects_dir)"

# The one top-level ~/.claude entry docker-compose.yml's read-only overlays
# don't cover (settings.json/CLAUDE.md/plugins/hooks/skills/commands/agents/
# output-styles all are) - settings.json's statusLine.command runs it on the
# HOST, unsandboxed, and bin/dejima's own read-only mount onto it
# doesn't reliably protect it when it's a symlink (the common case - runc
# resolves the mount destination through the symlink; confirmed against a
# live container, see test/runtime.bats). Detection here is the compensating
# control for that gap. Overridable for tests.
STATUSLINE_PATH="$(config_get harness.claude-code statusline_path)"

# This script's own repo root - the sandbox's trusted computing base (see
# tcb_snapshot below) is only monitored when the workspace being audited IS
# this repo (a self-mounted session). Overridable for tests.
AUDIT_REPO_ROOT="${DEJIMA_AUDIT_REPO_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"

# Fixed, not configurable: a predictable report shape is worth more than
# tunability, and >10 CRITICAL findings is an anomaly rather than a display
# problem (an ordinary session produces zero).
CRIT_CAP=10
# WARNING is where volume actually lands: the INFO path in path_severity()
# below is currently unreachable, so every high-volume workspace-file change
# classifies as WARNING instead of collapsing into an INFO count. Capped
# moderately - overflow here is ordinary, not an alarm.
WARN_CAP=5

AUDIT_DIR="$(config_get audit dir)"
# Retention is a security property, not housekeeping. With one overwritten
# report, a session that plants something needs only to talk the operator
# into a restart for the next clean exit to erase the evidence - and
# suggesting a restart is an entirely ordinary thing to suggest.
AUDIT_KEEP="$(config_get audit keep)"

ws_slug() { printf '%s' "$1" | sed 's/[^a-zA-Z0-9]/-/g'; }

# The one report both `show` and `ack` operate on: the OLDEST unacknowledged
# CRITICAL report if there is one, else the newest report overall.
#
# Oldest-CRITICAL-first, rather than a plain `sort | tail -1` over every
# *.txt, because that always prefers the newer file - so a stale
# *-CRITICAL.txt sitting behind a newer clean report would be unreachable
# through `ack` entirely, while bin/dejima's startup warning kept firing on
# it forever with no remedy but to press past it. That is the alert fatigue
# this feature exists to end, so it must not be reachable by this route.
#
# Shared by both verbs so they cannot disagree: an operator following that
# startup warning may well reach for `show` first, and showing them a
# different report than the one being warned about sends them looking for a
# finding that is not in it.
select_report() {
    local dir="$1" r
    r="$(find "$dir" -maxdepth 1 -name '*-CRITICAL.txt' 2>/dev/null | sort | head -1)"
    [ -n "$r" ] || r="$(find "$dir" -maxdepth 1 -name '*.txt' 2>/dev/null | sort | tail -1)"
    [ -n "$r" ] || return 1
    printf '%s\n' "$r"
}

BASELINE_DIR="$(config_get audit baselines_dir)"

# The workspace argument is optional: `dejima-audit show` inside a repo
# should mean that repo. bin/dejima always passes an explicit path, so this
# only ever fires for a hand-run show/ack.
#
# Candidates in order, first one that already HAS reports wins - existence of
# a report directory is the only evidence available about which path
# bin/dejima was actually invoked with, and the three candidates can
# genuinely differ:
#   1. the enclosing repo's toplevel (the ordinary case, and from a subdir);
#   2. the MAIN worktree root, when cwd is a linked worktree - the sandbox's
#      own .worktrees/<branch> workflow keys reports to the parent repo;
#   3. $PWD, which covers a non-git directory and the case where the path
#      bin/dejima was given (logical, via `cd && pwd`) differs from git's
#      physical toplevel because of a symlinked path component.
# Falling back to candidate 1 when none of them has reports is purely so the
# "no reports for X" message can name a concrete path: a wrong guess must be
# visible rather than silent.
resolve_ws() {
    local given="$1" top common main c
    if [ -n "$given" ]; then
        ( cd "$given" 2>/dev/null && pwd ) || printf '%s' "$given"
        return
    fi
    top="$(git rev-parse --show-toplevel 2>/dev/null)" || top=""
    main=""
    common="$(git rev-parse --git-common-dir 2>/dev/null)" || common=""
    if [ -n "$common" ]; then
        common="$(readlink -f "$common" 2>/dev/null)" || common=""
        [ -n "$common" ] && main="$(dirname "$common")"
    fi
    for c in "$top" "$main" "$PWD"; do
        [ -n "$c" ] || continue
        # A bare slug directory is no longer proof of a report - `snapshot`
        # now creates one's .staging/ subdir for every workspace it runs
        # against, report or not. Only an actual report is evidence of which
        # path bin/dejima was invoked with.
        select_report "$AUDIT_DIR/$(ws_slug "$c")" >/dev/null 2>&1 || continue
        printf '%s' "$c"
        return
    done
    printf '%s' "${top:-$PWD}"
}
ws="$(resolve_ws "$ws_arg")"

# Retention of pre-session CONTENT (as bounded diffs) is separable from the
# audit itself: an operator who wants zero content at rest sets this off and
# still gets every finding, just without before/after.
DIFFS_ENABLED="$(config_get_bool audit diffs)"

# Per-file cap on what is staged. Bounded because staging is the one place
# WHOLE files (rather than diffs) exist on disk, so its size is the size of
# the exposure if a session is SIGKILLed before compare can clear it.
STAGE_FILE_CAP=1048576

# Set only by `snapshot`, deliberately. `compare` calls hash_paths() too, to
# build the after-side; if this were set there, that call would overwrite the
# staged BEFORE content with the AFTER content and every diff would come out
# empty.
STAGE_DIR=""

# Filename for a raw namespaced id in the staging and sidecar directories.
# Hashed rather than encoded because these are real filenames: an id can be
# any length and contain '/', and enc_id's output for an ordinary path still
# does.
id_key() { printf '%s' "$1" | sha256sum | cut -d' ' -f1; }

# Surfaces whose CONTENT is never retained, matched on the workspace-relative
# path. These hold credentials by convention, and a retained diff of one
# would put them in a store that outlives the session.
#
# .claude/settings.json is deliberately NOT here: it is the shared, commonly
# committed file, and it is also a CRITICAL surface whose diffs are worth
# having. The `.local` convention is what marks the personal one.
#
# This is the reliable half of the secret defence; looks_secret() (used at
# promote time) is the best-effort half.
diff_denied() {
    local id="${1#tcb:}"
    case "$id" in
        .envrc|.mcp.json|.claude/settings.local.json) return 0 ;;
    esac
    # Basename match, not exact-path: hash_paths() walks .claude/, .vscode/
    # and .git/hooks/ recursively, so a dotenv file can appear nested (e.g.
    # .claude/.env) - the exact-path arm above only ever matches the id in
    # its ORIGINAL, un-nested form, and never would.
    case "${id##*/}" in
        .env|.env.*) return 0 ;;
    esac
    return 1
}

# The audit store is only beyond the sandbox's reach while it sits outside
# the mounted workspace - inside it, it lands in the read-write
# ${WORKSPACE_DIR}:${WORKSPACE_DIR} mount, where a session can read the
# retained content of every earlier run and delete the evidence of its own.
# bin/dejima already WARNS about this; for retained content it is a hard gate,
# because the whole premise of storing bytes here is that the container
# cannot read them.
store_reachable() {
    local d rws rd
    # Canonicalised, not raw: symlinks and `..` in either side would otherwise
    # never match the "$rws"/* pattern below and would stage straight into the
    # container's read-write mount. (A *relative* store used to be the sharper
    # case here; the config's "path" type now refuses one outright, so it
    # cannot reach this function at all.) `-m`, not
    # `-f`: `$AUDIT_DIR` routinely doesn't exist yet on a fresh install (its
    # parent tree is only ever mkdir -p'd on a real finding or by `ack`), and
    # `-f` requires every component but the last to exist - it would fail
    # there on every clean-history host, permanently disabling staging via
    # the fail-closed branch below. `-m` resolves what exists and treats the
    # rest literally, which is exactly this comparison's semantics. A failed
    # canonicalisation (now essentially just a malformed/empty path) is
    # treated as reachable so this still fails closed.
    rws="$(readlink -m "$ws" 2>/dev/null)" || return 0
    for d in "$AUDIT_DIR" "$BASELINE_DIR"; do
        rd="$(readlink -m "$d" 2>/dev/null)" || return 0
        case "$rd/" in "$rws"/*) return 0 ;; esac
    done
    return 1
}

# Field 22 of /proc/<pid>/stat is the process start time in clock ticks.
# Fields 1 and 2 are the pid and the comm, and comm is parenthesised and may
# itself contain spaces and ')' - so everything up to and including the LAST
# ') ' is stripped first, after which starttime is field 20.
proc_starttime() {
    local st rest
    [ -r "/proc/$1/stat" ] || return 1
    st="$(cat "/proc/$1/stat" 2>/dev/null)" || return 1
    rest="${st##*) }"
    set -- $rest
    [ "$#" -ge 20 ] || return 1
    printf '%s' "${20}"
}

# pid:starttime of the process that owns a staging directory - bin/dejima,
# which lives for the whole session (this script exits immediately). The
# start time is what makes it exact: a bare pid could be reused by an
# unrelated process and make a dead owner look alive forever.
owner_token() {
    local st
    st="$(proc_starttime "$PPID")" || return 1
    printf '%s:%s' "$PPID" "$st"
}

# Remove staging directories left behind by sessions that died without
# running `compare` - SIGKILL, an OOM kill, or power loss, none of which run
# bin/dejima's EXIT trap. Confined to a directory inside our own 0700 store,
# so unlike a /tmp sweep it can never touch a path another local user
# controls.
reap_staging() {
    local root="$1" d owner pid start
    for d in "$root"/*/; do
        [ -d "$d" ] || continue
        owner="$(cat "$d/.owner" 2>/dev/null)" || owner=""
        pid="${owner%%:*}"; start="${owner#*:}"
        if [ -n "$owner" ] && [ "$pid" != "$owner" ] && [ -n "$pid" ]; then
            # Owner recorded: reap only if it is provably gone. A live owner
            # is a concurrent session whose staging must survive.
            [ "$(proc_starttime "$pid" 2>/dev/null)" = "$start" ] && continue
            rm -rf "$d"
            continue
        fi
        # No usable owner record: liveness is undecidable, so fall back to
        # age rather than guessing. 24h is far longer than any session.
        [ -n "$(find "$d" -maxdepth 0 -mmin +1440 2>/dev/null)" ] && rm -rf "$d"
    done
}

# Copy one surface's current bytes into the staging directory, to become the
# BEFORE side of a diff after the session ends. No-op unless `snapshot` set
# STAGE_DIR. Symlinks stage "-> <target>", matching what
# current_content_for_id() renders for them - the staged BEFORE bytes must
# line up with the after-side content renderer, not the hasher.
stage_entry() {
    [ -n "$STAGE_DIR" ] || return 0
    local id="$1" src="$2" key sz
    diff_denied "$id" && return 0
    key="$(id_key "$id")"
    if [ -L "$src" ]; then
        printf '%s\n' "-> $(readlink "$src")" > "$STAGE_DIR/$key" 2>/dev/null || return 0
        return 0
    fi
    [ -f "$src" ] || return 0
    sz="$(stat -c %s "$src" 2>/dev/null)" || return 0
    [ "$sz" -le "$STAGE_FILE_CAP" ] || return 0
    cp -- "$src" "$STAGE_DIR/$key" 2>/dev/null || rm -f "$STAGE_DIR/$key"
    return 0
}

# Create this session's staging directory and return its path, or nothing if
# retention is off, the store is sandbox-reachable, or the store cannot be
# written. Every one of those degrades to "no diffs", never to an error.
open_staging() {
    local root token d
    [ "$DIFFS_ENABLED" = "1" ] || return 0
    store_reachable && return 0
    root="$AUDIT_DIR/$(ws_slug "$ws")/.staging"
    ( umask 077; mkdir -p "$root" ) 2>/dev/null || return 0
    reap_staging "$root"
    d="$( umask 077; mktemp -d "$root/XXXXXX" 2>/dev/null )" || return 0
    [ -n "$d" ] || return 0
    token="$(owner_token)" && printf '%s\n' "$token" > "$d/.owner" 2>/dev/null
    printf '%s' "$d"
}

# Caps on a RETAINED diff. Separate from DISPLAY_LINE_CAP (what the operator
# sees): this one bounds what sits on disk after the session.
DIFF_LINE_CAP=200
DIFF_BYTE_CAP=65536

# Total retained-diff bytes one report may hold. Fixed, not configurable, in
# the same spirit as CRIT_CAP/WARN_CAP - and like CRIT_CAP's overflow,
# spending it is a finding rather than a tuning problem: more changed
# host-persistence surfaces in one session than there is room to keep the
# evidence for is itself abnormal, so both the report and the exit-time
# summary say so.
RETAIN_BUDGET=1048576

# Set only by `compare`, from the state file's ### staging line: where this
# session's BEFORE content was staged. Distinct from STAGE_DIR (write side)
# so that compare's own call to hash_paths() cannot overwrite the before
# content with the after content.
BEFORE_DIR=""

# The retained-diff directory for a report. Derived with the -CRITICAL suffix
# stripped first, so `ack`'s rename of a fully-approved report (which drops
# that suffix) does not orphan the sidecar it was using a moment earlier.
sidecar_dir() {
    local r="$1"
    r="${r%-CRITICAL.txt}"; r="${r%.txt}"
    printf '%s.d' "$r"
}

# Best-effort credential detection over a generated diff, run before it is
# promoted. This is the SECOND net - diff_denied() is the reliable one - and
# it has real false negatives. False positives only cost a withheld diff, so
# it is deliberately broad.
#
# Case-INSENSITIVE, and that is load-bearing rather than cosmetic: the
# canonical shape of a credential in the one high-value surface this is the
# only net for is UPPERCASE. .claude/settings.json is deliberately outside
# diff_denied() (it is the shared, committed file - see there), and its `env`
# block is exactly where GITLAB_TOKEN/NPM_TOKEN/... live, so a case-sensitive
# keyword match put live tokens in the store in cleartext.
looks_secret() {
    LC_ALL=C grep -qiE \
        'sk-ant-|sk-proj-|ghp_|gho_|github_pat_|glpat-|xox[baprs]-|AIza|AKIA[0-9A-Z]{16}|_authToken|Authorization:[[:space:]]*Bearer|-----BEGIN [A-Z ]*PRIVATE KEY-----|(api[_-]?key|apikey|secret|token|passwd|password)[[:space:]"'"'"']*[:=][[:space:]"'"'"']*[^[:space:]"'"'"']{8,}|[A-Za-z0-9+/]{40,}={0,2}' \
        "$1"
}

# A file is binary if it contains a NUL. diff's own output for such a file is
# useless ("Binary files differ"), and retaining it would be retaining bytes
# nobody can read at the prompt.
is_binary() {
    local total stripped
    total="$(wc -c < "$1" 2>/dev/null)" || return 1
    stripped="$(tr -d '\000' < "$1" 2>/dev/null | wc -c)" || return 1
    [ "$total" != "$stripped" ]
}

withhold() { printf '%s\n' "$2" > "$1" 2>/dev/null || true; }

# Was this surface present in the pre-session snapshot? Answered from the
# state file, NOT from "is there a staged before-copy": staging is also empty
# for a denylisted surface (never staged at all) and for one over
# STAGE_FILE_CAP, so the staging test would label a MODIFIED .envrc as newly
# created - the one label that promises there is no earlier version to
# compare against.
existed_before() {
    local rid="$1" range enc
    case "$rid" in
        statusline:*) range='/^### statusline/,$p';           enc="$(enc_id "${rid#statusline:}")" ;;
        tcb:*)        range='/^### tcb/,/^### statusline/p';   enc="$(enc_id "${rid#tcb:}")" ;;
        *)            range='/^### paths/,/^### projects/p';   enc="$(enc_id "$rid")" ;;
    esac
    sed -n "$range" "$state" | grep -v '^### ' | cut -f1 | grep -qxF -- "$enc"
}

# Bound, screen and retain one diff. Shared by both promote paths - they
# differ only in where the BEFORE side comes from, and a second copy of these
# caps would be a second place for them to drift.
write_diff() {
    local before="$1" cur="$2" sc="$3" key="$4" d sz
    d="$(mktemp)" || return 0
    # Bounded AT generation, not after it: everything over the cap is
    # discarded anyway, and `compare` runs from bin/dejima's EXIT trap, so
    # letting diff write the whole thing first would put an unbounded,
    # session-chosen number of bytes into $TMPDIR (frequently a tmpfs, i.e.
    # host RAM) on every session exit just to produce a marker. One byte past
    # the cap, so the over-cap test below still trips.
    diff -U2 --label 'before (pre-session)' --label 'current' "$before" "$cur" 2>/dev/null \
        | head -c "$(( DIFF_BYTE_CAP + 1 ))" > "$d"
    sz="$(wc -c < "$d")" || sz=0
    if [ "$sz" -eq 0 ]; then
        # An empty diff is worse than none: Task 6 prefers the retained diff
        # over live content, so a 0-byte file would show the operator a blank
        # before/after for a real finding. It happens for a git config key
        # whose config-file TEXT changed while its parsed value did not - a
        # re-quoted value, say - which the raw-line comparison in `compare`
        # reports as a change and unquote_value() then flattens back to
        # equal. Say the comparison came out empty instead of silently
        # showing nothing.
        withhold "$sc/$key.withheld" "before and after compared equal - the change is not visible in a line diff; compare by hand"
    elif [ "$(wc -l < "$d")" -gt "$DIFF_LINE_CAP" ] || [ "$sz" -gt "$DIFF_BYTE_CAP" ]; then
        withhold "$sc/$key.withheld" "change too large to retain - compare by hand"
    elif looks_secret "$d"; then
        withhold "$sc/$key.withheld" "change appears to contain a credential - diff not retained"
    elif [ "$(( retain_spent + sz ))" -gt "$RETAIN_BUDGET" ]; then
        withhold "$sc/$key.withheld" "retention budget for this report is spent - compare by hand"
        retain_squeezed=$(( retain_squeezed + 1 ))
    else
        if cp -- "$d" "$sc/$key.diff" 2>/dev/null; then
            retain_spent=$(( retain_spent + sz ))
        else
            rm -f "$sc/$key.diff"
        fi
    fi
    rm -f "$d"
    return 0
}

# A git config key is not staged: its pre-session key=value is already in the
# state file, so the before side is read straight out of it.
promote_gitconfig() {
    local rid="$1" sc="$2" key="$3" ckey="${1#gitconfig:}" before cur l
    before="$(mktemp)" || return 0
    { while IFS= read -r l; do
          [ "${l%%=*}" = "$ckey" ] || continue
          printf '%s\n' "$(unquote_value "${l#*=}")"
      done < <(sed -n '/^### gitconfig/,/^### paths/p' "$state" | grep -v '^### '); } > "$before"
    if [ ! -s "$before" ]; then
        : > "$sc/$key.new" 2>/dev/null || true
        rm -f "$before"; return 0
    fi
    # git resolves a multi-valued key to its LAST value in FILE order, and
    # nothing here can say which that is: git_config_snapshot sorts, so last
    # in this list is lexicographically last, not the value git will run.
    # Neither side of such a comparison is therefore trustworthy, and the
    # loop above collects EVERY pre-session value - so with two of them the
    # diff read as "the second one was removed" when nothing was removed at
    # all, while the value the session appended (the one git now executes)
    # appeared nowhere in it. Refuse to compare rather than show the operator
    # a diff over values git does not use.
    if [ "$(wc -l < "$before")" -gt 1 ] \
       || [ "$(gitconfig_count_for_key "$ws" "$ckey")" -gt 1 ]; then
        withhold "$sc/$key.withheld" "this key has multiple values and git uses the last - compare by hand"
        rm -f "$before"; return 0
    fi
    cur="$(mktemp)" || { rm -f "$before"; return 0; }
    if current_content_for_id "$rid" > "$cur" 2>/dev/null; then
        write_diff "$before" "$cur" "$sc" "$key"
    else
        # Defensive duplicate of promote_finding's existence check, which
        # already ran for this id: only a key unset in the microseconds since
        # reaches here. Without it the diff below would retain the whole
        # former value, which is the one thing a removed surface must not do.
        : > "$sc/$key.removed" 2>/dev/null || true
    fi
    rm -f "$before" "$cur"
    return 0
}

# Write exactly one sidecar entry for one finding. Every path here degrades
# to a marker rather than failing: this runs from bin/dejima's EXIT trap and
# must never change the session's exit status.
promote_finding() {
    local rid="$1" sc="$2" key before cur src csz
    key="$(id_key "$rid")"

    if store_reachable; then
        withhold "$sc/$key.withheld" "audit store is inside the mounted workspace - retention disabled"
        return 0
    fi
    # Existence is settled first, for EVERY namespace (current_sha_for_id
    # dispatches, including to the git config keys promote_gitconfig handles
    # below) - one tested branch rather than one per namespace.
    if [ -z "$(current_sha_for_id "$rid")" ]; then
        # Gone now. A deletion diff is the entire former file, which is the
        # whole-file dump this design avoids - and a surface that no longer
        # exists no longer runs.
        : > "$sc/$key.removed" 2>/dev/null || true
        return 0
    fi
    case "$rid" in
        gitconfig:*) promote_gitconfig "$rid" "$sc" "$key"; return 0 ;;
    esac

    # Novelty is settled before the denylist, because its answer is a marker
    # with no content in it - a denied surface still gets an honest "this is
    # new".
    if ! existed_before "$rid"; then
        # New this session: there is no before, and the after is live on disk
        # for `ack` to read. Nothing to store.
        : > "$sc/$key.new" 2>/dev/null || true
        return 0
    fi
    if diff_denied "$rid"; then
        withhold "$sc/$key.withheld" "secret-bearing surface - diff not retained"
        return 0
    fi

    before="$BEFORE_DIR/$key"
    if [ ! -f "$before" ]; then
        # It existed before but was not staged: over STAGE_FILE_CAP, staging
        # unavailable this run, or a copy that failed. Say so rather than
        # claiming it is new.
        withhold "$sc/$key.withheld" "no pre-session copy - compare by hand"
        return 0
    fi
    # The after side gets the same cap the before side got at staging time,
    # and - like there - it is checked BEFORE any copy is taken. `compare`
    # runs from bin/dejima's EXIT trap and this size is the session's own
    # choice, so copying first would let any session turn "I filled my own
    # workspace" into that many bytes written to $TMPDIR (frequently a tmpfs,
    # i.e. host RAM) at every exit, and into a whole copy of the file left
    # sitting there if that exit was the SIGKILL case rm -f never survives.
    # Mirrors current_content_for_id's dispatch; gitconfig ids never reach
    # here (promote_gitconfig returned above), and stat does not follow a
    # symlink, whose rendering is its target string rather than its content.
    case "$rid" in
        statusline:*) src="$STATUSLINE_PATH" ;;
        tcb:*)        src="$ws/${rid#tcb:}" ;;
        *)            src="$ws/$rid" ;;
    esac
    csz="$(stat -c %s "$src" 2>/dev/null)" || csz=0
    if [ "$csz" -gt "$STAGE_FILE_CAP" ]; then
        withhold "$sc/$key.withheld" "change too large to retain - compare by hand"
        return 0
    fi
    cur="$(mktemp)" || return 0
    current_content_for_id "$rid" > "$cur" 2>/dev/null
    if is_binary "$before" || is_binary "$cur"; then
        withhold "$sc/$key.withheld" "binary content - diff not retained"
    else
        write_diff "$before" "$cur" "$sc" "$key"
    fi
    rm -f "$cur"
    return 0
}

# Two acknowledgement forms, deliberately distinct:
#   spam <id>         - this changes routinely; count it, never list it.
#                       Refused for CRITICAL surfaces (see `ack`).
#   safe <id> <sha>   - this exact content is approved; anything else
#                       re-fires at full severity. The only form permitted
#                       for CRITICAL, so approving a hook today does not
#                       approve a different hook tomorrow.
baseline_suppresses() {
    local id="$1" sha="$2" bf verb rest bid bsha eid
    bf="$BASELINE_DIR/$(ws_slug "$ws")"
    [ -f "$bf" ] || return 1
    # Callers pass the RAW id; the baseline file stores the encoded form (see
    # enc_id). Encoded once here, outside the loop - it does not vary per
    # line, and this runs for every finding. For an ordinary id the encoding
    # is the identity, so baseline files written before this existed keep
    # matching unchanged.
    eid="$(enc_id "$id")"
    while read -r verb rest; do
        case "$verb" in ''|'#'*) continue ;; esac
        # An id may itself contain spaces (e.g. "file 2.md"), so it can't be
        # split off with a fixed field count - a naive `read verb id sha`
        # would truncate such an id at its first space and could then
        # collide with a shorter, unrelated real path of that truncated
        # name, silently suppressing a finding no one acknowledged. spam has
        # no trailing sha field, so its id is everything after the verb;
        # safe's sha is fixed-position-last, so its id is recovered by
        # stripping the last whitespace-separated field from the right.
        case "$verb" in
            spam) bid="$rest"; bsha="" ;;
            safe) case "$rest" in
                      *' '*) bsha="${rest##* }"; bid="${rest% *}" ;;
                      *)     continue ;;   # malformed: no sha field
                  esac ;;
            *)    continue ;;              # unknown verb
        esac
        [ "$bid" = "$eid" ] || continue
        case "$verb" in
            # `ack` refusing to write `spam` for a CRITICAL surface is
            # convenience; this is the actual boundary - it holds even
            # against a hand-edited or corrupted baseline file.
            spam) [ "$(id_severity "$id")" = CRITICAL ] && return 1; return 0 ;;
            safe) [ -n "$sha" ] && [ "$bsha" = "$sha" ] && return 0 ;;
        esac
    done < "$bf"
    return 1
}

# git config keys whose values run a command on the next git invocation, or
# (include.path/includeif.*.path) indirect to another config file that could
# set one - key names are case-insensitive in git, so match on a lowercased
# copy.
is_exec_key() {
    local key; key="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    case "$key" in
        core.hookspath|core.fsmonitor|core.sshcommand|credential.helper) return 0 ;;
        core.pager|core.editor|sequence.editor|gpg.program|diff.external) return 0 ;;
        pager.*) return 0 ;;
        filter.*.smudge|filter.*.clean|filter.*.process) return 0 ;;
        diff.*.textconv|diff.*.command) return 0 ;;
        merge.*.driver) return 0 ;;
        include.path|includeif.*.path) return 0 ;;
    esac
    return 1
}

# Severity of a monitored workspace-relative path, derived from the surface
# alone - never from content. CRITICAL means "runs unsandboxed host code the
# next time the operator uses this repo", which is decidable from a fixed
# list. .vscode/tasks.json and launch.json are CRITICAL wholesale rather than
# parsed for runOn:folderOpen: a JSON parser on the trust boundary costs more
# than the false positives do.
path_severity() {
    case "$1" in
        .envrc|.mcp.json)                                    echo CRITICAL ;;
        .git/hooks/*)                                        echo CRITICAL ;;
        .claude/settings.json|.claude/settings.local.json)   echo CRITICAL ;;
        .vscode/tasks.json|.vscode/launch.json)              echo CRITICAL ;;
        .claude/*|.vscode/*)                                 echo WARNING ;;
        *)                                                   echo INFO ;;
    esac
}

# Severity of any acknowledgeable finding id, namespaced or bare-path (see
# baseline_suppresses' CRITICAL guard below). Bare ids (no known namespace
# prefix) are workspace-relative paths, handled by path_severity. The
# alias.* case is deliberately conservative: the audit only classifies a
# `!`-prefixed alias value as CRITICAL, but an id alone can't say whether the
# value started with `!`, so any alias is treated as CRITICAL for
# suppression purposes.
id_severity() {
    local k
    case "$1" in
        gitconfig:*) k="${1#gitconfig:}"; k="${k#worktree:}"
                     is_exec_key "$k" && { echo CRITICAL; return; }
                     case "$k" in alias.*) echo CRITICAL ;; *) echo WARNING ;; esac ;;
        statusline:*|tcb:*) echo CRITICAL ;;
        *) path_severity "$1" ;;
    esac
}

# Every finding interpolates workspace-controlled text (paths, config values)
# into a terminal. A planted value containing C0 escapes can scroll, clear or
# overwrite the report; C1 controls and Unicode bidi overrides/isolates
# (U+202A-U+202E, U+2066-U+2069) can visually reverse or reorder the
# displayed text without touching the bytes an operator would grep for - so
# strip all of these at the display boundary, after all parsing and
# TAB-splitting is done.
sanitize() {
    printf '%s' "$1" | LC_ALL=C tr -d '\000-\037\177' \
        | LC_ALL=C sed $'s/\xc2[\x80-\x9f]//g; s/\xe2\x80[\xaa-\xae]//g; s/\xe2\x81[\xa6-\xa9]//g'
}

# sanitize() is lossy, so it must never be what an ID passes through.
#
# `ack` derives the baseline id it records from the report's text, and the
# next `compare` matches that id against the RAW bytes on disk. An id
# containing anything sanitize() strips therefore could not round-trip at
# all: the surface stayed permanently unsuppressible and its report
# permanently unclearable, so bin/dejima's startup warning fired forever -
# the alert fatigue this whole feature exists to end, reached from the other
# side. Ids are encoded instead, and the encoded form is canonical
# everywhere it is written down: in the report AND in the baseline file.
#
# An id that survives sanitize() unchanged is already display-safe and is
# written verbatim - that is every ordinary id, so reports and existing
# baseline files are byte-for-byte what they were. Anything else is
# hex-encoded behind a marker, which is ASCII by construction and reverses
# exactly.
#
# An id that merely LOOKS encoded is encoded too, so that decoding stays
# unambiguous: the marker's presence always means this encoder put it there.
# Without that, a workspace could present an id that `ack` decoded into one
# of the attacker's choosing - baselining something other than the finding
# while still counting it acknowledged, the same shape as the id-derivation
# hijacks the anchored case arms in `ack` guard against. Only the START of
# an id is significant, and no monitored path can begin with the marker
# (they are all rooted at .claude/.vscode/.git/.envrc/.mcp.json), but a git
# config section name is free text in a file the session can write and the
# audit parses that file directly rather than through git.
#
# The encoded form is also the honest rendering. sanitize() DELETES those
# bytes, so a planted ".git/hooks/pre<U+202E>commit" displayed as
# "precommit" sends an operator grepping for a name no file on disk has.
HEX_MARK='{hex}'
enc_id() {
    local v="$1"
    # Fast path, and the only one an ordinary id ever takes: decide with
    # pattern matching alone, no subprocesses. hash_paths() calls this once
    # per monitored file on both the snapshot and the compare side, so the
    # exact check below - a subshell plus tr plus sed - is far too expensive
    # to run unconditionally (a bare `git init` alone ships ~14 sample
    # hooks).
    #
    # `local LC_ALL=C` puts bash's own matching into byte semantics for the
    # duration, so [[:cntrl:]] is exactly C0+DEL. Any C1 or bidi character
    # must contain the UTF-8 lead byte \302 or \342 respectively, so testing
    # for those catches every one. The test is deliberately conservative
    # rather than exact - ordinary text carrying one of those lead bytes (an
    # em dash, say) falls through to the exact check and is then found
    # clean and printed verbatim, which costs a little time and changes
    # nothing.
    local LC_ALL=C
    case "$v" in
        "$HEX_MARK"*) ;;
        *[[:cntrl:]]*|*$'\302'*|*$'\342'*) ;;
        *) printf '%s' "$v"; return ;;
    esac
    if [ "$(sanitize "$v")" = "$v" ]; then
        case "$v" in "$HEX_MARK"*) ;; *) printf '%s' "$v"; return ;; esac
    fi
    printf '%s%s' "$HEX_MARK" "$(printf '%s' "$v" | od -An -tx1 | tr -d ' \n')"
}
# Inverse of enc_id. Built with parameter expansion and one printf rather
# than a pipeline, so no command substitution inside can eat a trailing
# byte. printf '%b' consumes the escapes left to right in a single pass,
# which is what makes "\\x41" decode to a literal backslash followed by x41
# instead of to "A".
dec_id() {
    local h="$1" esc=""
    case "$h" in
        "$HEX_MARK"*) h="${h#"$HEX_MARK"}" ;;
        *) printf '%s' "$h"; return ;;
    esac
    while [ -n "$h" ]; do esc="$esc\\x${h:0:2}"; h="${h:2}"; done
    printf '%b' "$esc"
}

# Undo git's config-file quoting of a value (git wraps values containing
# special chars in "..." and backslash-escapes embedded \ and ") so exec
# detection sees the real value instead of a quoted literal.
unquote_value() {
    local v="$1"
    case "$v" in
        \"*\")
            v="${v#\"}"; v="${v%\"}"
            v="${v//\\\"/\"}"
            v="${v//\\\\/\\}"
            ;;
    esac
    printf '%s' "$v"
}

# Hash a regular file's content, or a symlink's target path string (so a
# repointed symlink is caught even though the link's own inode doesn't
# change and its target may not exist to read content from).
hash_entry() {
    local f="$1"
    if [ -L "$f" ]; then
        printf '%s' "$(readlink "$f")" | sha256sum | cut -d' ' -f1
    else
        sha256sum "$f" | cut -d' ' -f1
    fi
}

hash_value() {
    printf '%s' "$1" | sha256sum | cut -d' ' -f1
}

hash_paths() {
    # encoded-path<TAB>sha for each existing monitored path, sorted by path.
    #
    # Encoded (see enc_id) rather than raw, because this record is itself
    # TAB-delimited and line-based: a filename containing a TAB would
    # otherwise be silently truncated at it by the `cut -f1` that reads this
    # back, and reported under a name no file on disk has - unackable for
    # exactly the reason enc_id exists, and CRITICAL if the truncation still
    # lands under .git/hooks/. TAB and newline are both in the set enc_id
    # encodes, so an encoded path can never contain either. Ordinary paths
    # encode to themselves, so this record is unchanged for them.
    local ws="$1" p
    {
        for p in .mcp.json .envrc; do
            [ -f "$ws/$p" ] && { stage_entry "$p" "$ws/$p"; printf '%s\t%s\n' "$(enc_id "$p")" "$(hash_entry "$ws/$p")"; }
        done
        for dir in .claude .vscode .git/hooks; do
            if [ -d "$ws/$dir" ]; then
                while IFS= read -r -d '' f; do
                    stage_entry "${f#"$ws"/}" "$f"
                    printf '%s\t%s\n' "$(enc_id "${f#"$ws"/}")" "$(hash_entry "$f")"
                done < <(find "$ws/$dir" \( -type f -o -type l \) -print0)
            fi
        done
    } | sort
}

tcb_snapshot() {
    # encoded-path<TAB>sha for the sandbox's own trusted computing base, but
    # only when $ws IS the sandbox's repo (self-mount) - see AUDIT_REPO_ROOT.
    # Empty otherwise, so a normal (non-self) workspace is unaffected.
    # Encoded for the same reason as hash_paths above.
    local ws="$1" p
    [ "$(readlink -f "$ws" 2>/dev/null)" = "$AUDIT_REPO_ROOT" ] || return 0
    {
        for p in install.sh; do
            [ -f "$ws/$p" ] && { stage_entry "tcb:$p" "$ws/$p"; printf '%s\t%s\n' "$(enc_id "$p")" "$(hash_entry "$ws/$p")"; }
        done
        for dir in bin hooks docker test; do
            if [ -d "$ws/$dir" ]; then
                while IFS= read -r -d '' f; do
                    stage_entry "tcb:${f#"$ws"/}" "$f"
                    printf '%s\t%s\n' "$(enc_id "${f#"$ws"/}")" "$(hash_entry "$f")"
                done < <(find "$ws/$dir" \( -type f -o -type l \) -print0)
            fi
        done
    } | sort
}

git_config_snapshot() {
    # Parse the raw config file(s) instead of `git config --list`, which
    # lowercases key names (core.hooksPath -> core.hookspath) and would hide
    # the exact key a session set.
    local ws="$1" f pfx
    for f in "$ws/.git/config" "$ws"/.git/worktrees/*/config.worktree; do
        [ -f "$f" ] || continue
        case "$f" in
            "$ws"/.git/worktrees/*) pfx="worktree:" ;;
            *) pfx="" ;;
        esac
        awk -v pfx="$pfx" '
            function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
            /^[ \t]*[#;]/ { next }
            /^[ \t]*\[/ {
                line = trim($0)
                sub(/^\[/, "", line); sub(/\][ \t]*$/, "", line)
                if (match(line, /"/)) {
                    sect = trim(substr(line, 1, RSTART - 1))
                    rest = line
                    sub(/^[^"]*"/, "", rest)
                    sub(/"[ \t]*$/, "", rest)
                    section = sect "." rest
                } else {
                    section = line
                }
                next
            }
            /=/ {
                line = trim($0)
                eq = index(line, "=")
                key = trim(substr(line, 1, eq - 1))
                val = trim(substr(line, eq + 1))
                print pfx section "." key "=" val
            }
        ' "$f"
    done | sort
}

# The sha ack/baseline_suppresses use for a gitconfig:<key> id: the value
# currently set for that exact key (worktree: prefix included, as parsed by
# git_config_snapshot), hashed the same way compare does. Empty (and a
# failing return) if the key no longer exists.
gitconfig_sha_for_key() {
    local ws="$1" key="$2" line lkey
    while IFS= read -r line; do
        lkey="${line%%=*}"
        [ "$lkey" = "$key" ] || continue
        hash_value "$(unquote_value "${line#*=}")"
        return 0
    done < <(git_config_snapshot "$ws")
    return 1
}

# The sha ack writes for any acknowledgeable id, dispatched by namespace -
# mirrors id_severity's dispatch and the hash each compare loop computes for
# that namespace, so the id/sha pair ack records is exactly what
# baseline_suppresses will later compare against.
current_sha_for_id() {
    local id="$1" f
    case "$id" in
        gitconfig:*)  gitconfig_sha_for_key "$ws" "${id#gitconfig:}"; return ;;
        statusline:*) f="$STATUSLINE_PATH" ;;
        tcb:*)        f="$ws/${id#tcb:}" ;;
        *)            f="$ws/$id" ;;
    esac
    # -e alone follows a symlink and misses one whose target is gone - but a
    # dangling symlink is exactly what hash_entry() below can still hash (the
    # link's target string, never the target's content), so excluding it here
    # would make this function and current_content_for_id disagree about
    # whether the surface still exists.
    { [ -e "$f" ] || [ -L "$f" ]; } && hash_entry "$f"
}

# How many lines of content or diff `ack` prints before truncating. Fixed,
# like CRIT_CAP/WARN_CAP: a predictable prompt is worth more than tunability,
# and the truncation notice names the real paths so the full text is one
# command away.
DISPLAY_LINE_CAP=40

# Live content of a raw namespaced id, mirroring current_sha_for_id's
# dispatch arm for arm so that what is DISPLAYED and what gets PINNED can
# never disagree about the meaning of "this exact content". Symlinks render
# as their target, because that is what hash_entry() hashes for them - the
# link's own content is not what changed.
current_content_for_id() {
    local id="$1" f
    case "$id" in
        gitconfig:*)  gitconfig_value_for_key "$ws" "${id#gitconfig:}" ;;
        statusline:*) f="$STATUSLINE_PATH" ;;
        tcb:*)        f="$ws/${id#tcb:}" ;;
        *)            f="$ws/$id" ;;
    esac
    case "$id" in gitconfig:*) return ;; esac
    [ -e "$f" ] || [ -L "$f" ] || return 1
    if [ -L "$f" ]; then
        printf '%s\n' "-> $(readlink "$f")"
    else
        cat -- "$f" 2>/dev/null || return 1
    fi
}

# The raw (unquoted) value currently set for a git config key, or a failing
# return if the key is gone. Same parse as gitconfig_sha_for_key, which
# hashes this exact string.
gitconfig_value_for_key() {
    local ws="$1" key="$2" line lkey
    while IFS= read -r line; do
        lkey="${line%%=*}"
        [ "$lkey" = "$key" ] || continue
        printf '%s\n' "$(unquote_value "${line#*=}")"
        return 0
    done < <(git_config_snapshot "$ws")
    return 1
}

# How many values a git config key currently holds. Only ever compared
# against 1: more than one and neither gitconfig_value_for_key above nor the
# state file's pre-session lines can say which value git will actually use
# (see promote_gitconfig).
gitconfig_count_for_key() {
    local ws="$1" key="$2" line n=0
    while IFS= read -r line; do
        [ "${line%%=*}" = "$key" ] && n=$(( n + 1 ))
    done < <(git_config_snapshot "$ws")
    printf '%s' "$n"
}

# Print a file for the operator: sanitized per line (this is
# workspace-controlled text reaching a terminal - see sanitize), indented so
# it cannot be mistaken for the audit's own output, and capped. Sanitizing
# line by line rather than whole-file keeps a planted NUL or newline run from
# collapsing separate lines into one.
show_capped() {
    local f="$1" n=0 total line
    total="$(wc -l < "$f" 2>/dev/null)" || total=0
    while IFS= read -r line; do
        n=$((n + 1))
        [ "$n" -le "$DISPLAY_LINE_CAP" ] || break
        printf '    %s\n' "$(sanitize "$line")"
    done < "$f"
    if [ "$total" -gt "$DISPLAY_LINE_CAP" ]; then
        printf '    ... +%s more line(s)\n' "$(( total - DISPLAY_LINE_CAP ))"
    fi
}

# Where the operator can read the whole thing, when the display was capped.
# Never sanitized through a path that would make it unfindable: it is the
# audit's OWN text about a location, not workspace-controlled content.
source_hint() {
    local id="$1"
    case "$id" in
        gitconfig:*)  printf '%s\n' "    (full value: git -C $ws config --get $(sanitize "${id#gitconfig:}"))" ;;
        statusline:*) printf '%s\n' "    (full text: $STATUSLINE_PATH)" ;;
        tcb:*)        printf '%s\n' "    (full text: $ws/$(sanitize "${id#tcb:}"))" ;;
        *)            printf '%s\n' "    (full text: $ws/$(sanitize "$id"))" ;;
    esac
}

# The display block for one finding, preferring the diff retained beside this
# report and degrading, in order, to: the full content of a surface that is
# new; the live content with the reason no diff was kept; and - for a report
# written before retention existed at all - the live content alone.
render_finding() {
    local id="$1" sc="$2" key tmp
    key="$(id_key "$id")"

    if [ -n "$sc" ] && [ -f "$sc/$key.diff" ]; then
        echo "  --- what changed while the session ran ---"
        show_capped "$sc/$key.diff"
        source_hint "$id"
        return 0
    fi
    if [ -n "$sc" ] && [ -f "$sc/$key.removed" ]; then
        echo "  --- this surface was removed; its pre-session content was not retained ---"
        return 0
    fi
    if [ -n "$sc" ] && [ -f "$sc/$key.withheld" ]; then
        echo "  --- no diff retained: $(sanitize "$(head -n1 "$sc/$key.withheld" 2>/dev/null)") ---"
    elif [ -n "$sc" ] && [ -f "$sc/$key.new" ]; then
        echo "  --- new surface; full current content ---"
    else
        echo "  --- no pre-session record; current content ---"
    fi

    tmp="$(mktemp)" || return 0
    if current_content_for_id "$id" > "$tmp" 2>/dev/null; then
        show_capped "$tmp"
        source_hint "$id"
    else
        echo "    (this surface no longer exists)"
    fi
    rm -f "$tmp"
    return 0
}

projects_snapshot() {
    # slug<TAB>maxmtime for each immediate subdir of PROJECTS_DIR, sorted by
    # slug; maxmtime is 0 if the slug dir has no files.
    local dir="$1" d slug mtime
    [ -d "$dir" ] || return 0
    for d in "$dir"/*/; do
        [ -d "$d" ] || continue
        slug="$(basename "$d")"
        mtime="$(find "$d" -type f -printf '%T@\n' 2>/dev/null | sort -n | tail -1)"
        mtime="${mtime%%.*}"
        printf '%s\t%s\n' "$slug" "${mtime:-0}"
    done | sort
}

statusline_snapshot() {
    # path<TAB>sha for $HOME/.claude/statusline.sh, or nothing if this host
    # has none - see STATUSLINE_PATH above for why this one path is
    # monitored on its own rather than as part of hash_paths.
    local f="$1"
    [ -e "$f" ] || return 0
    stage_entry "statusline:statusline.sh" "$f"
    printf 'statusline.sh\t%s\n' "$(hash_entry "$f")"
}

case "$cmd" in
    --print-paths)
        printf 'projects_dir=%s\nstatusline_path=%s\naudit_dir=%s\nbaselines_dir=%s\nkeep=%s\n' \
            "$PROJECTS_DIR" "$STATUSLINE_PATH" "$AUDIT_DIR" "$BASELINE_DIR" "$AUDIT_KEEP"
        exit 0
        ;;
    snapshot)
        STAGE_DIR="$(open_staging)"
        # First section, so the existing ranges (anchored at ### gitconfig
        # and ### statusline) are unaffected. Written even when empty, so
        # `compare` can tell "retention was off" from "state file predates
        # this" without guessing.
        { echo "### staging $STAGE_DIR";
          echo "### gitconfig"; git_config_snapshot "$ws";
          echo "### paths";     hash_paths "$ws";
          echo "### projects";  projects_snapshot "$PROJECTS_DIR";
          echo "### tcb";       tcb_snapshot "$ws";
          echo "### statusline"; statusline_snapshot "$STATUSLINE_PATH"; } > "$state" 2>/dev/null || true
        exit 0
        ;;
    compare)
        # cleanup() (bin/dejima) now runs this from the EXIT trap, which
        # fires on early exits too - before the workspace's mktemp'd state
        # file has ever been written to by `snapshot`. Such a file exists
        # but is empty, and treating "exists" as "has a snapshot" would diff
        # the real current state against nothing, manufacturing a finding
        # for every monitored surface already present. Empty is the same as
        # absent for that purpose, so both skip - but only a genuinely
        # missing path (not the routine mktemp'd-but-unwritten case that
        # follows every pre-snapshot fatal exit) is worth a message: that
        # case is the operator's last line on a fatal error, and printing
        # "skipping" over it would bury the real failure.
        [ -e "$state" ] || { echo "dejima audit: no snapshot to compare against, skipping." >&2; exit 0; }
        [ -s "$state" ] || exit 0

        BEFORE_DIR="$(sed -n 's/^### staging //p' "$state" | head -1)"
        # An rm -rf on a path read out of a file gets one sanity check: it
        # must sit under our own store, in the shape open_staging() produces.
        # `..` is rejected separately because `*` in a case pattern matches
        # `/` too, so the shape alone would accept a path that climbs back
        # out of the store again.
        case "$BEFORE_DIR" in
            *..*) BEFORE_DIR="" ;;
            "$AUDIT_DIR/"*/.staging/*) ;;
            *) BEFORE_DIR="" ;;
        esac
        # Owned from here on regardless of how this script leaves: an early
        # exit (no findings, or an unwritable report dir) must not leave whole
        # pre-session files staged on disk.
        cleanup_staging() { [ -n "$BEFORE_DIR" ] && rm -rf -- "$BEFORE_DIR"; return 0; }
        trap cleanup_staging EXIT

        new="$(mktemp)"; { echo "### gitconfig"; git_config_snapshot "$ws";
                           echo "### paths";     hash_paths "$ws";
                           echo "### projects";  projects_snapshot "$PROJECTS_DIR";
                           echo "### tcb";       tcb_snapshot "$ws";
                           echo "### statusline"; statusline_snapshot "$STATUSLINE_PATH"; } > "$new" 2>/dev/null || {
            echo "dejima audit: could not complete, skipping." >&2; rm -f "$new"; exit 0; }

        # One raw namespaced id per finding whose surface has retainable
        # content, in report order - what promote_finding() works from below.
        crit=(); warn=(); info=(); finding_ids=()
        # Retention budget accounting: bytes of diff already kept for this
        # report, how many findings were refused for want of room, and how
        # many had been dealt with when the budget ran out. budget_note is
        # the two lines both the report and the summary print when it did.
        retain_spent=0; retain_squeezed=0; retain_at=0; budget_note=()
        # config diffs: added/changed lines present in new but not old
        while IFS= read -r line; do
            key="${line%%=*}"
            key_nopfx="${key#worktree:}"
            # The key is the id-bearing half and is encoded; the value is
            # display-only and is sanitized. Splitting them keeps a value
            # full of control bytes from dragging its key into the opaque
            # hex form, where the operator could no longer read which
            # setting had changed.
            body="$(enc_id "$key")=$(sanitize "${line#*=}")"
            if is_exec_key "$key_nopfx"; then
                gid="gitconfig:$key"; gsha="$(hash_value "$(unquote_value "${line#*=}")")"
                baseline_suppresses "$gid" "$gsha" && continue
                crit+=("COMMAND-EXECUTION git config: $body")
                finding_ids+=("gitconfig:$key")
            elif [ "$key_nopfx" = "alias" ] || [[ "$key_nopfx" == alias.* ]]; then
                # alias.<name>=!cmd runs a shell command
                case "$(unquote_value "${line#*=}")" in
                    '!'*) gid="gitconfig:$key"; gsha="$(hash_value "$(unquote_value "${line#*=}")")"
                          baseline_suppresses "$gid" "$gsha" && continue
                          crit+=("COMMAND-EXECUTION git alias: $body")
                          finding_ids+=("gitconfig:$key") ;;
                    *)    warn+=("changed git config: $body") ;;
                esac
            else
                # No id recorded, for the same reason CROSS-PROJECT gets none:
                # `ack` has no arm for a plain "changed git config" line, so a
                # diff retained for one would be content at rest that nothing
                # ever reads. The report body already carries the new value.
                warn+=("changed git config: $body")
            fi
        done < <(comm -13 <(sed -n '/^### gitconfig/,/^### paths/p' "$state" | grep -vE '^### |^worktree:$') \
                          <(sed -n '/^### gitconfig/,/^### paths/p' "$new"   | grep -vE '^### |^worktree:$') )

        # path diffs: any monitored file added/changed/removed (a content
        # change emits both an old-hash and new-hash line; dedupe by path
        # so each changed path is reported once)
        while IFS= read -r line; do
            # $line arrives encoded (see hash_paths). Everything that has to
            # reach the real file, classify it, or match a baseline entry
            # needs the raw name; only the report body keeps the encoded
            # form, which is what enc_id would produce for it anyway.
            rline="$(dec_id "$line")"
            cur_sha=""
            [ -e "$ws/$rline" ] && cur_sha="$(hash_entry "$ws/$rline")"
            baseline_suppresses "$rline" "$cur_sha" && continue
            # Recorded once for all three arms below: severity decides how the
            # finding is REPORTED, not whether its content can be retained.
            finding_ids+=("$rline")
            case "$(path_severity "$rline")" in
                CRITICAL) crit+=("HOST-CODE-EXECUTION workspace file: $line") ;;
                WARNING)  warn+=("changed workspace file: $line") ;;
                # Currently unreachable: hash_paths() only monitors
                # .mcp.json/.envrc/.claude/.vscode/.git/hooks, and every path
                # under those matches an earlier CRITICAL/WARNING pattern in
                # path_severity(). Kept as the defensive default for
                # surfaces monitored by a future task.
                *)        info+=("changed workspace file: $line") ;;
            esac
        done < <(comm -3 <(sed -n '/^### paths/,/^### projects/p' "$state" | grep -v '^### ') \
                         <(sed -n '/^### paths/,/^### projects/p' "$new"   | grep -v '^### ') \
                 | sed 's/^\t//' | cut -f1 | sort -u )

        # projects diffs: a write to another project's ~/.claude/projects
        # slug during this session (transcript/memory-poisoning surface).
        # "self" = current workspace's own slug or a worktree child of it.
        current_slug="$(ws_slug "$ws")"
        while IFS= read -r line; do
            slug="${line%%$'\t'*}"
            case "$slug" in
                "$current_slug"|"$current_slug"-*) continue ;;
            esac
            warn+=("CROSS-PROJECT history/memory write: $(sanitize "$slug")")
        done < <(comm -13 <(sed -n '/^### projects/,/^### tcb/p' "$state" | grep -v '^### ') \
                          <(sed -n '/^### projects/,/^### tcb/p' "$new"   | grep -v '^### ') )

        # tcb diffs: any change under the sandbox's own trusted computing
        # base, only populated when this session's workspace IS the
        # sandbox's own repo (see tcb_snapshot) - empty/no-op otherwise.
        # Bounded at ### statusline (not $p, the last section now) so this
        # doesn't also swallow that section's lines.
        while IFS= read -r line; do
            # Encoded on arrival, same as the path loop above.
            rline="$(dec_id "$line")"
            tid="tcb:$rline"; tsha=""; [ -e "$ws/$rline" ] && tsha="$(hash_entry "$ws/$rline")"
            baseline_suppresses "$tid" "$tsha" && continue
            crit+=("TCB (sandbox self) modified: $line")
            finding_ids+=("$tid")
        done < <(comm -3 <(sed -n '/^### tcb/,/^### statusline/p' "$state" | grep -v '^### ') \
                         <(sed -n '/^### tcb/,/^### statusline/p' "$new"   | grep -v '^### ') \
                 | sed 's/^\t//' | cut -f1 | sort -u )

        # statusline diff: ~/.claude/statusline.sh added/changed/removed/
        # repointed - see STATUSLINE_PATH above for why this gets its own
        # section instead of folding into hash_paths. Worded at least as
        # strongly as COMMAND-EXECUTION/TCB above: this is unsandboxed host
        # code execution, not just a config change.
        while IFS= read -r line; do
            sid="statusline:$line"; ssha=""; [ -e "$STATUSLINE_PATH" ] && ssha="$(hash_entry "$STATUSLINE_PATH")"
            baseline_suppresses "$sid" "$ssha" && continue
            crit+=("HOST-CODE-EXECUTION statusline.sh changed (runs UNSANDBOXED on the host via settings.json statusLine.command): $(enc_id "$line")")
            finding_ids+=("$sid")
        done < <(comm -3 <(sed -n '/^### statusline/,$p' "$state" | grep -v '^### ') \
                         <(sed -n '/^### statusline/,$p' "$new"   | grep -v '^### ') \
                 | sed 's/^\t//' | cut -f1 | sort -u )

        rm -f "$new"
        total=$(( ${#crit[@]} + ${#warn[@]} + ${#info[@]} ))
        if [ "$total" -eq 0 ]; then
            exit 0
        fi

        report_dir="$AUDIT_DIR/$(ws_slug "$ws")"
        if mkdir -p "$report_dir" 2>/dev/null; then
            if [ "${#crit[@]}" -gt 0 ]; then
                report="$report_dir/$(date +%Y-%m-%d-%H%M%S)-CRITICAL.txt"
            else
                report="$report_dir/$(date +%Y-%m-%d-%H%M%S).txt"
            fi
            {
                echo "dejima audit report for $(sanitize "$ws")"
                echo "Changes below happened while this session ran - not necessarily because"
                echo "of it. A concurrent dejima/Claude Code session, or your own edits during"
                echo "the run, land in this same diff; see docs/security.md."
                [ "${#crit[@]}" -gt 0 ] && printf 'CRITICAL %s\n' "${crit[@]}"
                [ "${#warn[@]}" -gt 0 ] && printf 'WARNING  %s\n' "${warn[@]}"
                [ "${#info[@]}" -gt 0 ] && printf 'INFO     %s\n' "${info[@]}"
            } > "$report" 2>/dev/null || true

            # The one place pre-session CONTENT becomes something that
            # outlives the session, and only ever as a bounded diff or a
            # marker. 0700, since that content is the thing the sandbox was
            # not allowed to see. rmdir at the end leaves nothing behind when
            # every finding declined to retain anything.
            if [ "$DIFFS_ENABLED" = "1" ] && [ "${#finding_ids[@]}" -gt 0 ]; then
                sc="$(sidecar_dir "$report")"
                if ( umask 077; mkdir -p "$sc" ) 2>/dev/null; then
                    # umask set and restored around the loop rather than a
                    # ( umask 077; ... ) subshell, because the budget counters
                    # promote_finding updates have to survive it. Every file
                    # the loop writes is pre-session content or a statement
                    # about it, so the 0700 directory must not be the only
                    # thing keeping it off other local accounts.
                    old_umask="$(umask)"; umask 077
                    n=0
                    for rid in "${finding_ids[@]}"; do
                        n=$(( n + 1 ))
                        promote_finding "$rid" "$sc"
                        if [ "$retain_squeezed" -gt 0 ] && [ "$retain_at" -eq 0 ]; then
                            retain_at=$(( n - 1 ))
                        fi
                    done
                    umask "$old_umask"
                    rmdir "$sc" 2>/dev/null || true
                    if [ "$retain_squeezed" -gt 0 ]; then
                        budget_note=(
                            "  !! retention budget spent after $retain_at of ${#finding_ids[@]} findings."
                            "  !! that many changed host-persistence surfaces in one session is ABNORMAL."
                        )
                        printf '%s\n' "${budget_note[@]}" >> "$report" 2>/dev/null || true
                    fi
                fi
            fi

            # Oldest-first, but only clean reports are evictable: a report
            # still carrying an unacknowledged CRITICAL is retained past the
            # cap, so flushing one out cannot be achieved by inducing runs.
            # `ack` renames it to drop the suffix, which makes it evictable.
            while [ "$(find "$report_dir" -maxdepth 1 -name '*.txt' ! -name '*-CRITICAL.txt' | wc -l)" -gt "$AUDIT_KEEP" ]; do
                oldest="$(find "$report_dir" -maxdepth 1 -name '*.txt' ! -name '*-CRITICAL.txt' | sort | head -1)"
                [ -n "$oldest" ] || break
                # The report's retained diffs go with it: they are content at
                # rest whose only reason to exist is the report that cites it.
                rm -rf "$(sidecar_dir "$oldest")"
                rm -f "$oldest" || break
            done
        fi

        # Ascending severity: the operator reads bottom-up from their shell
        # prompt, so whatever prints LAST is what actually gets seen. INFO
        # collapses to a count - it exists to be counted, not read.
        {
            echo ""
            echo "================================================================"
            echo " dejima: host-persistence surfaces changed in"
            echo " $(sanitize "$ws") while this session ran"
            echo "----------------------------------------------------------------"
            if [ "${#info[@]}" -gt 0 ]; then
                echo "  ${#info[@]} routine file change(s) - not listed"
            fi
            if [ "${#warn[@]}" -gt 0 ]; then
                printf '  - %s\n' "${warn[@]:0:$WARN_CAP}"
                if [ "${#warn[@]}" -gt "$WARN_CAP" ]; then
                    echo "  + $(( ${#warn[@]} - WARN_CAP )) further change(s) not shown."
                fi
            fi
            if [ "${#crit[@]}" -gt 0 ]; then
                printf '  ! %s\n' "${crit[@]:0:$CRIT_CAP}"
                if [ "${#crit[@]}" -gt "$CRIT_CAP" ]; then
                    echo "  !! $(( ${#crit[@]} - CRIT_CAP )) FURTHER CRITICAL FINDINGS NOT SHOWN."
                    echo "  !! ${#crit[@]} critical findings in one session is ABNORMAL."
                fi
            fi
            # Last before the footer, where it is read first: running out of
            # room to keep evidence is a finding about the session, not a
            # note about the store.
            [ "${#budget_note[@]}" -gt 0 ] && printf '%s\n' "${budget_note[@]}"
            echo "----------------------------------------------------------------"
            if [ "${#crit[@]}" -gt 0 ]; then
                echo "         Review BEFORE the next 'git' or 'claude' in that repo."
                echo " dejima: ${#crit[@]} CRITICAL - code that will run on your host."
            else
                echo " dejima: no critical findings; ${#warn[@]} change(s) to review."
            fi
        } >&2
        exit 0
        ;;
    show)
        report_dir="$AUDIT_DIR/$(ws_slug "$ws")"
        report="$(select_report "$report_dir")" \
            || { echo "dejima audit: no reports for $ws" >&2; exit 0; }
        # Which report, on stderr so stdout stays the report content alone:
        # `show` no longer necessarily prints the newest one, and an operator
        # cross-referencing the run timestamps in the startup warning needs to
        # know which of them they are looking at.
        echo "dejima audit: $report" >&2
        cat "$report"
        exit 0
        ;;
    ack)
        report_dir="$AUDIT_DIR/$(ws_slug "$ws")"
        bf="$BASELINE_DIR/$(ws_slug "$ws")"
        report="$(select_report "$report_dir")" \
            || { echo "dejima audit: no reports for $ws" >&2; exit 0; }
        sc="$(sidecar_dir "$report")"
        # Removed only at the end, and only for findings actually
        # acknowledged - an abort must leave the operator exactly where they
        # were, retained diffs included.
        sc_done=()

        # Accumulate in memory and write once at the end: an ack interrupted
        # partway (q/Esc/EOF/Ctrl-C) must not leave a CRITICAL surface
        # silently approved, so every abort path discards everything rather
        # than half-writing.
        pending=(); aborted=0
        # crit_seen/crit_acked gate the -CRITICAL.txt rename below: it must
        # fire only when every CRITICAL finding in THIS report was actually
        # approved, not merely when the operator approved something. A
        # report mixing an unacknowledged CRITICAL with an approved WARNING
        # (or a non-path CRITICAL, which can never be "approved" - see
        # ackable below) must keep its suffix and stay eviction-protected.
        crit_seen=0; crit_acked=0
        # The loop below reads report lines on its own stdin (`< "$report"`),
        # so operator keystrokes are read from fd 3 - a copy of the script's
        # original stdin taken before that redirection - rather than
        # /dev/tty (which has nothing to open under piped test input; a
        # bare `read` on fd 0 would otherwise be consuming the very report
        # lines the loop is iterating). In real use fd 3 is still the
        # operator's terminal, since that's what an interactive shell hands
        # a foreground command as fd 0. Piping into `ack` therefore drives
        # approvals in both test and real use through the same code path -
        # safe, because the read-time CRITICAL guard in baseline_suppresses()
        # (a `spam` entry can never silence a CRITICAL surface) holds no
        # matter how a baseline entry got written, piped or typed.
        { exec 3<&0; } 2>/dev/null
        while IFS= read -r rline; do
            tier="${rline%% *}"
            # Report lines are column-padded by the printf that wrote them
            # (`'CRITICAL %s\n'` vs `'WARNING  %s\n'` - one vs two spaces),
            # so stripping only the first space would leave WARNING bodies
            # with a leading space that a since-anchored case match (see
            # below) would silently fail to match. Strip the exact,
            # known-fixed prefix per tier instead of a single space.
            case "$tier" in
                CRITICAL) body="${rline#CRITICAL }" ;;
                WARNING)  body="${rline#WARNING  }" ;;
                *) continue ;;
            esac
            [ "$tier" = CRITICAL ] && crit_seen=$((crit_seen + 1))
            # Derive the namespaced id baseline_suppresses() will later
            # compare against (see id_severity/current_sha_for_id above) -
            # one case arm per finding-producing loop in `compare`. Every
            # pattern is anchored to the fixed label text `compare` itself
            # emits at the START of body, never matched as a substring
            # anywhere in it: a workspace-controlled value (a git config
            # value, a path) can contain text like "workspace file: " or
            # "TCB (sandbox self) modified: " and reach $body unmodified, so
            # an unanchored match could be hijacked into deriving the wrong
            # (attacker-chosen) id for the wrong namespace - approving it
            # would then baseline an id that can never match, un-baselining
            # the real finding while still counting it as acknowledged. A
            # finding whose body matches none of these (currently only
            # CROSS-PROJECT) has no id to record, so it's shown but not
            # offered a/s.
            #
            # The id itself must then be recovered with a shortest-prefix
            # strip of that same fixed label (`${body#LABEL}`), never
            # `${body##*: }`: the latter strips up to the LAST ": " in the
            # whole string, and a workspace-controlled path can itself
            # contain a literal ": " (e.g. ".git/hooks/pre-commit: decoy"),
            # which would truncate the derived id to everything after that
            # planted separator - the case match being anchored doesn't
            # protect the extraction that follows it.
            #
            # Two forms come out of this, because the two consumers need
            # different ones (see enc_id): $id is the ENCODED id exactly as
            # the report carries it, and is what gets written to the
            # baseline file, which stores that form. $rid is the same id
            # decoded back to the raw bytes on disk, for current_sha_for_id
            # to stat and hash and for id_severity to classify. Only the
            # id-bearing portion is decoded - never the namespace prefix
            # this code adds itself.
            ackable=0; id=""; rid=""
            case "$body" in
                "HOST-CODE-EXECUTION workspace file: "*)
                    ackable=1; id="${body#HOST-CODE-EXECUTION workspace file: }"
                    rid="$(dec_id "$id")" ;;
                "changed workspace file: "*)
                    ackable=1; id="${body#changed workspace file: }"
                    rid="$(dec_id "$id")" ;;
                "COMMAND-EXECUTION git config: "*|"COMMAND-EXECUTION git alias: "*)
                    ackable=1; cfgline="${body#*: }"; ekey="${cfgline%%=*}"
                    id="gitconfig:$ekey"; rid="gitconfig:$(dec_id "$ekey")" ;;
                "HOST-CODE-EXECUTION statusline.sh changed (runs UNSANDBOXED on the host via settings.json statusLine.command): "*)
                    ackable=1; esl="${body#HOST-CODE-EXECUTION statusline.sh changed (runs UNSANDBOXED on the host via settings.json statusLine.command): }"
                    id="statusline:$esl"; rid="statusline:$(dec_id "$esl")" ;;
                "TCB (sandbox self) modified: "*)
                    ackable=1; etcb="${body#TCB (sandbox self) modified: }"
                    id="tcb:$etcb"; rid="tcb:$(dec_id "$etcb")" ;;
                *) ackable=0 ;;
            esac
            # Defence in depth: even an anchored arm above should never
            # leave id empty while claiming ackable, but don't trust that -
            # crit_acked (and thus whether a report can shed -CRITICAL.txt)
            # must only ever advance when a real, non-empty id was derived.
            [ -n "$id" ] || ackable=0
            [ -n "$rid" ] || ackable=0
            echo ""
            echo "  [$tier] $body"
            [ "$ackable" -eq 1 ] && render_finding "$rid" "$sc"
            if [ "$ackable" -ne 1 ]; then
                printf '  [c] skip  [q] quit (this finding cannot be acknowledged): '
            elif [ "$tier" = CRITICAL ]; then
                printf '  [a] approve this exact content  [c] skip  [q] quit: '
            else
                printf '  [a] approve  [s] always ignore  [c] skip  [q] quit: '
            fi
            { read -r key <&3; } 2>/dev/null || { aborted=1; break; }
            case "$key" in
                q|$'\e'|'') aborted=1; break ;;
                s)
                    if [ "$ackable" -ne 1 ]; then
                        echo "  cannot acknowledge: this finding cannot be acknowledged."
                    elif [ "$tier" = CRITICAL ]; then
                        echo "  cannot 'always ignore' a CRITICAL surface - approve the exact content or skip."
                    else
                        pending+=("spam $id")
                        sc_done+=("$rid")
                    fi
                    ;;
                a)
                    if [ "$ackable" -ne 1 ]; then
                        echo "  cannot acknowledge: this finding cannot be acknowledged."
                    else
                        sha="$(current_sha_for_id "$rid")"
                        if [ -z "$sha" ]; then
                            # Nothing left to pin the approval to: current_sha_for_id
                            # returning empty means $id no longer exists (deleted
                            # between compare and ack, or - for gitconfig - the key
                            # was unset). Writing `safe <id> ` anyway would record a
                            # baseline entry baseline_suppresses() can never match
                            # (its own empty-sha guard rejects it as malformed), so
                            # the surface would stay permanently unsuppressible -
                            # while still advancing crit_acked and letting a CRITICAL
                            # report shed its -CRITICAL.txt protection. Refuse
                            # instead: record nothing, and leave the report's
                            # protection exactly as it was.
                            echo "  cannot approve: $id no longer exists"
                        else
                            pending+=("safe $id $sha")
                            sc_done+=("$rid")
                            [ "$tier" = CRITICAL ] && crit_acked=$((crit_acked + 1))
                        fi
                    fi
                    ;;
                *) ;;
            esac
        done < "$report"

        if [ "$aborted" -eq 1 ] || [ "${#pending[@]}" -eq 0 ]; then
            echo ""; echo "dejima audit: nothing recorded."
            exit 0
        fi
        mkdir -p "$BASELINE_DIR"
        printf '%s\n' "${pending[@]}" >> "$bf"
        for rid in ${sc_done[@]+"${sc_done[@]}"}; do
            rm -f "$sc/$(id_key "$rid")".diff "$sc/$(id_key "$rid")".new \
                  "$sc/$(id_key "$rid")".removed "$sc/$(id_key "$rid")".withheld
        done
        rmdir "$sc" 2>/dev/null || true
        # Only rename off -CRITICAL.txt (making the report evictable by
        # rotation) when every CRITICAL finding this report carried was
        # actually approved - not just when something was approved.
        if [ "$crit_seen" -gt 0 ] && [ "$crit_acked" -eq "$crit_seen" ]; then
            case "$report" in
                *-CRITICAL.txt) mv "$report" "${report%-CRITICAL.txt}.txt" ;;
            esac
        fi
        echo ""; echo "dejima audit: recorded ${#pending[@]} acknowledgement(s) in $bf"
        exit 0
        ;;
    *)
        echo "usage: dejima-audit {snapshot|compare|show|ack} [workspace] [state-file]" >&2
        echo "  workspace defaults to the enclosing git repository, else the current directory" >&2
        exit 2
        ;;
esac
