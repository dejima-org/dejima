#!/usr/bin/env python3
# Host-side credential-injecting proxy for sandboxed Claude Code sessions.
# The container only ever holds a placeholder token; this proxy (launched on
# the host by bin/claude-sandbox, reached via a bind-mounted unix socket and
# an in-container loopback forwarder) strips the placeholder and injects the
# real OAuth access token from ~/.claude/.credentials.json, so the credential
# itself never enters the container. It also owns token refresh: rotated
# tokens are written back to the real host file atomically, keeping
# host-side sessions logged in. See README "Security notes" and
# ~/specs/2026-07-24-claude-sandbox-credential-proxy-design.md.
import argparse
import http.client
import json
import os
import socketserver
import sys
import tempfile
import threading
import time
from http.server import BaseHTTPRequestHandler
from urllib.parse import urlsplit

PLACEHOLDER = "sandbox-credential-proxy-placeholder"
OAUTH_CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
OAUTH_BETA = "oauth-2025-04-20"
HOP_BY_HOP = {
    "connection", "keep-alive", "proxy-authenticate", "proxy-authorization",
    "te", "trailer", "trailers", "transfer-encoding", "upgrade", "host",
}


class Credentials:
    def __init__(self, path, oauth_endpoint, margin):
        self.path = path
        self.oauth_endpoint = oauth_endpoint
        self.margin = margin
        self.lock = threading.Lock()

    def _read(self):
        with open(self.path) as f:
            return json.load(f)

    def access_token(self):
        oauth = self._read()["claudeAiOauth"]
        if oauth["expiresAt"] / 1000 - time.time() < self.margin:
            self.refresh(stale_token=oauth["accessToken"])
            oauth = self._read()["claudeAiOauth"]
        return oauth["accessToken"]

    def refresh(self, stale_token):
        with self.lock:
            data = self._read()
            oauth = data["claudeAiOauth"]
            # A concurrent refresher (host-side Claude Code, another sandbox
            # session, another thread here) may have replaced the token
            # already - if the file no longer holds the stale one and isn't
            # near expiry, use what's there instead of refreshing again.
            if (oauth["accessToken"] != stale_token
                    and oauth["expiresAt"] / 1000 - time.time() >= self.margin):
                return
            u = urlsplit(self.oauth_endpoint)
            cls = http.client.HTTPSConnection if u.scheme == "https" else http.client.HTTPConnection
            conn = cls(u.netloc, timeout=30)
            req = json.dumps({
                "grant_type": "refresh_token",
                "refresh_token": oauth["refreshToken"],
                "client_id": OAUTH_CLIENT_ID,
            })
            conn.request("POST", u.path, body=req,
                         headers={"Content-Type": "application/json"})
            resp = conn.getresponse()
            payload = resp.read()
            conn.close()
            if resp.status != 200:
                raise RuntimeError("token refresh failed: HTTP %d %.200s"
                                   % (resp.status, payload))
            fresh = json.loads(payload)
            oauth["accessToken"] = fresh["access_token"]
            if fresh.get("refresh_token"):
                oauth["refreshToken"] = fresh["refresh_token"]
            oauth["expiresAt"] = int((time.time() + fresh["expires_in"]) * 1000)
            self._write(data)

    def _write(self, data):
        # Atomic and permission-preserving: host-side Claude Code reads this
        # same file and must never observe a partial write or a looser mode.
        directory = os.path.dirname(self.path) or "."
        fd, tmp = tempfile.mkstemp(dir=directory)
        try:
            with os.fdopen(fd, "w") as f:
                json.dump(data, f)
            os.chmod(tmp, 0o600)
            os.replace(tmp, self.path)
        except BaseException:
            os.unlink(tmp)
            raise


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_request(self, *args):
        pass  # per-request lines would interleave with the session's own UI

    def log_error(self, fmt, *args):
        sys.stderr.write("claude-sandbox-anthropic-proxy: " + fmt % args + "\n")

    def _read_body(self):
        if self.headers.get("Transfer-Encoding", "").lower() == "chunked":
            chunks = []
            while True:
                size = int(self.rfile.readline().split(b";")[0], 16)
                if size == 0:
                    self.rfile.readline()
                    return b"".join(chunks)
                chunks.append(self.rfile.read(size))
                self.rfile.read(2)
        return self.rfile.read(int(self.headers.get("Content-Length", 0)))

    def _fail(self, status, message):
        self.log_error("%s", message)
        body = json.dumps(
            {"type": "error", "error": {"type": "proxy_error", "message": message}}
        ).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _upstream(self, token, body):
        u = self.server.upstream
        cls = http.client.HTTPSConnection if u.scheme == "https" else http.client.HTTPConnection
        conn = cls(u.netloc, timeout=600)
        headers = {
            k.lower(): v for k, v in self.headers.items()
            if k.lower() not in HOP_BY_HOP
            and k.lower() not in ("authorization", "x-api-key", "content-length")
        }
        headers["authorization"] = "Bearer " + token
        betas = [b.strip() for b in headers.get("anthropic-beta", "").split(",") if b.strip()]
        if OAUTH_BETA not in betas:
            betas.append(OAUTH_BETA)
        headers["anthropic-beta"] = ",".join(betas)
        headers["content-length"] = str(len(body))
        conn.request(self.command, self.path, body=body, headers=headers)
        return conn, conn.getresponse()

    def _proxy(self):
        body = self._read_body()
        try:
            token = self.server.creds.access_token()
        except Exception as e:
            return self._fail(502, "cannot load credentials: %s" % e)
        try:
            conn, resp = self._upstream(token, body)
            if resp.status == 401:
                # Upstream disagrees with expiresAt - refresh once and retry.
                resp.read()
                conn.close()
                self.server.creds.refresh(stale_token=token)
                token = self.server.creds.access_token()
                conn, resp = self._upstream(token, body)
        except Exception as e:
            return self._fail(502, "upstream request failed: %s" % e)
        try:
            self.send_response(resp.status)
            length = resp.getheader("Content-Length")
            for k, v in resp.getheaders():
                if k.lower() in HOP_BY_HOP or k.lower() in ("content-length", "date", "server"):
                    continue
                self.send_header(k, v)
            if length is not None:
                self.send_header("Content-Length", length)
            else:
                # Unknown length (chunked SSE): stream until upstream EOF,
                # delimited by closing our side too.
                self.close_connection = True
                self.send_header("Connection", "close")
            self.end_headers()
            self.wfile.flush()
            # Stream response body, flushing after each chunk for unbuffered delivery.
            # Use read1() to get partial reads immediately rather than waiting for
            # a full buffer or EOF, ensuring SSE events stream unbuffered. HTTPResponse.read1()
            # transparently handles chunked transfer-encoding and content-length termination.
            while True:
                chunk = resp.read1(4096)
                if not chunk:
                    break
                self.wfile.write(chunk)
                self.wfile.flush()
        finally:
            conn.close()

    do_GET = do_POST = do_PUT = do_DELETE = do_PATCH = _proxy


class ProxyServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True

    def __init__(self, socket_path, upstream, creds):
        self.upstream = upstream
        self.creds = creds
        super().__init__(socket_path, Handler)

    def get_request(self):
        # BaseHTTPRequestHandler expects a (host, port) client_address;
        # a unix-socket accept() returns '' - substitute a dummy pair.
        request, _ = self.socket.accept()
        return request, ("sandbox", 0)


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--socket", required=True)
    p.add_argument("--credentials", required=True)
    p.add_argument("--upstream", default="https://api.anthropic.com")
    p.add_argument("--oauth-endpoint", default="https://platform.claude.com/v1/oauth/token")
    p.add_argument("--refresh-margin", type=int, default=300)
    args = p.parse_args()

    creds = Credentials(args.credentials, args.oauth_endpoint, args.refresh_margin)
    try:
        # A plain read, not access_token(): this is just a startup sanity
        # check and must not trigger a refresh (that belongs to the first
        # real request, so an external refresher gets a chance to win first).
        creds._read()["claudeAiOauth"]["accessToken"]
    except Exception as e:
        sys.stderr.write(
            "claude-sandbox-anthropic-proxy: unusable credentials file %s: %s\n"
            % (args.credentials, e))
        return 1

    expires = creds._read()["claudeAiOauth"].get("refreshTokenExpiresAt")
    if expires is not None and expires / 1000 < time.time():
        sys.stderr.write(
            "claude-sandbox-anthropic-proxy: the refresh token in %s has "
            "expired - run `claude` on the host and log in again first\n"
            % args.credentials)
        return 1

    if os.path.exists(args.socket):
        os.unlink(args.socket)
    server = ProxyServer(args.socket, urlsplit(args.upstream), creds)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
