#!/bin/bash
# Ships a session's conversation to Loki, from the host.
#
# This used to run inside the container, in docker/log-shipper.sh. It is the
# only thing dejima did that observed a session from within the boundary it
# was observing: the shipper read the transcripts, applied the transform and
# held the Loki URL, all in a process the session shared a filesystem and a
# signal namespace with. A session that killed it stopped its own logging,
# and nothing on the host would have noticed.
#
# The transcripts are on the host already - they are bind-mounted in, not
# produced in the container - so reading them here costs nothing and removes
# the session from the path entirely. What it cannot remove is that the
# transcript is session-writable: this ships what was recorded, it does not
# attest to it, the same caveat epitaph carries.
#
# DNS and firewall logs still ship from inside, because those files only
# exist in the container.
#
# Usage: dejima-conversation-ship <workspace>
set -uo pipefail   # not -e: a torn line or a Loki hiccup must not kill the tailer

# shellcheck source=dejima-provider-lib.sh
source "$(dirname "$(readlink -f "$0")")/dejima-provider-lib.sh"
# shellcheck source=dejima-slug-lib.sh
source "$(dirname "$(readlink -f "$0")")/dejima-slug-lib.sh"
# shellcheck source=dejima-harness-lib.sh
source "$(dirname "$(readlink -f "$0")")/dejima-harness-lib.sh"
config_validate || exit 1

ws="${1:-}"
[ -n "$ws" ] || { echo "usage: dejima-conversation-ship <workspace>" >&2; exit 2; }
ws="$(cd "$ws" 2>/dev/null && pwd)" || exit 0

# Opt-in on top of loki_url: prompts, responses and tool commands are session
# content, a different sensitivity class from DNS names and firewall verdicts.
[ "$(config_get_bool logging conversation)" = "1" ] || exit 0
LOKI_URL="$(config_get logging loki_url)"
[ -n "$LOKI_URL" ] || exit 0

harness_plugin_load "$(config_get core harness)"
declare -F harness_transform_transcript >/dev/null 2>&1 || exit 0

TRANSCRIPTS="$(harness_config_get projects_dir)"
[ -n "$TRANSCRIPTS" ] || exit 0

BATCH_MAX_LINES=20
BATCH_MAX_SECONDS=2
POLL_SECONDS=3

push() {
    # $1 is a newline-terminated block of "<ns timestamp>\t<line>" records.
    local raw="$1" values payload
    [ -n "$raw" ] || return 0
    values="$(printf '%s' "$raw" | jq -R -s '
        split("\n") | map(select(length > 0))
        | map(split("\t") | [.[0], (.[1:] | join("\t"))])
    ')" || return 0
    payload="$(jq -n --argjson values "$values" \
        '{streams: [{stream: {job: "dejima-conversation", source: "dejima"}, values: $values}]}')" || return 0
    curl -s -o /dev/null --max-time 5 -H "Content-Type: application/json" \
        -XPOST "$LOKI_URL/loki/api/v1/push" -d "$payload" || true
}

# Which transcript files belong to this workspace, resolved through
# dejima-slug-lib rather than by matching a slug prefix.
#
# The in-container version globbed "<key>-*" to pick up worktrees, which also
# matches a SIBLING project whose directory name merely extends this one's -
# the #105 bug, in the shipper. It was harmless there only because the
# container is handed this workspace's slugs and nothing else, so a sibling's
# directory did not exist to match. On the host every project's does.
transcript_files() {
    local slug f
    while IFS= read -r slug; do
        [ -n "$slug" ] || continue
        for f in "$TRANSCRIPTS/$slug"/*.jsonl; do
            [ -f "$f" ] && printf '%s\n' "$f"
        done
    done < <(workspace_slugs_sorted "$ws")
}

declare -A offset
batch=""
batch_lines=0
last_flush="$(date +%s)"

# Byte offsets per file rather than `tail -F`: transcripts appear during a
# session (a new session, /clear, a subagent), and only whole lines are
# consumed - one still mid-write is picked up complete on a later pass
# instead of being shipped torn.
while :; do
    LC_ALL=C   # byte-accurate ${#...} for the offset arithmetic below
    while IFS= read -r f; do
        size="$(stat -c %s "$f" 2>/dev/null)" || continue
        cur="${offset[$f]:-0}"
        [ "$size" -gt "$cur" ] || continue
        chunk="$(tail -c "+$((cur + 1))" "$f" | head -c "$((size - cur))"; printf x)"
        chunk="${chunk%x}"
        complete="${chunk%"${chunk##*$'\n'}"}"
        [ -n "$complete" ] || continue
        offset[$f]=$((cur + ${#complete}))
        while IFS= read -r out; do
            [ -n "$out" ] || continue
            batch+="$(date +%s%N)"$'\t'"$out"$'\n'
            batch_lines=$((batch_lines + 1))
        done < <(printf '%s' "$complete" | harness_transform_transcript)
    done < <(transcript_files)

    now="$(date +%s)"
    if [ "$batch_lines" -ge "$BATCH_MAX_LINES" ] \
        || { [ "$batch_lines" -gt 0 ] && [ $((now - last_flush)) -ge "$BATCH_MAX_SECONDS" ]; }; then
        push "$batch"
        batch=""; batch_lines=0; last_flush="$now"
    fi
    sleep "$POLL_SECONDS"
done
