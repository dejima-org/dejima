#!/usr/bin/env python3
# Finds credential-shaped values in the host files dejima copies into a
# container, and prints what it found WITHOUT printing any value.
#
# This exists because the alternative does not scale. Two leaks were found by
# hand in one week - a console API key in ~/.claude.json, credential helpers
# in ~/.gitconfig - and both fixes were denylists: they encode exactly the
# knowledge dejima did not have the week before. A harness's authentication is
# not a stable interface, so the next field added leaks silently unless
# something is looking (#291).
#
# NOTHING HERE DECIDES ANYTHING. It classifies and reports; bin/dejima asks
# the operator and applies the answer. Keeping the judgement out of here is
# what lets the same classifier run in a test without a terminal.
#
# THE ONE INVARIANT: a credential value never leaves this program. Not in a
# finding, not in an error, not in a traceback. What a caller gets is a
# redacted path and a shape name - enough to report a bug to whoever ships the
# harness, and useless to anyone who intercepts it.
#
# Which is why the caller never sees a real path either. In a gitconfig the
# userinfo sits in the SECTION HEADER, so `url.https://me:PAT@github.com/` is
# a path that IS a credential. Findings carry a redacted path for a human and
# an opaque id for matching, and --scrub takes ids back - so real paths stay
# inside this program, which is the only place that has to hold them.

import argparse
import hashlib
import json
import math
import re
import sys

# Anything that looks like credentials in a URL, wherever it appears.
USERINFO = re.compile(r"(?P<scheme>[a-z][a-z0-9+.-]*://)(?P<user>[^/@\s:]*):"
                      r"[^/@\s]+@")


def redact(text):
    """A path an operator can recognise, with any embedded secret removed."""
    return USERINFO.sub(lambda m: "%s%s:***@" % (m.group("scheme"),
                                                 m.group("user")), text)


def finding_id(label, path):
    """Stable across runs, and reveals nothing about what it identifies.

    Keyed on the real path, so a decision survives the credential itself
    rotating - the operator answered about a field, not about a value."""
    h = hashlib.sha256(("%s\t%s" % (label, path)).encode("utf-8"))
    return h.hexdigest()[:16]

# Vendor prefixes, which are worth naming separately from the heuristics: a
# match here is not a guess, and the shape name tells an operator exactly what
# they are looking at without showing it to them.
KNOWN_SHAPES = (
    ("anthropic-api-key", re.compile(r"sk-ant-")),
    ("openrouter-key", re.compile(r"sk-or-")),
    ("openai-key", re.compile(r"^sk-[A-Za-z0-9]{20,}$")),
    ("github-token", re.compile(r"(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{8,}|github_pat_")),
    ("slack-token", re.compile(r"xox[baprs]-")),
    ("aws-access-key-id", re.compile(r"^AKIA[0-9A-Z]{16}$")),
    ("google-api-key", re.compile(r"^AIza[0-9A-Za-z_-]{35}$")),
    ("jwt", re.compile(r"^eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.")),
    ("private-key-pem", re.compile(r"^-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    ("auth-header-value", re.compile(r"(?i)(^|:\s*)(basic|bearer)\s+\S{8,}")),
    ("url-userinfo", re.compile(r"^[a-z][a-z0-9+.-]*://[^/@\s]+:[^/@\s]+@")),
)

# A name that says "this is a secret". Deliberately broad: a false positive
# costs one prompt and one recorded decision, a false negative costs a
# credential.
SUSPECT_NAME = re.compile(
    r"(?i)(api[_-]?key|_key$|^key$|token|secret|credential|password|passwd|"
    r"auth|bearer|session|cookie|signature|private)"
)

# Shapes that look like secrets to an entropy test and are not. Checked before
# entropy, so a UUID machine id does not cost an operator a prompt.
NOT_SECRET = (
    re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
               r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"),          # uuid
    re.compile(r"^[a-z]+://"),                                # url
    re.compile(r"^/"),                                        # absolute path
    re.compile(r"^~?/"),                                      # home path
    re.compile(r"^\d{4}-\d{2}-\d{2}"),                        # timestamp
    re.compile(r"^[0-9.]+$"),                                 # version/number
)

MIN_ENTROPY_LEN = 32
MIN_ENTROPY_BITS = 3.5


def shannon(value):
    if not value:
        return 0.0
    counts = {}
    for ch in value:
        counts[ch] = counts.get(ch, 0) + 1
    n = float(len(value))
    return -sum((c / n) * math.log(c / n, 2) for c in counts.values())


def classify(path, value):
    """Returns (verdict, shape) with verdict in credential|suspect|None.

    Never returns any part of `value`.
    """
    if not isinstance(value, str) or not value.strip():
        return (None, None)
    v = value.strip()
    for shape, pattern in KNOWN_SHAPES:
        if pattern.search(v):
            return ("credential", shape)
    # The WHOLE path, not the leaf: `credential.helper` is a credential
    # because of the section it sits in, and the leaf alone says nothing.
    named = bool(SUSPECT_NAME.search(path))
    if any(p.match(v) for p in NOT_SECRET):
        return (None, None)
    if named and len(v) >= 8:
        return ("suspect", "named-field")
    if len(v) >= MIN_ENTROPY_LEN and shannon(v) >= MIN_ENTROPY_BITS:
        return ("suspect", "high-entropy")
    return (None, None)


def walk_json(doc, prefix=""):
    if isinstance(doc, dict):
        for k, v in doc.items():
            yield from walk_json(v, "%s.%s" % (prefix, k) if prefix else str(k))
    elif isinstance(doc, list):
        # Indexed, so a decision recorded against one element does not silently
        # cover a different one later.
        for i, v in enumerate(doc):
            yield from walk_json(v, "%s[%d]" % (prefix, i))
    else:
        yield (prefix, doc)


def walk_ini(text):
    """git-config style. Section headers may carry a quoted subsection, and the
    subsection can itself hold the secret - a URL with userinfo in it."""
    section = ""
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or line.startswith(";"):
            continue
        if line.startswith("[") and line.endswith("]"):
            inner = line[1:-1].strip()
            m = re.match(r'^(\S+)\s+"(.*)"$', inner)
            if m:
                section = "%s.%s" % (m.group(1), m.group(2))
                # The subsection text is part of the key, and a URL with
                # userinfo in it is a credential sitting in a section header.
                yield ("%s" % section, m.group(2))
            else:
                section = inner
            continue
        if "=" not in line:
            continue
        k, _, v = line.partition("=")
        key = "%s.%s" % (section, k.strip()) if section else k.strip()
        yield (key, v.strip())


def delete_json_path(doc, path):
    # Mirrors walk_json's construction exactly, including list indices.
    parts = re.findall(r"[^.\[\]]+|\[\d+\]", path)
    cur = doc
    for part in parts[:-1]:
        cur = cur[int(part[1:-1])] if part.startswith("[") else cur[part]
    last = parts[-1]
    if last.startswith("["):
        del cur[int(last[1:-1])]
    else:
        del cur[last]


def drop_ini_paths(text, paths):
    """Removes whole sections for a section-header finding, single lines
    otherwise. Line-based rather than via a parser, so a file this cannot
    fully model is changed only where it matched."""
    drop_sections = set()
    drop_keys = set()
    for p in paths:
        drop_keys.add(p)
    out = []
    section = ""
    for raw in text.splitlines(True):
        line = raw.strip()
        if line.startswith("[") and line.endswith("]"):
            inner = line[1:-1].strip()
            m = re.match(r'^(\S+)\s+"(.*)"$', inner)
            section = "%s.%s" % (m.group(1), m.group(2)) if m else inner
            # A finding on the header itself takes the section with it: the
            # secret is the header, and the keys under it belong to it.
            if section in drop_keys:
                drop_sections.add(section)
                continue
            out.append(raw)
            continue
        if section in drop_sections:
            continue
        if "=" in line and not line.startswith("#") and not line.startswith(";"):
            k = line.partition("=")[0].strip()
            key = "%s.%s" % (section, k) if section else k
            if key in drop_keys:
                continue
        out.append(raw)
    return "".join(out)


def load_list(path):
    if not path:
        return []
    out = []
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    out.append(line)
    except OSError:
        pass
    return out


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--file", required=True)
    p.add_argument("--format", required=True, choices=("json", "ini"))
    # What this file is called where an operator would recognise it, rather
    # than the temp path of the copy being scanned.
    p.add_argument("--label", required=True)
    # Paths judged safe, and paths already decided. Both are plain lists of
    # "<label>\t<path>" so bin/dejima can build them without a parser.
    p.add_argument("--known-safe", default=None)
    p.add_argument("--decided", default=None)
    # Ids to remove from the file, in place. The caller never had the real
    # paths, so this is the only way it can ask for one to go.
    p.add_argument("--scrub", default=None)
    args = p.parse_args()

    try:
        with open(args.file) as f:
            text = f.read()
    except OSError as e:
        # The filename, never the contents.
        print("cannot read %s: %s" % (args.label, e.strerror), file=sys.stderr)
        return 2

    if args.format == "json":
        try:
            pairs = list(walk_json(json.loads(text)))
        except ValueError:
            print("%s is not readable as JSON" % args.label, file=sys.stderr)
            return 2
    else:
        pairs = list(walk_ini(text))

    if args.scrub:
        wanted = set(load_list(args.scrub))
        drop = [path for path, value in pairs
                if finding_id(args.label, path) in wanted]
        if not drop:
            return 0
        if args.format == "json":
            doc = json.loads(text)
            for path in drop:
                delete_json_path(doc, path)
            out = json.dumps(doc, indent=2) + "\n"
        else:
            out = drop_ini_paths(text, drop)
        with open(args.file, "w") as f:
            f.write(out)
        return 0

    # Two different keys, deliberately.
    #
    # A judged-safe entry is a "<label>\t<path>" written by hand, and it
    # covers the subtree beneath it - `customApiKeyResponses.approved` has to
    # answer for `...approved[0]` and every sibling, or an array of the same
    # judged-safe thing asks once per element.
    #
    # A decision is an opaque id and matches ONE path exactly. Broadening
    # those the same way would let one answer about one field quietly cover
    # fields the operator never saw.
    safe = [e for e in load_list(args.known_safe) if "\t" in e]
    decided = set(load_list(args.decided))

    def judged_safe(entry):
        for s_entry in safe:
            if entry == s_entry or entry.startswith(s_entry + ".") \
                    or entry.startswith(s_entry + "["):
                return True
        return False

    for path, value in pairs:
        fid = finding_id(args.label, path)
        if fid in decided or judged_safe("%s\t%s" % (args.label, path)):
            continue
        verdict, shape = classify(path, value)
        if verdict:
            # verdict, id, label, redacted path, shape. No value, and no
            # length either - a length is a hint about a secret.
            print("%s\t%s\t%s\t%s\t%s"
                  % (verdict, fid, args.label, redact(path), shape))
    return 0


if __name__ == "__main__":
    sys.exit(main())
